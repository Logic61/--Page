---
import NineStarArray from '../components/ritual/NineStarArray.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>九星芒阵 · 预览</title>
  </head>
  <body>
    <div class="veil" aria-hidden="true"></div>
    <header class="top">
      <a class="brand kai" href={`${base}/`}>古巫祝脉</a>
      <span class="top-title kai">九星芒阵</span>
      <a class="top-link kai" href={`${base}/four-veins`}>返回分支图</a>
    </header>
    <main>
      <div class="stage">
        <div class="none-layer" aria-hidden="true">
          <NineStarArray />
        </div>
      </div>
    </main>
    <footer class="foot kai">九芒衔星 · 古阵今符</footer>
  </body>
</html>

<style>
  :root {
    --gold: #b99752;
    --gold-bright: #e7d39a;
    --gold-dim: #66502a;
    --ink: #d9d2c2;
    --ink-faint: #6b5730;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { overflow-x: hidden; overflow-x: clip; }
  body {
    min-height: 100dvh;
    background:
      radial-gradient(ellipse 60% 40% at 50% 30%, rgba(185, 151, 82, 0.08), transparent 70%),
      #050505;
    color: var(--ink);
    font-family: "Songti SC", "STSong", "SimSun", "Noto Serif SC", serif;
    -webkit-font-smoothing: antialiased;
  }
  .kai { font-family: "Kaiti SC", "STKaiti", "KaiTi", serif; }
  .veil {
    position: fixed; inset: 0; z-index: 4; pointer-events: none;
    background:
      radial-gradient(ellipse 52% 40% at 50% 34%, rgba(185, 151, 82, 0.05), transparent 70%),
      linear-gradient(90deg, rgba(0,0,0,.55), transparent 18%, transparent 82%, rgba(0,0,0,.55));
  }
  .top {
    position: relative; z-index: 6;
    width: min(100% - 3rem, 44rem); min-height: 4.2rem; margin-inline: auto;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    border-bottom: 1px solid rgba(185, 151, 82, 0.18);
  }
  .brand, .top-link { color: #d4b877; font-size: 0.9rem; letter-spacing: 0.32em; text-decoration: none; transition: color 0.25s; }
  .brand:hover, .top-link:hover { color: #f0e3c8; }
  .top-title { color: #817253; font-size: 0.7rem; letter-spacing: 0.44em; }
  .top-link { justify-self: end; }
  main { position: relative; z-index: 2; }
  .stage { position: relative; display: flex; justify-content: center; padding: 3vh 0; }
  .none-layer {
    position: relative; z-index: 2;
    width: min(100% - 1.5rem, 198vmin, 2100px);
    aspect-ratio: 1 / 1;
  }
  .foot {
    position: relative; z-index: 6;
    width: min(100% - 3rem, 44rem); margin-inline: auto;
    padding: 1.3rem 0 2rem; border-top: 1px solid rgba(212, 184, 119, 0.12);
    color: #766746; text-align: center; font-size: 0.72rem; letter-spacing: 0.42em;
  }
</style>

<style is:global>
  .array-bg {
    position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0;
    display: block; pointer-events: none; color: #8a6c36; overflow: visible;
    filter: drop-shadow(0 0 5px rgba(185, 151, 82, 0.12));
  }
  .array-bg .a-dim { opacity: 0.85; }
  .array-bg .a-bright { color: #cfa95e; opacity: 0.9; }
  .array-bg .a-faint { opacity: 0.35; }
  .array-bg .a-ring { fill: none; stroke: currentColor; stroke-width: 6; }
  .array-bg .a-ring.a-thin { stroke-width: 3; opacity: 0.75; }
  .array-bg .a-poly { fill: none; stroke: currentColor; stroke-width: 6; opacity: 0.85; }
  .array-bg .a-tick { fill: none; stroke: currentColor; stroke-width: 5; opacity: 0.85; }
  .array-bg .a-node { fill: #a8853f; }
  .array-bg .a-node-ring { fill: none; stroke: #96733a; stroke-width: 4; opacity: 0.8; }
  .array-bg .a-taiji { opacity: 0.5; }
  .array-bg .a-wu-img { filter: drop-shadow(0 0 10px rgba(224, 190, 114, 0.35)); }

  .array-bg #thunder-wave path,
  .array-bg #cloud-single path,
  .array-bg #cloud-double path,
  .array-bg #cloud-s path,
  .array-bg #kui-curve path,
  .array-bg #quequ path,
  .array-bg #hui path,
  .array-bg #bronze-core path,
  .array-bg #thunder-hook path,
  .array-bg #thunder-square path {
    fill: none; stroke: currentColor; stroke-width: 3.6;
  }
  .array-bg #cloud-single circle,
  .array-bg #cloud-double circle,
  .array-bg #cloud-s circle,
  .array-bg #bead-border circle,
  .array-bg #thunder-hook circle,
  .array-bg #quequ circle,
  .array-bg #kui-curve circle { fill: currentColor; stroke: none; }

  .array-bg .a-sheen {
    fill: none; stroke: #d8ba74; stroke-width: 9; stroke-linecap: round;
    stroke-dasharray: 40 100; opacity: 0.4; animation: aSheen 20s linear infinite;
  }
  .array-bg .a-sheen2 {
    fill: none; stroke: #c9a55e; stroke-width: 7; stroke-linecap: round;
    stroke-dasharray: 24 84; opacity: 0.32; animation: aSheen2 26s linear infinite;
  }
  @keyframes aSheen {
    0% { stroke-dashoffset: 0; opacity: 0.28; }
    45% { opacity: 0.55; } 55% { opacity: 0.55; }
    100% { stroke-dashoffset: -620; opacity: 0.28; }
  }
  @keyframes aSheen2 {
    0% { stroke-dashoffset: 0; opacity: 0.2; }
    50% { opacity: 0.45; }
    100% { stroke-dashoffset: -460; opacity: 0.2; }
  }
  .array-bg .a-rotate-cw, .array-bg .a-rotate-ccw { transform-box: fill-box; transform-origin: 50% 50%; }
  .array-bg .a-rotate-cw { animation: aSpinCw 200s linear infinite; }
  .array-bg .a-rotate-ccw { animation: aSpinCcw 260s linear infinite; }
  @keyframes aSpinCw { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes aSpinCcw { from { transform: rotate(360deg); } to { transform: rotate(0deg); } }
  @media (prefers-reduced-motion: reduce) {
    .array-bg .a-sheen, .array-bg .a-sheen2,
    .array-bg .a-rotate-cw, .array-bg .a-rotate-ccw { animation: none; }
  }
</style>
