---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import Treatise from '../../components/Treatise.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = '祝法介绍 · 太易之音';
const description = '巫，祝也：而祝则祭主，沟通神明、世间。祝为巫中的大主祭，分大祝、小祝、丧祝、甸祝、诅祝、司祝、男巫、女巫等；祝祷与祝由，皆此脉所传。';

const chapters = [
  {
    title: '祝之相关：',
    blocks: [
      { t: 'p', text: '巫，祝也：而祝则祭主，沟通神明、世间。' },
      { t: 'p', text: '祝就巫中的大主祭，为巫的中一种，当然，巫祝也分为很多，比如：大祝、小祝、丧祝、甸祝、诅祝、司祝、男巫、女巫、神仕等。且当时从中央到地方各级官府都有配置。' },
      {
        t: 'office',
        pairs: [
          ['大祝：', '为掌祭祀祈祷'],
          ['小祝：', '掌小祭祀祝事'],
          ['丧祝：', '掌丧祭祀祝事'],
          ['甸祝：', '掌猎祭祀祝事'],
          ['诅祝：', '掌惩戒敌人祝事'],
          ['司祝：', '掌庙宇祷辞祝事'],
          ['男巫：', '主为男性巫官，祭祀多舞以悦鬼神者'],
          ['女巫：', '主为女性巫官，祭祀歌舞迎神祈祷者'],
        ],
      },
      { t: 'p', text: '1：祝祷：我们现在种种的祝福语，只是口头形式，而在上古时期则并非如此，如：《世本》记载：巫咸，尧臣也，以鸿术为帝尧之医，能祝延人之福，愈人之病；祝树树枯，祝鸟鸟坠。（大巫巫咸，对着树祝祷，树则枯死，对着鸟祝祷，鸟则坠落，对着人祝祷，则人添加福寿，疾病疗愈，身体健康。' },
      { t: 'note', text: '【听起来很玄幻，单并非是无稽之谈，修行人修为到了一定程度，精神精纯，是具有无形力量的，可以映照现实。】' },
      { t: 'p', text: '2：祝由：通过祝祷的方式来至于疾病，中医的医字，古字“毉”，其下乃巫，中医演化有源于巫。如：《世本》：“古者巫膨处作医”；在《皇帝内经》中记载些许中医“祝由”之术，通过祝祷疾病根因来疗愈相关病情。除此之外，某些地方也用相关内容解决某些事情，如冲撞guishen、魂魄丢失等等，至于祝祷是否有效，则与自身修为密切相关，当然不排除诸多骗子。' },
    ],
  },
];
---

<Base title={title} description={description} inkGold>
  <PageIntro
    mark="祝"
    title="祝法介绍"
    sub="巫，祝也：而祝则祭主，沟通神明、世间。祝为巫中的大主祭，为巫的中一种。"
    meta="巫祝巫祝，巫，祝也"
  />

  <Treatise
    headTitle="祝之相关"
    headNote="太易之音 · 上古巫祝传承祝法之道"
    chapters={chapters}
    bridge="巫祝巫祝，巫，祝也。祝就巫中的大主祭，为巫的中一种，那么难免不得提到神秘已久的巫！"
  />

  <nav class="zhoufa-next kai" aria-label="下一步">
    <a class="btn btn--primary" href={`${base}/zhoufa/mailuo`}>继续读 · 巫祝脉络</a>
    <a class="btn" href={`${base}/zhoufa`}>返回太易之音</a>
  </nav>
</Base>

<style>
  .zhoufa-next {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }
  @media (max-width: 600px) {
    .zhoufa-next .btn { flex: 1 1 100%; text-align: center; }
  }
</style>
