---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import Treatise from '../../components/Treatise.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = '隐秘传承 · 太易之音';
const description = '特殊隐秘巫的修炼、巫祝传承与流转总结：咒术与灵魂的秘密如何成为修炼法门，静定、存思、音决与役使鬼神的传承，兼及巫这一阶层的起落。';

const chapters = [
  {
    num: '一：',
    title: '特殊隐秘巫的修炼',
    blocks: [
      { t: 'p', text: '上古时期，人之灵性常现，其中便有一批极少的存在因为某些原因能接触、体验、掌控了一些超凡情况。' },
      { t: 'p', text: '比如：灵魂。' },
      { t: 'p', text: '巫，祝也：而祝则祭主，沟通神明、世间。' },
      { t: 'p', text: '在探索天地、沟通神明、世间、祭祀之中，慢慢的掌握了获取力量使自己不断强大的手段，慢慢的总结出了一些方法，成为了强者。' },
      { t: 'p', text: '而其中所产出的某些东西用现在的话来说，则是修炼之法门，比如：在祭祀歌舞呼啸之中，发现了咒术的秘密；在神明之中发现了灵魂的秘密等等。' },
      { t: 'p', text: '而在岁月之中，这些秘密被后世各自组织所流传，比如:辟谷、符术、咒术、静定、存思、精思、役使鬼神等等。' },
      { t: 'p', text: '综上所诉，可能不少人发现这些东西仍是某些派别的修炼主要方式。' },
      { t: 'note', text: '（而自力修炼这种事情，自古是属于隐秘、小众且独立于外的，巫这个阶级也不例外，百分之百中占个百分之一的份额已经算高了，剩下的基本就是有个身份地位的普通人或者所谓的通神者）' },
    ],
  },
  {
    num: '二：',
    title: '巫祝传承',
    blocks: [
      { t: 'p', text: '经过世面轮转之后，巫道合流，当初巫教诸多内容被五斗米之人千辛万苦得到，部分并入儒教，再少部分个体流入民间，加上岁月变迁，巫这个词大多已被后来者弄的乌烟瘴气，一说这个便想到了一些东西，比如骗子、神棍等等，而得到巫之内容的存在自古也各有名字，不称巫法。' },
      { t: 'p', text: '当然，除去这些之外，仍有一些纯真坚持着原始的巫教传承，并且承认。' },
      { t: 'p', text: '上宏观所述最后者则说：' },
      { t: 'p', text: '巫之传承之中，静定、存思、音决是主要方便，现在相关内容也在某些宗教里面应用为他们的修炼之中。' },
      { t: 'p', text: '法术方面：役使鬼神、天人感交等都是正统的巫法。' },
      { t: 'p', text: '祝由则是巫教在治病驱邪方面的传承，其中手段包含：诅咒、虫草、风水、鬼神等等。【当然现代这些某些东西五花八门的，我这里就不说神明了，主要讲一下巫之内容】' },
      { t: 'p', text: '魇镇术：这个东西可能有人听说过，可能没有。其实魇镇术是诅咒之术，而诅咒之类人们本就恐惧，因为它神秘，或者通过某些传闻、影视等等对其谈之色变。' },
      { t: 'p', text: '其实这都是一场误会，大家快坐下，不害怕，魇镇术虽然威力强大，练皇帝王公贵族都畏惧不以，但其实它的使用有诸多的限制，及时是真正的巫祝也没事不会用这玩意，其次还得修为高。真修为高了收拾人还用这么麻烦？跟别说你们还有些风水原理。' },
      { t: 'p', text: '风水、占卜：这种东西在巫祝传承之中比较实在，算是纯学问，不用依靠鬼神的力量，哪怕是现在社会各种存在不也多如牛毛？' },
    ],
  },
  {
    num: '三：',
    title: '流转总结',
    blocks: [
      { t: 'p', text: '世事无常，沧海桑田，不论组织和个人，都会有起起伏伏，没有始终的兴旺强势，也没有常年不变的衰落不堪，而巫这个阶层从最初的辉煌、到落败，实乃正常。' },
    ],
  },
];
---

<Base title={title} description={description} inkGold>
  <PageIntro
    mark="传"
    title="隐秘传承"
    sub="上古之人灵性常现，极少数因缘际会触及超凡，遂摸索出获取力量的手段，成为后世的修炼法门。"
    meta="巫祝传承内容，未经科学证实，切勿迷信"
  />

  <Treatise
    headTitle="隐秘传承"
    headNote="太易之音 · 修炼、传承与流转"
    chapters={chapters}
  />

  <nav class="zhoufa-next kai" aria-label="下一步">
    <a class="btn btn--primary" href={`${base}/zhoufa/mailuo`}>回看 · 巫祝脉络</a>
    <a class="btn" href={`${base}/zhoufa/kecheng`}>课程介绍</a>
  </nav>
</Base>

<style>
  .zhoufa-next {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }
  @media (max-width: 600px) {
    .zhoufa-next .btn { flex: 1 1 100%; text-align: center; }
  }
</style>
