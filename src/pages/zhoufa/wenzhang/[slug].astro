---
export function getStaticPaths() {
  const modules = import.meta.glob('../../../../巫/*.md', { eager: true });
  return Object.values(modules).map((mod) => ({ params: { slug: mod.frontmatter.slug } }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
return Astro.redirect(`${base}/miwen/${Astro.params.slug}`, 301);
