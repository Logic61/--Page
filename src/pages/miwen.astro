---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const nums = ['一', '二', '三', '四', '五', '六', '七', '八', '九', '十', '十一'];

const modules = import.meta.glob('../../巫/*.md', { eager: true });

const articles = Object.entries(modules)
  .map(([path, mod]) => ({
    slug: mod.frontmatter.slug,
    title: mod.frontmatter.title,
    order: mod.frontmatter.order,
    summary: mod.frontmatter.summary,
  }))
  .sort((a, b) => a.order - b.order);

const warning = '本文在写作过程中，引来大量鬼神干涉，不欲这些真相公之于众。也因此部分文字中沾染了鬼神气息，经复制到 TXT 格式过滤之后，基本已消除。但仍不能保证大家在阅读的时候，不会引来鬼神关注。所以请大家在浏览本文时，不要沉浸其中，不要尝试某些内容，并保持情绪稳定。部分内容须内群可见。为避免过度刺激导致大家信仰崩塌以身殉道，同时要给信教的朋友留面子，公众版相较内群版删减大量内容，以□代替，请大家见谅。';
---

<Base title="秘闻 · 上古祝门" description="《神机秘闻》系列十一篇：信仰、法界、轮回、神道、附体、下种、劝善、逃名、法术、符箓与法器的真相。">
  <PageIntro
    mark="秘"
    title="秘闻"
    sub="《神机秘闻》系列秘闻，共十一篇。秘闻栏可见标题与简介，点击进入阅读全文。"
    meta="文章内容纯属虚构，如有雷同，纯属雷同！"
  />

  <section class="blog" aria-labelledby="blog-list-title">
    <div class="wrap">

      <div class="blog-notice reveal">
        <b class="kai">虚构声明</b>
        <p>《神机秘闻》系列文章内容纯属虚构，如有雷同，纯属雷同。请读者理性看待，切勿迷信。</p>
      </div>

      <aside class="blog-warning reveal" data-d="2">
        <b class="kai">警告</b>
        <p>{warning}</p>
      </aside>

      <h2 id="blog-list-title" class="blog-list-title kai reveal">秘闻目录</h2>

      <nav class="post-list" aria-label="秘闻列表">
        {
          articles.map((a, i) => (
            <a class="post-card reveal" data-d={String((i % 3) + 2)} href={base + '/miwen/' + a.slug}>
              <span class="post-num kai">{nums[i]}</span>
              <div class="post-body">
                <h3 class="kai">{a.title}</h3>
                <p class="post-summary">{a.summary}</p>
                <p class="post-meta">
                  <span>第 {a.order} 篇</span>
                  <span class="post-read">阅读全文 →</span>
                </p>
              </div>
            </a>
          ))
        }
      </nav>

      <p class="blog-trailer kai reveal">本合集陆续作于 2013-2025</p>

    </div>
  </section>

  <Footer />
</Base>

<style>
  .blog { border-top: 1px solid var(--ink-line); }

  .blog-notice {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    padding: 1.1rem 1.4rem;
    border: 1px solid var(--ink-line);
    border-left: 3px solid var(--bronze-dim);
    background: var(--panel-soft);
    border-radius: 2px;
  }
  .blog-notice b {
    flex: none;
    color: var(--bronze-bright);
    font-size: 0.86rem;
    letter-spacing: 0.3em;
    padding-top: 0.15em;
  }
  .blog-notice p { color: var(--bone-dim); font-size: 0.9rem; line-height: 2; }

  .blog-warning {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    margin-top: 1.4rem;
    padding: 1.1rem 1.4rem;
    border: 1px solid var(--ink-line);
    border-left: 3px solid var(--cinnabar);
    background: var(--panel-soft);
    border-radius: 2px;
  }
  .blog-warning b {
    flex: none;
    color: #f2dfc4;
    background: var(--cinnabar);
    padding: 0.28em 0.55em;
    font-size: 0.82rem;
    letter-spacing: 0.3em;
    border-radius: 2px;
    transform: translateY(0.2em);
  }
  .blog-warning p { color: var(--bone-dim); font-size: 0.9rem; line-height: 2; }

  .blog-list-title {
    margin: clamp(2.4rem, 5vw, 3.4rem) 0 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: 0.28em;
    color: var(--heading);
  }

  .post-list {
    margin-top: 1.2rem;
    border-top: 1px solid var(--ink-line);
  }

  .post-card {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1.4rem;
    padding: 1.8rem 1.2rem;
    border-bottom: 1px solid var(--ink-line);
    transition: background 0.35s var(--ease-soft), padding-left 0.35s var(--ease-soft);
  }
  .post-card:hover {
    background: var(--panel-soft);
    padding-left: 1.6rem;
  }
  .post-num {
    color: var(--cinnabar);
    font-size: 1.7rem;
    letter-spacing: 0.1em;
    line-height: 1.4;
    padding-top: 0.1em;
  }
  .post-body h3 {
    color: var(--heading);
    font-size: clamp(1.25rem, 2.6vw, 1.55rem);
    letter-spacing: 0.2em;
  }
  .post-summary {
    margin-top: 0.55rem;
    color: var(--bone-dim);
    font-size: 0.9rem;
    line-height: 2;
  }
  .post-meta {
    margin-top: 0.8rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.76rem;
    letter-spacing: 0.22em;
    color: var(--bone-faint);
  }
  .post-read {
    color: var(--bronze-bright);
    transition: letter-spacing 0.3s var(--ease-soft);
  }
  .post-card:hover .post-read { letter-spacing: 0.3em; }

  .blog-trailer {
    margin-top: 2.2rem;
    text-align: center;
    color: var(--bone-faint);
    font-size: 0.84rem;
    letter-spacing: 0.24em;
  }

  @media (max-width: 560px) {
    .post-card { grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.4rem 0.6rem; }
    .post-num { font-size: 1.4rem; }
    .blog-notice, .blog-warning { flex-direction: column; gap: 0.5rem; }
  }
</style>
