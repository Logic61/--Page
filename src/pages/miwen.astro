---
import Base from '../layouts/Base.astro';
import Comments from '../components/Comments.astro';
import GoldNav from '../components/GoldNav.astro';
import Zl from '../components/Zl.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const nums = ['一', '二', '三', '四', '五', '六', '七', '八', '九', '十', '十一'];

const modules = import.meta.glob('../../巫/*.md', { eager: true });
// 英文版同题文章放在 巫-en/，以 frontmatter.slug 与中文版配对
const modulesEn = import.meta.glob('../../巫-en/*.md', { eager: true });
const enBySlug = new Map(Object.values(modulesEn).map((mod) => [mod.frontmatter.slug, mod]));

const articles = Object.entries(modules)
  .map(([path, mod]) => {
    const modEn = enBySlug.get(mod.frontmatter.slug);
    return {
      slug: mod.frontmatter.slug,
      title: mod.frontmatter.title,
      titleEn: modEn?.frontmatter.title,
      order: mod.frontmatter.order,
      summary: mod.frontmatter.summary,
      summaryEn: modEn?.frontmatter.summary,
    };
  })
  .sort((a, b) => a.order - b.order);

const warning = '本文在写作过程中，引来大量鬼神干涉，不欲这些真相公之于众。也因此部分文字中沾染了鬼神气息，经复制到 TXT 格式过滤之后，基本已消除。但仍不能保证大家在阅读的时候，不会引来鬼神关注。所以请大家在浏览本文时，不要沉浸其中，不要尝试某些内容，并保持情绪稳定。部分内容须内群可见。为避免过度刺激导致大家信仰崩塌以身殉道，同时要给信教的朋友留面子，公众版相较内群版删减大量内容，以□代替，请大家见谅。';
const warningEn = 'In the course of writing, these articles drew considerable interference from ghosts and gods who did not wish these truths made public. Some of the text therefore carries a ghost-god air; after the filter of copying through TXT format, it is basically cleared. Still, we cannot guarantee that reading will not draw ghost-god attention. So while browsing, do not sink into it, do not attempt certain things, and keep your emotions steady. Some content is for the in-group only. To avoid over-stimulating anyone into a collapse of faith and dying for it, and to save face for religious friends, the public version cuts much from the in-group version, marking omissions with the □ sign. Please forgive it.';
---

<Base title="秘闻 · 上古祝门" description="《神机秘闻》系列十一篇：信仰、法界、轮回、神道、附体、下种、劝善、逃名、法术、符箓与法器的真相。" hideNav={true} search="gold">
  <div class="miwen-scope">

    {/* 整页背景：用户提供的「金树灵光」图（public/bg/jinshu-lingguang.webp）。
        视口固定、cover 铺满，页面滚动时背景不动；画面中央留黑，
        左侧为发光金树、右侧为云海仙岛。 */}
    <div
      class="miwen-scene"
      aria-hidden="true"
      style={`background-image:url('${base}/bg/jinshu-lingguang.webp')`}
    ></div>

    {/* 顶部栏：玄金令牌，六个板块（首页 / 法门 / 秘闻 / 修炼常识 / 闲文 / 联系我们），右侧带全局搜索（Ctrl+K） */}
    <GoldNav showSearch />

    <section class="miwen-hero" aria-labelledby="miwen-hero-title">
      <div class="miwen-grain" aria-hidden="true"></div>

      {/* 整页统一使用版画版「日月星辰山川」横带
         （public/banhua/banhua-riyue-chuanshan.svg）。保留一层轻遮罩，
         保证左侧标题在纹样上始终清晰。 */}
      <div class="miwen-hero-scrim" aria-hidden="true"></div>

      <div class="wrap miwen-hero-wrap">
        <div class="miwen-mark-block reveal">
          <span class="miwen-mark-frame" aria-hidden="true"></span>
          <span class="miwen-mark kai">秘</span>
        </div>

        <div class="miwen-hero-text reveal" data-d="2">
          <p class="miwen-eyebrow kai"><Zl zh="神 机 秘 闻 · 共 十 一 篇" en="Shenji Miwen · Eleven in All" /></p>
          <h1 id="miwen-hero-title" class="miwen-title kai"><Zl zh="秘闻" en="Records" /></h1>
          <div class="miwen-rule" aria-hidden="true"></div>
          <p class="miwen-sub"><Zl zh="《神机秘闻》系列秘闻，秘闻栏可见标题与简介，点击进入阅读全文。" en="The Shenji Miwen series of records: titles and summaries are shown here; click through to read the full text." /></p>
          <p class="miwen-meta kai"><Zl zh="文章内容纯属虚构，如有雷同，纯属雷同。" en="The articles are entirely fiction; any resemblance is pure coincidence." /></p>
        </div>
      </div>
    </section>

    <section class="miwen-list" aria-labelledby="miwen-list-title">
      <div class="wrap">

        <div class="miwen-notice reveal">
          <b class="kai"><Zl zh="虚构声明" en="Fiction Notice" /></b>
          <p><Zl zh="《神机秘闻》系列文章内容纯属虚构，如有雷同，纯属雷同。请读者理性看待，切勿迷信。" en="The Shenji Miwen series is entirely fiction; any resemblance is pure coincidence. Read with reason — fall into no superstition." /></p>
        </div>

        <aside class="miwen-warning reveal" data-d="2">
          <b class="kai"><Zl zh="警告" en="Warning" /></b>
          <p><Zl zh={warning} en={warningEn} /></p>
        </aside>

        <header class="miwen-list-head reveal" data-d="3">
          <h2 id="miwen-list-title" class="kai"><Zl zh="秘闻目录" en="Table of Contents" /></h2>
          <span class="miwen-list-rule" aria-hidden="true"></span>
        </header>

        <nav class="post-list" aria-label="秘闻列表" data-en-aria="Article list">
          {
            articles.map((a, i) => (
              <a class="post-card reveal" data-d={String((i % 3) + 2)} href={base + '/miwen/' + a.slug}>
                <span class="post-num kai"><Zl zh={nums[i]} en={String(a.order)} /></span>
                <div class="post-body">
                  <h3 class="kai"><Zl zh={a.title} en={a.titleEn} /></h3>
                  <p class="post-summary"><Zl zh={a.summary} en={a.summaryEn} /></p>
                  <p class="post-meta">
                    <span><Zl zh={`第 ${a.order} 篇`} en={`No. ${a.order}`} /></span>
                    <span class="post-read"><Zl zh="阅读全文" en="Read in Full" /></span>
                  </p>
                </div>
              </a>
            ))
          }
        </nav>

        <p class="miwen-trailer kai reveal"><Zl zh="本合集陆续作于 2013-2025" en="Written at intervals over the years 2013-2025" /></p>

        <Comments />

      </div>
    </section>

  </div>
</Base>

<style>
  /* ============================================================
     秘闻 · 玄金之页
     Pure black + gold. Scope all tokens here so nav/footer stay
     on the global ink/bronze theme.
     ============================================================ */

  /* Scope selectors deliberately use `html[data-theme]` so the
     .miwen-scope tokens win over the global `html[data-theme='light']`
     override in src/styles/global.css, so miwen stays gold+black
     regardless of the saved user theme.

     Tokens match the 鎏金黑金 chat-bubble palette: warm near-black
     ground, bright warm-gold type, and bold gilt borders that read
     clearly against the dark ground. */
  html[data-theme] .miwen-scope {
    /* Pure warm black + antique gold tokens */
    --ink: #0a0604;
    --ink-2: #100b07;
    --ink-3: #18120b;
    --ink-line: rgba(248, 220, 160, 0.2);
    --bone: #f9edc1;
    --bone-dim: #e8d8b6;
    --bone-faint: #d0b98a;

    --heading: #fdf4d2;
    --gold: #f0d59f;
    --gold-bright: #fff0cb;
    --gold-deep: #bd9a55;
    --bronze-dim: #d2b67e;
    /* brightest highlight stop, used for liquid-gold gradient text */
    --gold-edge: #fffceb;
    --gold-glow: rgba(248, 220, 160, 0.6);
    --gold-line: rgba(248, 220, 160, 0.42);
    --gold-line-strong: rgba(248, 220, 160, 0.72);

    --panel-soft: rgba(248, 220, 160, 0.08);
    --panel-mid: linear-gradient(180deg, rgba(20, 16, 8, 0.7), rgba(5, 4, 2, 0.85));

    background: var(--ink);
    color: var(--bone);
    position: relative;
  }

  /* ============================================================
     整页背景 — 用户提供的「金树灵光」图
     public/bg/jinshu-lingguang.webp
     视口固定、cover 铺满、不重复；页面滚动时背景不动。
     画面中央留黑，正文与标题压在上面；左侧金树、右侧云海仙岛。
     ============================================================ */
  .miwen-scene {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-repeat: no-repeat;
    background-position: 50% 50%;
    background-size: cover;
  }
  @media (max-width: 640px) {
    /* 窄屏 cover 只露中间一条，居中取景最透气（两侧山影会被裁掉） */
    .miwen-scene {
      background-position: 50% 50%;
    }
  }

  /* ============================================================
     v9 hero — 首屏不再单独挂一幅描金山水。
     整页（含首屏）统一由 .miwen-scene 的排笔山水纹样铺底，
     首屏只保留一层柔和遮罩，让「秘」印与标题稳稳压住底纹。
     ============================================================ */

  .miwen-hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      /* 左侧金树高光很强，左侧遮罩要比之前更实，保证「秘」印与标题清晰 */
      linear-gradient(90deg,
        rgba(10, 6, 4, 0.9) 0%,
        rgba(10, 6, 4, 0.78) 28%,
        rgba(10, 6, 4, 0.48) 46%,
        rgba(10, 6, 4, 0.08) 64%,
        rgba(10, 6, 4, 0)   74%),
      radial-gradient(circle at 13% 46%,
        rgba(10, 6, 4, 0.72) 0%,
        rgba(10, 6, 4, 0.34) 38%,
        rgba(10, 6, 4, 0) 62%),
      linear-gradient(180deg,
        rgba(10, 6, 4, 0.58) 0%,
        rgba(10, 6, 4, 0) 46%);
  }

  /* ============================================================
     Hero
     ============================================================ */

  .miwen-hero {
    position: relative;
    z-index: 1; /* sit above the body-level 祥云 cloud field */
    /* 顶部栏已在文档流中占位，首屏只需留出呼吸感 */
    padding: clamp(2.6rem, 5vw, 4rem) 0 clamp(4rem, 8vw, 6.5rem);
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--gold-line);
  }

  /* Subtle gold dust / noise, fixed pseudo so it doesn't repaint on scroll */
  .miwen-grain {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.5;
    background-image:
      radial-gradient(circle at 18% 32%, rgba(236, 200, 121, 0.10) 0%, transparent 38%),
      radial-gradient(circle at 78% 22%, rgba(201, 169, 97, 0.07) 0%, transparent 42%),
      radial-gradient(circle at 62% 78%, rgba(201, 169, 97, 0.05) 0%, transparent 50%);
    mix-blend-mode: screen;
  }

  /* Vignette deepens the edges so the centre mark reads as the focal point */
  .miwen-vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 80% at 50% 50%, transparent 35%, rgba(0, 0, 0, 0.65) 100%);
  }

  .miwen-hero-wrap {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  /* Hero mark block: large 秘 character with thin gold frame behind it */
  .miwen-mark-block {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(8rem, 16vw, 12rem);
    height: clamp(8rem, 16vw, 12rem);
    flex: none;
  }

  .miwen-mark-frame {
    position: absolute;
    inset: 0;
    border: 1px solid var(--gold-line-strong);
    transform: rotate(45deg);
  }

  .miwen-mark-frame::before,
  .miwen-mark-frame::after {
    content: '';
    position: absolute;
    background: var(--gold);
  }

  .miwen-mark-frame::before {
    top: -1px;
    left: -1px;
    width: 1.2rem;
    height: 1px;
  }

  .miwen-mark-frame::after {
    bottom: -1px;
    right: -1px;
    width: 1.2rem;
    height: 1px;
  }

  .miwen-mark {
    font-family: var(--font-zhuan);
    font-size: clamp(4rem, 9vw, 6.5rem);
    line-height: 1;
    color: transparent;
    /* 鎏金 (liquid gold) gradient: edge highlight → bright → gold → deep → bright → edge.
       background-size > 100% so background-position can pan across the gradient
       and simulate flowing metal. */
    background: linear-gradient(135deg,
      var(--gold-edge) 0%,
      var(--gold-bright) 18%,
      var(--gold) 35%,
      var(--gold-deep) 52%,
      var(--gold) 68%,
      var(--gold-bright) 85%,
      var(--gold-edge) 100%);
    background-size: 220% 220%;
    -webkit-background-clip: text;
    background-clip: text;
    animation: miwen-font-flow 9s ease-in-out infinite;
    text-shadow:
      0 2px 16px rgba(0, 0, 0, 0.85),
      0 0 28px var(--gold-glow);
    user-select: none;
  }
  @keyframes miwen-font-flow {
    0%, 100% { background-position: 0% 50%; }
    50%      { background-position: 100% 50%; }
  }

  /* Hero text */
  .miwen-hero-text {
    min-width: 0;
  }

  .miwen-eyebrow {
    font-size: 0.78rem;
    letter-spacing: 0.42em;
    color: var(--gold);
    margin: 0;
  }

  .miwen-title {
    margin: 1rem 0 0;
    font-weight: 600;
    font-size: clamp(2.4rem, 6vw, 4rem);
    letter-spacing: 0.32em;
    line-height: 1.15;
    /* Same liquid-gold gradient as the hero mark, applied to the title text.
       background-position panned vertically so the bright highlight travels
       down through the strokes, reading like running gilt. */
    color: transparent;
    background: linear-gradient(180deg,
  …8141 tokens truncated…天君形影不离【道侣为异性，男求女仙，女择男神】',
          '9：如何孕育养胎',
          '10：如何诞胎脱凡',
        ],
        itemsEn: [
          '1: The companion life with the goddess-consort or heavenly lord.',
          '2: How to adapt to that companion life. [Opposite sex: men seek a female immortal; women choose a god.]',
          '3: How to refine the spirit with precision.',
          '4: How to maintain spirit and mind.',
          '5: How to guard against outer evils.',
          '6: How to consolidate spirit and form.',
          '7: How to communicate two-way with the goddess-consort or heavenly lord. [Opposite sex: men seek a female immortal; women choose a god.]',
          '8: How to stay, form and shadow, with the goddess-consort or heavenly lord. [Opposite sex: men seek a female immortal; women choose a god.]',
          '9: How to conceive and gestate the embryo.',
          '10: How to deliver the embryo and shed the mortal.',
        ],
      },
      { t: 'h4', text: '三：神气双修，神仙眷侣', en: 'III. Spirit and Qi Cultivated in Pair — Immortal Companions' },
      { t: 'p', text: '部分透露步骤：', en: 'Some stages revealed:' },
      { t: 'items', items: ['1：如何神气双修', '2：如何任游千山', '3：如何飞升相成'], itemsEn: ['1: How spirit and qi are cultivated in pair.', '2: How to roam the thousand mountains at will.', '3: How to ascend together.'] },
      { t: 'note', text: '【第一步坚持修炼半年后颇有家资的存在，若想更系统化的学习，一次性讲透彻80w，体系化进阶，秘传式学艺，则一次性付清180w，且需要遵守规矩！】', en: '[For those of some means who persist in the first stage for half a year: for more systematic study, a one-time full exposition is ¥800k; for systematic advancement with transmission-style tutelage, a one-time payment of ¥1.8M — and the rules must be observed!]' },
    ],
  },
  {
    blocks: [
      { t: 'p', text: '自古道法有诸多限制，但本法除了遵守不得 泄规矩之外，剩下的限制较少。', en: 'The ways have had many restrictions since old, but apart from the rule against leaking, this method bears few.' },
      {
        t: 'items',
        items: [
          '1：不限制吃喝',
