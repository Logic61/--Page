---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Courses from '../components/Courses.astro';
import Bidu from '../components/Bidu.astro';
import Footer from '../components/Footer.astro';

const { title, description } = {
  title: '课程 · 上古祝法',
  description: '上古祝法共分三类课程——基础课、特殊课、高级课。修法可学，课程不卖。',
};
---

<Base title={title} description={description}>
  <PageIntro
    mark="学"
    title="上古祝法"
    sub="上古祝法共分三类课程：基础课、特殊课、高级课。修法可学，课程不卖；高级课不作直接售卖，需实修入境界后循序而进。"
    meta="以下课程所授为古代巫祝养生理论，未经科学证实。"
  />
  <Courses />
  <Bidu />
  <Footer />
</Base>