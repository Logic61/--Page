---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Way from '../components/Way.astro';
import Yinjue from '../components/Yinjue.astro';
import DailyPractice from '../components/DailyPractice.astro';
import Footer from '../components/Footer.astro';

const { title, description } = {
  title: '祝法养生 · 音诀与日常',
  description: '从祝祷、祝由、音诀，到可持续的日常养生之道。',
};
---

<Base title={title} description={description}>
  <PageIntro
    mark="咒"
    title="祝法与养生"
    sub="先区分祝祷、祝由与音诀，再从日常养生活动开始，逐步建立可持续的练习节奏。"
  />
  <Way />
  <Yinjue />
  <DailyPractice />
  <Footer />
</Base>
