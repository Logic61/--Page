---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = '法门 · 上古祝门';
const description = '法门分支目录：咒法、偶景、鏖战、驻颜、真气治病，五门各承一脉，循门而入。';

const gates = [
  {
    glyph: '咒',
    name: '咒法',
    subtitle: '通窍 · 开脉 · 合一',
    desc: '上古祝门之根本。以诵咒通窍开脉，锻炼神形，追求天人合一，万物一咒。',
    route: '/zhoufa',
    intro: '/zhoufa/jieshao',
    baoming: '/zhoufa/baoming',
    accent: '#b89a5e',
  },
  {
    glyph: '景',
    name: '偶景',
    subtitle: '内景 · 观照 · 守一',
    desc: '内景与幻境之辨：见内景者多入妄境，修性不可误此，观照存想而不入妄。',
    route: '/oujing',
    intro: '/oujing/jieshao',
    baoming: '/oujing/baoming',
    accent: '#8291b7',
  },
  {
    glyph: '战',
    name: '鏖战',
    subtitle: '丹基 · 房中 · 养生',
    desc: '源自人元丹法筑基，交而不泄，养生配套，非邪法，养身以续其道。',
    route: '/aozhan',
    intro: '/aozhan/jieshao',
    baoming: '/aozhan/baoming',
    accent: '#b8785e',
  },
  {
    glyph: '颜',
    name: '驻颜',
    subtitle: '驻容 · 养容 · 生发',
    desc: '以气血温养为本，驻容颜于岁月之中，养容仪于日常之间，此支篇幅尚待人开示。',
    route: '/zhuyanshu',
    intro: '/zhuyanshu/jieshao',
    baoming: '/zhuyanshu/baoming',
    accent: '#b99752',
  },
  {
    glyph: '气',
    name: '真气治病',
    subtitle: '外气 · 神气 · 激发',
    desc: '外气治病机理之辨：激发潜力、赋予精气、移除恶气，真气外发而愈人疾。',
    route: '/zhenqi',
    intro: '/zhenqi/jieshao',
    baoming: '/zhenqi/baoming',
    accent: '#7fa387',
  },
];
---

<Base title={title} description={description}>
  <PageIntro
    mark="法"
    title="法门"
    sub="诸法之门，循门而入。上古祝门之法，分作五支，各承一脉，门门有径，径径通幽。"
    meta="分支目录 · 五门"
  />

  <section class="gates">
    <div class="wrap">
      <div class="gate-grid">
        {
          gates.map((g, i) => (
            <article class="gate reveal" style={`--c:${g.accent};`} data-d={i + 1}>
              <a class="gate-cover" href={`${base}${g.route}`} aria-label={`进入${g.name}`}></a>
              <span class="gate-glyph zhuan" aria-hidden="true">{g.glyph}</span>
              <div class="gate-body">
                <h2 class="gate-name kai">{g.name}</h2>
                <p class="gate-sub">{g.subtitle}</p>
                <p class="gate-desc">{g.desc}</p>
              </div>
              <div class="gate-foot-row">
                <span class="gate-enter kai" aria-hidden="true">入 ›</span>
                <nav class="gate-links kai" aria-label={`${g.name}入口`}>
                  <a href={`${base}${g.intro}`}>介绍</a>
                  <span class="sep" aria-hidden="true">·</span>
                  <a href={`${base}${g.baoming}`}>报名</a>
                </nav>
              </div>
            </article>
          ))
        }
      </div>

      <p class="gate-foot kai">法未择人，人自择法 · 五门同源，各有所传</p>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .gates { padding-top: clamp(2.5rem, 5vw, 4rem); padding-bottom: clamp(4rem, 9vw, 7rem); }

  .gate-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: clamp(1rem, 2vw, 1.6rem);
  }

  .gate {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    border: 1px solid var(--ink-line);
    border-radius: 4px;
    background: var(--panel-soft);
    overflow: hidden;
    isolation: isolate;
    transition: border-color 0.4s var(--ease-soft), transform 0.35s var(--ease-soft), box-shadow 0.4s var(--ease-soft);
  }

  .gate::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(120% 90% at 12% 8%, color-mix(in srgb, var(--c) 16%, transparent), transparent 60%);
    opacity: 0;
    transition: opacity 0.45s var(--ease-soft);
  }

  .gate:hover,
  .gate:focus-visible {
    border-color: color-mix(in srgb, var(--c) 60%, transparent);
    transform: translateY(-4px);
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.4), 0 0 0 1px color-mix(in srgb, var(--c) 24%, transparent) inset;
  }
  .gate:hover::before,
  .gate:focus-visible::before { opacity: 1; }

  .gate-glyph {
    align-self: flex-start;
    font-size: clamp(3.4rem, 7vw, 4.6rem);
    line-height: 0.78;
    color: transparent;
    -webkit-text-stroke: 1px var(--c);
    text-shadow: 0 0 26px color-mix(in srgb, var(--c) 20%, transparent);
    margin-bottom: 1.3rem;
    user-select: none;
  }

  .gate-body { flex: 1; }

  .gate-name {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 600;
    letter-spacing: 0.24em;
    color: var(--heading);
  }

  .gate-sub {
    margin-top: 0.6rem;
    color: var(--c);
    font-family: var(--font-kai);
    font-size: 0.82rem;
    letter-spacing: 0.36em;
  }

  .gate-desc {
    margin-top: 1.1rem;
    color: var(--bone-dim);
    font-size: 0.92rem;
    line-height: 2;
  }

  /* 覆盖整卡的隐形主链接：点击卡片任意处进入该法门主页 */
  .gate-cover {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .gate-foot-row {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 1.6rem;
  }
  .gate-links {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .gate-links a {
    padding: 0.32em 0.85em;
    border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
    border-radius: 999px;
    color: color-mix(in srgb, var(--c) 82%, var(--bronze-bright));
    font-size: 0.84rem;
    letter-spacing: 0.22em;
    text-decoration: none;
    transition: border-color 0.3s var(--ease-soft), background 0.3s var(--ease-soft), color 0.3s var(--ease-soft);
  }
  .gate-links a:hover {
    border-color: var(--c);
    background: color-mix(in srgb, var(--c) 16%, transparent);
    color: var(--bronze-bright);
  }
  .gate-links .sep { color: var(--bone-faint); }

  .gate-enter {
    color: color-mix(in srgb, var(--c) 82%, var(--bronze-bright));
    font-size: 0.92rem;
    letter-spacing: 0.24em;
    transition: transform 0.35s var(--ease-soft), color 0.35s var(--ease-soft);
  }
  .gate:hover .gate-enter,
  .gate:focus-within .gate-enter { transform: translateX(6px); color: var(--bronze-bright); }

  .gate-foot {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    text-align: center;
    color: var(--bone-faint);
    font-size: 0.82rem;
    letter-spacing: 0.4em;
  }

  @media (max-width: 560px) {
    .gate-grid { grid-template-columns: 1fr; }
  }
</style>
