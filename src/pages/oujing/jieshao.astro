---
import BranchLayout from '../../layouts/BranchLayout.astro';
import BranchSteps from '../../components/BranchSteps.astro';
import PageIntro from '../../components/PageIntro.astro';
import Treatise from '../../components/Treatise.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = '偶景 · 功法内容';
const description = '偶景课程功法次序与步骤：神妃降世、结成道侣，相与为偶、形影不离，神气双修、神仙眷侣。功法简介需要解密，会随着修炼者到达一定程度从而分段讲解。';

// 顶栏入口：与分脉首页一致
const navItems = [
  { href: '/', label: '返回总目录' },
  { href: `${base}/oujing`, label: '总览' },
  { href: `${base}/oujing/jieshao`, label: '功法内容' },
  { href: `${base}/oujing/baoming`, label: '报名须知' },
];

const chapters = [
  {
    title: '偶景课程【解密方面在下面】',
    blocks: [
      { t: 'p', text: '一：总结功法次序简介：' },
      {
        t: 'items',
        items: [
          '1、神妃降世，结成道侣。【6w一个人半全职刻苦修炼十几年大成应该问题不大】',
          '2、相与为偶，形影不离。【12w能到这一步可以开始准备孕胎阳神进阶】',
          '3、神气双修，神仙眷侣。【X能练到这一步者已经凤毛麟角，已至阳神，价格就不展示了】',
        ],
      },
      { t: 'note', text: '【偶景最后功法简介其实是一个需要解密的诗，就和丹诗一样需要解密，会随着修炼者到达一定程度从而分段讲解】' },
      { t: 'note', text: '【第一步坚持修炼半年后颇有家资的存在，若想更系统化的学习，一次性讲透彻80w，体系化进阶，秘传式学艺，则一次性付清180w，且需要遵守规矩！】' },
    ],
  },
  {
    title: '功法步骤：',
    blocks: [
      { t: 'p', text: '偶者仙偶，景者影也，偶景，又叫偶影，就是相与为偶，形影不离的意思。' },
      { t: 'p', text: '解密：' },
      { t: 'h4', text: '一：神妃降世，结成道侣' },
      { t: 'p', text: '部分步骤透露：' },
      {
        t: 'items',
        items: [
          '1：如何祈求神妃或者天君降世【道侣为异性，男求女仙，女择男神】',
          '2：如何确定伴侣主要身份',
          '3：如何与神妃或者天君结成道侣【道侣为异性，男求女仙，女择男神】',
          '4：在结成道侣之后约法几章',
        ],
      },
      { t: 'h4', text: '二：相与为偶，形影不离' },
      { t: 'p', text: '部分步骤透露：' },
      {
        t: 'items',
        items: [
          '1：与神妃或者天君的道侣生活',
          '2：如何适应神妃或者天君的道侣生活【道侣为异性，男求女仙，女择男神】',
          '3：如何炼神精确',
          '4：如何保养精神',
          '5：如何防护外邪',
          '6：如何巩固神形',
          '7：如何与神妃或者天君的双向沟通【道侣为异性，男求女仙，女择男神】',
          '8：如何与与神妃或者天君形影不离【道侣为异性，男求女仙，女择男神】',
          '9：如何孕育养胎',
          '10：如何诞胎脱凡',
        ],
      },
      { t: 'h4', text: '三：神气双修，神仙眷侣' },
      { t: 'p', text: '部分透露步骤：' },
      { t: 'items', items: ['1：如何神气双修', '2：如何任游千山', '3：如何飞升相成'] },
      { t: 'note', text: '【第一步坚持修炼半年后颇有家资的存在，若想更系统化的学习，一次性讲透彻80w，体系化进阶，秘传式学艺，则一次性付清180w，且需要遵守规矩！】' },
    ],
  },
  {
    blocks: [
      { t: 'p', text: '自古道法有诸多限制，但本法除了遵守不得 泄规矩之外，剩下的限制较少。' },
      {
        t: 'items',
        items: [
          '1：不限制吃喝',
          '2:不限制种族（自力体系例外）',
          '3：不限制结婚生子',
          '4:不限制正常生活以及工作',
          '5：不限制行业，无论是上至王候将相、下至贩 夫走卒，一视同仁',
        ],
      },
    ],
  },
  {
    title: '注：',
    blocks: [
      { t: 'items', items: ['1：师父领进门修行在个人，不包票成功。', '2：修炼需要坚定的毅力与恒心，两天打鱼，三天晒网者，勿扰。'] },
    ],
  },
];
---

<BranchLayout
  title={title}
  description={description}
  glyph="景"
  label="偶景"
  accent="#8291b7"
  bgDim={0.08}
  bg={`${base}/bg/oujing-shenying.webp`}
  navItems={navItems}
>
  <PageIntro
    mark="解"
    title="功法内容"
    sub="偶者仙偶，景者影也。偶景，又叫偶影，就是相与为偶，形影不离的意思。"
    meta="不包票成功；修行理论内容，未经科学证实，切勿迷信"
  />

  <Treatise chapters={chapters} center />

  {/* 中间页只给两个去处：上一页名字 · 下一页名字 */}
  <BranchSteps />
</BranchLayout>

<style>
  /* 文本框居中：题头、正文（Treatise center）、按钮同为一列 48em，列内文字仍左对齐 */
  :global(.page-intro .wrap > div) {
    max-width: 48em;
    margin-inline: auto;
  }

</style>
