---
import BranchLayout from '../../layouts/BranchLayout.astro';
import BranchPortal from '../../components/BranchPortal.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = '偶景 · 内景观照';
const description = '内景与幻境之辨，观照存想而不入妄境。';
---

<BranchLayout title={title} description={description} glyph="景" label="偶景" accent="#8291b7">
  <BranchPortal
    glyph="景"
    title="偶景"
    subtitle="内景 · 观照 · 守一"
    description="内景与幻境之辨，观照存想而不入妄境。"
    introHref={base + '/oujing/jieshao'}
    baomingHref={base + '/oujing/baoming'}
  />
</BranchLayout>
