---
import Base from '../../layouts/Base.astro';
import GoldNav from '../../components/GoldNav.astro';
import { essays } from '../../data/xianwen';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export function getStaticPaths() {
  return essays.map((e, i) => ({
    params: { slug: e.id },
    props: {
      essay: e,
      prev: i > 0 ? { id: essays[i - 1].id, title: essays[i - 1].title } : null,
      next: i < essays.length - 1 ? { id: essays[i + 1].id, title: essays[i + 1].title } : null,
    },
  }));
}

const { essay, prev, next } = Astro.props;

const title = essay.title + ' · 闲文 · 上古祝门';
const description = essay.summary;
---

<Base title={title} description={description} hideNav={true} search="gold">
  <div class="xianwen-scope">

    {/* 整页背景：与「闲文」列表页同一张「山河金影」，视口固定、滚动不动 */}
    <div
      class="xianwen-pattern"
      aria-hidden="true"
      style={`background-image:url('${base}/bg/shanhe-gold.webp')`}
    ></div>
    <div class="xw-scrim" aria-hidden="true"></div>

    {/* 顶部栏：玄金令牌，五个板块（首页 / 法门 / 秘闻 / 修炼常识 / 闲文），右侧带全局搜索（Ctrl+K） */}
    <GoldNav showSearch />

    <article class="xw-post" aria-labelledby="xw-post-title">
      <div class="wrap">

        <header class="xw-head reveal">
          <span class="xw-glyph zhuan" aria-hidden="true">{essay.glyph}</span>
          <div class="xw-head-text">
            <p class="xw-kicker kai">闲 文 · 其 {essay.num}</p>
            <h1 id="xw-post-title" class="kai">{essay.title}</h1>
            <p class="xw-summary">{essay.summary}</p>
          </div>
        </header>

        <div class="xw-body">
          {
            essay.chapters.map((c) => (
              <section class="xw-block reveal">
                {(c.num || c.title) && (
                  <header class="xw-block-head">
                    {c.num && <span class="xw-block-num kai">{c.num}</span>}
                    {c.title && <h3 class="kai">{c.title}</h3>}
                  </header>
                )}
                {c.blocks.map((b) => {
                  if (b.t === 'p') return <p>{b.text}</p>;
                  if (b.t === 'h4') return <h4 class="kai">{b.text}</h4>;
                  if (b.t === 'quote') return <p class="xw-quote kai">{b.text}</p>;
                  if (b.t === 'note')
                    return (
                      <aside class="xw-note">
                        <p>{b.text}</p>
                      </aside>
                    );
                  return (
                    <ul class="xw-entries">
                      {b.items?.map((it) => (
                        <li>
                          <span class="xw-dot" aria-hidden="true"></span>
                          <p>{it}</p>
                        </li>
                      ))}
                    </ul>
                  );
                })}
              </section>
            ))
          }
        </div>

        <nav class="xw-post-nav reveal" aria-label="闲文导航">
          {
            prev ? (
              <a class="xw-pager" href={`${base}/xianwen/${prev.id}`}>
                <span class="xw-pager-label kai">上一篇</span>
                <span class="xw-pager-title kai">{prev.title}</span>
              </a>
            ) : (
              <span class="xw-pager is-empty">
                <span class="xw-pager-label kai">上一篇</span>
                <span class="xw-pager-title kai">已是首篇</span>
              </span>
            )
          }
          <a class="xw-back-btn btn" href={`${base}/xianwen`}>返回闲文列表</a>
          {
            next ? (
              <a class="xw-pager is-next" href={`${base}/xianwen/${next.id}`}>
                <span class="xw-pager-label kai">下一篇</span>
                <span class="xw-pager-title kai">{next.title}</span>
              </a>
            ) : (
              <span class="xw-pager is-next is-empty">
                <span class="xw-pager-label kai">下一篇</span>
                <span class="xw-pager-title kai">已是末篇</span>
              </span>
            )
          }
        </nav>

      </div>
    </article>

  </div>
</Base>

<style>
/* ============================================================
     闲文 · 玄金之页
     与「修炼常识」同源：同一套黑金令牌（tokens）、同一张
     「山河金影」底图、同一套首屏（印框 + 鎏金标题 + 金线）。
     用 `html[data-theme]` 前缀，确保盖过 global.css 里的浅色主题。
     ============================================================ */

  html[data-theme] .xianwen-scope {
    --ink: #0a0604;
    --ink-2: #100b07;
    --ink-3: #18120b;
    --ink-line: rgba(248, 220, 160, 0.2);
    --bone: #f9edc1;
    --bone-dim: #e8d8b6;
    --bone-faint: #d0b98a;

    --heading: #fdf4d2;
    --gold: #f0d59f;
    --gold-bright: #fff0cb;
    --gold-deep: #bd9a55;
    --bronze-dim: #d2b67e;
    /* brightest highlight stop, used for liquid-gold gradient text */
    --gold-edge: #fffceb;
    --gold-glow: rgba(248, 220, 160, 0.6);
    --gold-line: rgba(248, 220, 160, 0.42);
    --gold-line-strong: rgba(248, 220, 160, 0.72);

    --panel-soft: rgba(248, 220, 160, 0.08);

    background: var(--ink);
    color: var(--bone);
    position: relative;
  }

  /* ============================================================
     整页背景 — 「山河金影」（与修炼常识页同一张图）
     视口固定、cover 铺满、不重复；页面滚动时背景不动。
     ============================================================ */
  .xianwen-pattern {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-repeat: no-repeat;
    background-position: 50% 50%;
    background-size: cover;
  }
  @media (max-width: 640px) {
    /* 窄屏 cover 只露中间一条，居中取景最透气（两侧山影会被裁掉） */
    .xianwen-pattern {
      background-position: 50% 50%;
    }
  }

  /* ============================================================
     正文页：遮罩、正文列、篇间导航
     与列表页同一套黑金令牌与同一张「山河金影」底图。
     ============================================================ */
  .xw-scrim {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 46% 72% at 50% 44%,
        rgba(10, 6, 4, 0.82) 0%,
        rgba(10, 6, 4, 0.66) 58%,
        rgba(10, 6, 4, 0.3) 100%),
      linear-gradient(180deg,
        rgba(10, 6, 4, 0.6) 0%,
        rgba(10, 6, 4, 0.44) 42%,
        rgba(10, 6, 4, 0.62) 100%);
  }

  .xw-post {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .xw-post > .wrap { position: relative; z-index: 1; }

  .xw-head,
  .xw-body,
  .xw-post-nav {
    max-width: 48em;
    margin-inline: auto;
  }
  .xw-head { padding-top: clamp(2.6rem, 5vw, 4rem); }

  .xw-post-nav {
    display: grid;
    /* minmax(0,·)：窄屏时两侧篇名可换行收缩，不让长标题把页面撑出横向滚动 */
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 1.2rem;
    align-items: stretch;
    margin-top: clamp(2.2rem, 5vw, 3rem);
    padding-top: 2rem;
    border-top: 1px solid var(--gold-line);
  }
  .xw-pager {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
    padding: 1rem 1.1rem;
    border: 1px solid var(--gold-line);
    border-radius: 3px;
    background: var(--panel-soft);
    text-decoration: none;
    transition: border-color 0.3s var(--ease-soft), transform 0.2s var(--ease-soft), background 0.3s var(--ease-soft);
  }
  .xw-pager:hover {
    border-color: var(--gold-line-strong);
    transform: translateY(-2px);
    background: rgba(201, 169, 97, 0.06);
  }
  .xw-pager.is-next { text-align: right; }
  .xw-pager.is-empty { opacity: 0.8; pointer-events: none; }
  .xw-pager-label {
    color: var(--gold);
    font-size: 0.74rem;
    letter-spacing: 0.28em;
  }
  .xw-pager-title {
    color: var(--heading);
    font-size: 1.02rem;
    letter-spacing: 0.12em;
    line-height: 1.8;
    overflow-wrap: anywhere;
    transition: color 0.3s var(--ease-soft);
  }
  .xw-pager:hover .xw-pager-title { color: var(--gold-bright); }
  .xw-back-btn { align-self: center; white-space: nowrap; }

  /* 本页按钮改用鎏金描边 */
  .xianwen-scope :global(.btn) {
    border-color: var(--gold-line-strong);
    color: var(--gold-bright);
  }
  .xianwen-scope :global(.btn:hover) {
    border-color: var(--gold);
    color: #050402;
    background: rgba(236, 200, 121, 0.92);
  }

/* ---------- 单篇 ---------- */
  .xw-essay {
    max-width: 48em;
    margin: clamp(3.2rem, 7vw, 5rem) auto 0;
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--gold-line-strong);
    scroll-margin-top: 5rem;
  }
  .xw-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.2rem, 3vw, 2.2rem);
    align-items: center;
    padding-bottom: clamp(1.5rem, 3vw, 2.2rem);
    border-bottom: 1px dashed var(--ink-line);
  }
  .xw-glyph {
    font-family: var(--font-zhuan);
    font-size: clamp(3rem, 7vw, 4.6rem);
    line-height: 1;
    color: transparent;
    background: linear-gradient(160deg, var(--gold-bright) 0%, var(--gold) 45%, var(--gold-deep) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    text-shadow: 0 0 26px var(--gold-glow);
    user-select: none;
  }
  .xw-head-text { min-width: 0; }
  .xw-kicker {
    margin: 0;
    color: var(--gold);
    font-size: 0.74rem;
    letter-spacing: 0.46em;
  }
  .xw-head h1,
  .xw-head h2 {
    margin: 0.7rem 0 0;
    color: var(--heading);
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.7;
  }
  .xw-summary {
    margin: 0.8rem 0 0;
    color: var(--bone-faint);
    font-size: 0.88rem;
    line-height: 2.05;
  }

  .xw-block { margin-top: clamp(1.8rem, 4vw, 2.6rem); }
  .xw-block-head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding-left: 0.95rem;
    border-left: 3px solid #b23a2c;
  }
  .xw-block-num {
    flex: none;
    color: #f6a189;
    font-size: clamp(1.05rem, 2.2vw, 1.32rem);
    letter-spacing: 0.12em;
  }
  .xw-block h3 {
    color: var(--heading);
    font-size: clamp(1.2rem, 2.5vw, 1.55rem);
    font-weight: 600;
    letter-spacing: 0.22em;
    line-height: 1.7;
  }
  .xw-block h4 {
    margin-top: 1.6rem;
    color: #f8dca0;
    font-size: 1.06rem;
    letter-spacing: 0.18em;
    line-height: 1.9;
  }
  .xw-block > p {
    margin-top: 0.8rem;
    color: var(--bone-dim);
    font-size: 0.94rem;
    line-height: 2.15;
  }
  .xw-block > p.xw-quote {
    margin-top: 1.1rem;
    padding: 1rem 1.3rem;
    border-block: 1px solid var(--ink-line);
    color: var(--gold);
    font-size: 1rem;
    letter-spacing: 0.14em;
    line-height: 2.1;
  }

  .xw-entries {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
  }
  .xw-entries li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding-block: 0.5rem;
  }
  .xw-dot {
    flex: none;
    width: 5px;
    height: 5px;
    margin-top: 0.85em;
    border-radius: 50%;
    background: var(--gold);
  }
  .xw-entries p {
    margin: 0;
    color: var(--bone-dim);
    font-size: 0.93rem;
    line-height: 2.1;
  }

  .xw-note {
    margin-top: 1rem;
    padding: 0.95rem 1.3rem;
    border-left: 2px solid var(--bronze-dim);
    background: var(--panel-soft);
  }
  .xw-note p {
    margin: 0;
    color: var(--bone-faint);
    font-size: 0.86rem;
    line-height: 2.05;
  }

  .xw-back {
    margin-top: clamp(1.8rem, 4vw, 2.4rem);
    text-align: right;
    font-size: 0.82rem;
    letter-spacing: 0.2em;
  }
  .xw-back a {
    color: var(--bone-faint);
    text-decoration: none;
    transition: color 0.3s var(--ease-soft);
  }
  .xw-back a:hover { color: var(--gold-bright); }

  /* ============================================================
     Mobile collapse
     ============================================================ */

  @media (max-width: 720px) {
    .xianwen-hero { padding: 2.2rem 0 2.5rem; }
    .xianwen-hero-wrap {
      grid-template-columns: 1fr;
      gap: 1.6rem;
      justify-items: center;
      text-align: center;
    }
    .xianwen-mark-block {
      width: 7rem;
      height: 7rem;
    }
    .xianwen-rule { margin-inline: auto; }
    .xw-head { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .xw-head-text { text-align: center; }
    .xw-glyph { font-size: 2.8rem; }
    .xw-toc-body i { font-size: 0.8rem; }
  }

  @media (max-width: 600px) {
    .xw-block > p,
    .xw-entries p { font-size: 0.9rem; }
    .xw-toc a { padding: 0.8rem 0.9rem; gap: 0.7rem; }
  }

  /* ============================================================
     Reduced motion
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {
    .xianwen-grain { opacity: 0.32; }
    .xianwen-mark,
    .xianwen-title { animation: none; }
    .xianwen-btn,
    .xw-toc a,
    .xw-back a { transition: none; }
  }
</style>
