---
// 法脉总览：挂载《分支图》，五个发光节点上叠透明热区，点击跳转对应法脉。
// 背景阵纹：仅引入云雷祭阵 v2（道家阵法），不改动树/图片/热区等其他设计。
import RitualArray from '../components/ritual/RitualArray.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const branches = [
  { name: '咒法', route: '/zhoufa', x: 32, y: 34, w: 22, h: 14 },
  { name: '偶景', route: '/oujing', x: 76, y: 30, w: 22, h: 14 },
  { name: '真气治病', route: '/zhenqi', x: 78, y: 41, w: 23, h: 14 },
  { name: '鏖战法', route: '/aozhan', x: 29, y: 56, w: 22, h: 14 },
  { name: '驻颜术', route: '/zhuyanshu', x: 81, y: 60, w: 23, h: 14 },
];
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="上古祝门四脉分支目录：根出一源，法分五脉，循脉而入。古巫祝脉传承脉图。" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>古巫祝脉 · 法门总览</title>
  </head>
  <body>
    <!-- 云雷祭阵 v2：黑金道家阵法铺在整页背后，veil 叠在其上收暗角 -->
    <RitualArray />

    <div class="veil" aria-hidden="true"></div>

    <header class="top">
      <a class="brand kai" href={`${base}/`}>古巫祝脉</a>
      <span class="top-title kai">法门总览</span>
      <a class="top-link kai" href={`${base}/zhoufa`}>进入祝门</a>
    </header>

    <main>
      <header class="map-head">
        <p class="map-kicker kai">古巫祝脉 · 法脉总览</p>
        <h1 class="kai">法脉分支</h1>
        <p class="map-sub">点击分支节点，以进入对应法脉详情页面</p>
      </header>

      <div class="map-frame">
        <img class="map-img" src={`${base}/分支图.jpg`} alt="古巫祝脉五脉分支图" loading="eager" />
        {branches.map((b) => (
          <a
            class="map-hotspot"
            href={`${base}${b.route}`}
            aria-label={`进入${b.name}`}
            data-name={b.name}
            style={`left:${b.x}%; top:${b.y}%; width:${b.w}%; --hs-h:${b.h}%;`}
          >
            <span class="hotspot-ring" aria-hidden="true"></span>
          </a>
        ))}
      </div>
    </main>

    <footer class="foot kai">五脉同源 · 各有所传</footer>

    <script>
      (function () {
        var svg = document.querySelector('.array-bg');
        if (!svg) return;
        var fit = function () {
          var img = document.querySelector('.map-img');
          var imgTop = img ? img.getBoundingClientRect().top : window.innerHeight * 0.2;
          var yTop = Math.min(Math.max(imgTop * 0.72, 250), 380);
          var D = Math.min(window.innerWidth * 0.62, window.innerHeight * 0.92); /* 放大后的阵径 */
          var R = D / 2;
          svg.style.width = D + 'px';
          svg.style.height = D + 'px';
          svg.style.marginLeft = (-R) + 'px';
          svg.style.top = (yTop - R) + 'px';
        };
        fit();
        window.addEventListener('resize', fit);
        window.addEventListener('load', fit);
        setTimeout(fit, 400);
      })();
    </script>
  </body>
</html>

<style>
  :root {
    --gold: #b99752;
    --gold-bright: #e7d39a;
    --gold-dim: #66502a;
    --ink: #d9d2c2;
    --ink-faint: #6b5730;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    min-height: 100dvh;
    padding-top: clamp(2rem, 5vw, 4.5rem);
    background: radial-gradient(ellipse 60% 40% at 50% 22%, rgba(185, 151, 82, 0.08), transparent 70%), #050505;
    color: var(--ink);
    font-family: "Songti SC", "STSong", "SimSun", "Noto Serif SC", serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .kai { font-family: "Kaiti SC", "STKaiti", "KaiTi", serif; }

  .veil {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 52% 40% at 50% 30%, rgba(185, 151, 82, 0.07), transparent 70%),
      linear-gradient(90deg, rgba(0,0,0,.5), transparent 16%, transparent 84%, rgba(0,0,0,.5));
  }

  .top {
    position: relative;
    z-index: 2;
    width: min(100% - 3rem, 44rem);
    min-height: 4.2rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid rgba(185, 151, 82, 0.18);
  }

  .brand, .top-link {
    color: #d4b877;
    font-size: 0.9rem;
    letter-spacing: 0.32em;
    text-decoration: none;
    transition: color 0.25s;
  }
  .brand:hover, .top-link:hover { color: #f0e3c8; }
  .top-title { color: #817253; font-size: 0.7rem; letter-spacing: 0.44em; }
  .top-link { justify-self: end; }

  main {
    position: relative;
    z-index: 2;
    padding-bottom: 2.5rem;
  }

  .map-head {
    position: relative;
    z-index: 0;
    padding: clamp(2.6rem, 6vw, 4.6rem) 0 clamp(1rem, 2.2vw, 1.8rem);
    text-align: center;
  }

  .map-head::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(92vw, 46rem);
    height: 11.5rem;
    background: radial-gradient(ellipse 50% 55% at 50% 50%, rgba(5, 5, 5, 0.78), rgba(5, 5, 5, 0.22) 55%, transparent 78%);
    z-index: 0;
    pointer-events: none;
  }

  .map-kicker,
  .map-head h1,
  .map-sub { position: relative; z-index: 1; }

  .map-kicker { color: var(--gold-dim); font-size: 0.72rem; letter-spacing: 0.6em; text-indent: 0.6em; }

  .map-head h1 {
    margin-top: 0.7rem;
    background: linear-gradient(180deg, #fff1a8 0%, #d8b45a 25%, #a67c2f 55%, #f3d77a 75%, #8a6425 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0.34em;
    text-indent: 0.34em;
  }

  .map-sub {
    margin-top: 0.75rem;
    background: linear-gradient(180deg, #f5e6b0 0%, #d9b969 28%, #a67c2f 55%, #e8cd82 78%, #9a7330 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 0.82rem;
    letter-spacing: 0.24em;
    text-indent: 0.24em;
    text-shadow: 0 0 14px rgba(205, 160, 60, 0.16);
  }

  /* ---- 图 + 透明热区 ---- */
  .map-frame {
    position: relative;
    width: min(100% - 1.5rem, 640px);
    margin-inline: auto;
    margin-top: clamp(7rem, 18vw, 12rem);
  }

  .map-img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(185, 151, 82, 0.24);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.35),
      0 26px 70px rgba(0, 0, 0, 0.62),
      0 0 90px rgba(0, 0, 0, 0.55);
  }

  .map-hotspot {
    position: absolute;
    height: var(--hs-h, 10%);
    transform: translate(-50%, -50%);
    border-radius: 14px;
    z-index: 3;
    outline: none;
    cursor: pointer;
  }

  .hotspot-ring {
    position: absolute;
    inset: 10%;
    border: 1px solid transparent;
    border-radius: 50%;
    transition: border-color 0.25s, box-shadow 0.25s, background 0.25s, transform 0.25s;
  }

  .map-hotspot:hover .hotspot-ring,
  .map-hotspot:focus-visible .hotspot-ring {
    border-color: rgba(240, 217, 160, 0.9);
    background: rgba(231, 211, 154, 0.1);
    box-shadow: 0 0 22px rgba(231, 211, 154, 0.4), inset 0 0 16px rgba(231, 211, 154, 0.22);
    transform: scale(1.06);
  }

  /* hover 显示分支名小签 */
  .map-hotspot::after {
    content: attr(data-name);
    position: absolute;
    left: 50%;
    top: calc(100% + 6px);
    transform: translateX(-50%);
    padding: 0.28em 0.8em;
    white-space: nowrap;
    color: #f0e3c8;
    background: rgba(10, 7, 3, 0.88);
    border: 1px solid rgba(185, 151, 82, 0.5);
    font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
    z-index: 4;
  }
  .map-hotspot:hover::after,
  .map-hotspot:focus-visible::after { opacity: 1; }

  .foot {
    position: relative;
    z-index: 2;
    width: min(100% - 3rem, 44rem);
    margin-inline: auto;
    padding: 1.3rem 0 2rem;
    border-top: 1px solid rgba(212, 184, 119, 0.12);
    color: #766746;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.42em;
  }

  @media (max-width: 640px) {
    .top { width: min(100% - 2.2rem, 44rem); grid-template-columns: 1fr auto; }
    .top-title { display: none; }
    .brand, .top-link { font-size: 0.8rem; letter-spacing: 0.2em; }
    .map-frame { width: 100%; }
    .map-sub { letter-spacing: 0.14em; text-indent: 0.14em; }
  }
</style>

<style is:global>
  /* ---- 云雷祭阵背景（仅阵纹样式，页面其余设计保持原样） ----
     暗金 #66502A 承担阵的主体，亮金 #B99752 只给核心 / 阵眼 / 交叉点。 */
  .array-bg {
    position: fixed;
    left: 50%;
    top: 0;
    width: 540px;
    height: 540px;
    margin-left: -270px;
    z-index: 0;
    display: block;
    pointer-events: none;
    color: #a37f3f;
    overflow: visible;
    filter: drop-shadow(0 0 6px rgba(185, 151, 82, 0.18));
  }

  .array-bg .a-dim { opacity: 1; }
  .array-bg .a-bright { color: #e0be72; opacity: 1; }
  .array-bg .a-faint { opacity: 0.45; }

  .array-bg .a-guide {
    fill: none;
    stroke: currentColor;
    stroke-width: 5;
    stroke-dasharray: 3 10;
    opacity: 0.55;
  }
  .array-bg .a-ring {
    fill: none;
    stroke: currentColor;
    stroke-width: 6;
  }
  .array-bg .a-ring.a-thin {
    stroke-width: 3;
    opacity: 0.75;
  }
  .array-bg .a-tick {
    fill: none;
    stroke: currentColor;
    stroke-width: 5;
    opacity: 0.85;
  }
  .array-bg .a-poly {
    fill: none;
    stroke: currentColor;
    stroke-width: 6;
    opacity: 0.85;
  }
  .array-bg .a-core-frame {
    fill: none;
    stroke: currentColor;
    stroke-width: 7;
  }
  .array-bg .a-wu-ring {
    fill: none;
    stroke: currentColor;
    stroke-width: 6;
    opacity: 1;
  }
  .array-bg .a-wu-img {
    filter: drop-shadow(0 0 10px rgba(224, 190, 114, 0.4));
  }
  .array-bg .a-knot circle { fill: currentColor; }
  .array-bg .a-knot path { fill: none; stroke: currentColor; stroke-width: 6; }
  .array-bg .a-dot { fill: currentColor; stroke: none; }

  /* 纹样单元（雷纹/云纹/回纹/窃曲…）：统一走 currentColor，两层各自成金 */
  .array-bg #thunder-square path,
  .array-bg #thunder-hook path,
  .array-bg #thunder-wave path,
  .array-bg #cloud-single path,
  .array-bg #cloud-double path,
  .array-bg #cloud-s path,
  .array-bg #kui-curve path,
  .array-bg #quequ path,
  .array-bg #hui path,
  .array-bg #bronze-core path {
    fill: none;
    stroke: currentColor;
    stroke-width: 3.6;
  }
  .array-bg #cloud-single circle,
  .array-bg #cloud-double circle,
  .array-bg #cloud-s circle,
  .array-bg #bead-border circle,
  .array-bg #thunder-hook circle,
  .array-bg #quequ circle,
  .array-bg #kui-curve circle {
    fill: currentColor;
    stroke: none;
  }

  /* 八卦爻 / 太极 / 北斗 / 辰位 */
  .array-bg .a-tri { opacity: 0.95; }
  .array-bg .a-taiji { opacity: 0.5; }
  .array-bg .a-star { opacity: 0.9; }
  .array-bg .a-node { fill: #c49a52; }
  .array-bg .a-node-ring { fill: none; stroke: #b08a45; stroke-width: 4; opacity: 0.8; }

  /* 圆环呼吸高光：沿符文带流动的金色光晕 */
  .array-bg .a-sheen {
    fill: none;
    stroke: #e6c983;
    stroke-width: 9;
    stroke-linecap: round;
    stroke-dasharray: 40 100;
    opacity: 0.55;
    animation: aSheen 20s linear infinite;
  }
  .array-bg .a-sheen2 {
    fill: none;
    stroke: #d8b36a;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 24 84;
    opacity: 0.45;
    animation: aSheen2 26s linear infinite;
  }
  @keyframes aSheen {
    0% { stroke-dashoffset: 0; opacity: 0.4; }
    45% { opacity: 0.8; }
    55% { opacity: 0.8; }
    100% { stroke-dashoffset: -620; opacity: 0.4; }
  }
  @keyframes aSheen2 {
    0% { stroke-dashoffset: 0; opacity: 0.3; }
    50% { opacity: 0.65; }
    100% { stroke-dashoffset: -460; opacity: 0.3; }
  }

  /* ---- 全阵缓转：外阵顺转 / 内阵逆转，核心与阵眼定住 ---- */
  .array-bg .a-rotate-cw,
  .array-bg .a-rotate-ccw {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }
  .array-bg .a-rotate-cw { animation: aSpinCw 200s linear infinite; }
  .array-bg .a-rotate-ccw { animation: aSpinCcw 260s linear infinite; }
  @keyframes aSpinCw {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes aSpinCcw {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .array-bg .a-sheen,
    .array-bg .a-sheen2 { animation: none; }
    .array-bg .a-rotate-cw,
    .array-bg .a-rotate-ccw { animation: none; }
  }

</style>