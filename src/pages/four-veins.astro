---
// 法脉总览：主体是《分支图》本身——它就是本页的目录地图。
// 视觉层级：主体图 > 图上分支节点 > 标题 > 法阵 > 云雷纹 > 背景。
// 法阵退到背景层（低透明度），圆环从图片后方穿过；图片无矩形边框，
// 中央清晰、四周经 mask 羽化自然消散进黑色背景。
import NineStarArray from '../components/ritual/NineStarArray.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const branches = [
  { name: '法门', route: '/famen', x: 27, y: 38, w: 20, h: 8 },
  { name: '修炼常识', route: '/zhoufa/zhishi', x: 79, y: 30, w: 24, h: 8 },
  { name: '秘闻', route: '/zhoufa/wenzhang', x: 19.5, y: 56, w: 18, h: 8 },
  { name: '闲文', route: '/xianwen', x: 80, y: 64, w: 18, h: 8 },
];
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="古巫祝脉分支目录：一树同源，法分法门、修炼常识、秘闻、闲文诸枝，循脉而入。传承脉图。" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>古巫祝脉 · 法门总览</title>
  </head>
  <body>
    <div class="veil" aria-hidden="true"></div>

    <header class="top">
      <a class="brand kai" href={`${base}/`}>古巫祝脉</a>
      <span class="top-title kai">法门总览</span>
      <a class="top-link kai" href={`${base}/zhoufa`}>进入祝门</a>
    </header>

    <main>
      <header class="map-head">
        <p class="map-kicker kai">古巫祝脉 · 法脉总览</p>
      </header>

      <!-- 舞台：法阵在底层，主体图压在其上，圆环从图后方左右穿出 -->
      <div class="stage">
        <div class="array-layer" aria-hidden="true">
          <NineStarArray />
        </div>

        <div class="map-frame">
          <img class="map-img" src={`${base}/分支图-new.png`} alt="古巫祝脉分支图：法门、修炼常识、秘闻、闲文" loading="eager" />
          {branches.map((b) => (
            <a
              class="map-hotspot"
              href={`${base}${b.route}`}
              aria-label={`进入${b.name}`}
              data-name={b.name}
              style={`left:${b.x}%; top:${b.y}%; width:${b.w}%; --hs-h:${b.h}%;`}
            >
              <span class="hotspot-ring" aria-hidden="true"></span>
            </a>
          ))}
        </div>
      </div>
    </main>

    <footer class="foot kai">诸枝同源 · 各有所传</footer>
  </body>
</html>

<style>
  :root {
    --gold: #b99752;
    --gold-bright: #e7d39a;
    --gold-dim: #66502a;
    --ink: #d9d2c2;
    --ink-faint: #6b5730;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  /* 法阵层远宽于视口：横向直接裁剪，不产生滚动区域 */
  html, body {
    overflow-x: hidden;
    overflow-x: clip;
  }

  body {
    min-height: 100dvh;
    padding-top: clamp(2rem, 5vw, 4.5rem);
    background:
      radial-gradient(ellipse 60% 40% at 50% 30%, rgba(185, 151, 82, 0.08), transparent 70%),
      #050505;
    color: var(--ink);
    font-family: "Songti SC", "STSong", "SimSun", "Noto Serif SC", serif;
    -webkit-font-smoothing: antialiased;
  }

  .kai { font-family: "Kaiti SC", "STKaiti", "KaiTi", serif; }

  .veil {
    position: fixed;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    background:
      radial-gradient(ellipse 52% 40% at 50% 34%, rgba(185, 151, 82, 0.05), transparent 70%),
      linear-gradient(90deg, rgba(0,0,0,.55), transparent 18%, transparent 82%, rgba(0,0,0,.55));
  }

  .top {
    position: relative;
    z-index: 6;
    width: min(100% - 3rem, 44rem);
    min-height: 4.2rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid rgba(185, 151, 82, 0.18);
  }

  .brand, .top-link {
    color: #d4b877;
    font-size: 0.9rem;
    letter-spacing: 0.32em;
    text-decoration: none;
    transition: color 0.25s;
  }
  .brand:hover, .top-link:hover { color: #f0e3c8; }
  .top-title { color: #817253; font-size: 0.7rem; letter-spacing: 0.44em; }
  .top-link { justify-self: end; }

  main {
    position: relative;
    z-index: 2;
    padding-bottom: 1.5rem;
  }

  /* ---- 标题：压在主体图上方，视觉层级低于图 ---- */
  .map-head {
    position: relative;
    z-index: 3;
    padding: clamp(1.8rem, 4vw, 3.2rem) 0 clamp(0.6rem, 1.5vw, 1.2rem);
    text-align: center;
  }

  .map-kicker { position: relative; z-index: 1; color: var(--gold-dim); font-size: 0.72rem; letter-spacing: 0.6em; text-indent: 0.6em; }

  .map-head h1 {
    margin-top: 0.7rem;
    background: linear-gradient(180deg, #fff1a8 0%, #d8b45a 25%, #a67c2f 55%, #f3d77a 75%, #8a6425 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: clamp(1.9rem, 4.4vw, 2.9rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0.34em;
    text-indent: 0.34em;
  }

  .map-sub {
    margin-top: 0.7rem;
    background: linear-gradient(180deg, #f5e6b0 0%, #d9b969 28%, #a67c2f 55%, #e8cd82 78%, #9a7330 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 0.8rem;
    letter-spacing: 0.24em;
    text-indent: 0.24em;
    text-shadow: 0 0 14px rgba(205, 160, 60, 0.16);
  }

  /* ---- 舞台：法阵层 + 主体图 ---- */
  .stage {
    position: relative;
    display: flex;
    justify-content: center;
    padding-bottom: clamp(1rem, 3vw, 2.5rem);
  }

  /* 法阵退到背景层：圆环直径大于图宽，从图后方左右两侧穿出；中心与主体图中心对齐 */
  .array-layer {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(255%, 2130px);
    aspect-ratio: 1 / 1;
    z-index: 0;
    opacity: 0.82;
    filter: brightness(1.35);
    pointer-events: none;
  }

  .map-frame {
    position: relative;
    z-index: 2;
    /* 新图为竖幅（1052×1494），收窄容器控制整页高度 */
    width: min(100% - 1.5rem, 50vw, 600px);
  }

  /* 金色光晕垫在图后，让图与法阵衔接处有过渡 */
  .map-frame::before {
    content: "";
    position: absolute;
    inset: -12%;
    background: radial-gradient(ellipse 52% 48% at 50% 44%, rgba(185, 151, 82, 0.13), transparent 72%);
    filter: blur(6px);
    z-index: 0;
    pointer-events: none;
  }

  /* 主体图：无矩形边框。中央约 70% 清晰，四周羽化消散进黑背景 */
  .map-img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    filter: saturate(0.94) contrast(1.05) brightness(0.97);
    /* 边框淡化融入背景：四周羽化。横向留足余量，避免压住两侧文字节点 */
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, #000 9%, #000 91%, transparent 100%),
      linear-gradient(180deg, transparent 0%, #000 7%, #000 92%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 9%, #000 91%, transparent 100%),
      linear-gradient(180deg, transparent 0%, #000 7%, #000 92%, transparent 100%);
    mask-composite: intersect;
  }

  /* ---- 图上透明热区：真正的交互节点 ---- */
  .map-hotspot {
    position: absolute;
    height: var(--hs-h, 10%);
    transform: translate(-50%, -50%);
    border-radius: 14px;
    z-index: 3;
    outline: none;
    cursor: pointer;
  }

  .hotspot-ring {
    position: absolute;
    inset: 6%;
    border: 1px solid rgba(231, 211, 154, 0.28);
    border-radius: 50%;
    opacity: 0.45;
    animation: hsBreath 3.6s ease-in-out infinite;
    transition: border-color 0.25s, box-shadow 0.25s, background 0.25s, transform 0.25s, opacity 0.25s;
  }

  @keyframes hsBreath {
    0%, 100% { box-shadow: 0 0 6px rgba(231, 211, 154, 0.08), inset 0 0 8px rgba(231, 211, 154, 0.05); }
    50% { box-shadow: 0 0 16px rgba(231, 211, 154, 0.22), inset 0 0 14px rgba(231, 211, 154, 0.12); }
  }

  .map-hotspot:hover .hotspot-ring,
  .map-hotspot:focus-visible .hotspot-ring {
    animation: none;
    opacity: 1;
    border-color: rgba(240, 217, 160, 0.9);
    background: rgba(231, 211, 154, 0.1);
    box-shadow: 0 0 26px rgba(231, 211, 154, 0.45), inset 0 0 18px rgba(231, 211, 154, 0.25);
    transform: scale(1.07);
  }

  /* hover 显示分支名小签 */
  .map-hotspot::after {
    content: attr(data-name);
    position: absolute;
    left: 50%;
    top: calc(100% + 6px);
    transform: translateX(-50%);
    padding: 0.28em 0.8em;
    white-space: nowrap;
    color: #f0e3c8;
    background: rgba(10, 7, 3, 0.88);
    border: 1px solid rgba(185, 151, 82, 0.5);
    font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
    z-index: 4;
  }
  .map-hotspot:hover::after,
  .map-hotspot:focus-visible::after { opacity: 1; }

  .foot {
    position: relative;
    z-index: 6;
    width: min(100% - 3rem, 44rem);
    margin-inline: auto;
    padding: 1.3rem 0 2rem;
    border-top: 1px solid rgba(212, 184, 119, 0.12);
    color: #766746;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.42em;
  }

  @media (max-width: 900px) {
    .map-frame { width: min(100% - 1.5rem, 62vw); }
    .array-layer { width: min(301%, 1680px); opacity: 0.74; }
  }

  @media (max-width: 640px) {
    .top { width: min(100% - 2.2rem, 44rem); grid-template-columns: 1fr auto; }
    .top-title { display: none; }
    .brand, .top-link { font-size: 0.8rem; letter-spacing: 0.2em; }
    .map-frame { width: 100%; }
    .array-layer { width: 350%; opacity: 0.62; top: 50%; }
    .map-sub { letter-spacing: 0.14em; text-indent: 0.14em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hotspot-ring { animation: none; }
  }
</style>

<style is:global>
  /* ---- 云雷祭阵背景：作为主体图的容器/圣化层，整体低亮度 ----
     暗金 #66502A 承担阵的主体，亮金 #B99752 只给核心 / 阵眼 / 交叉点。 */
  .array-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    display: block;
    pointer-events: none;
    color: #b9903f;
    overflow: visible;
    filter: drop-shadow(0 0 5px rgba(185, 151, 82, 0.12));
  }

  .array-bg .a-dim { opacity: 0.4; }
  .array-bg .a-track { opacity: 0.78; }
  .array-bg .a-bright { color: #cfa95e; opacity: 1; filter: brightness(1.5); }
  .array-bg .a-faint { opacity: 0.35; }

  .array-bg .a-guide {
    fill: none;
    stroke: currentColor;
    stroke-width: 5;
    stroke-dasharray: 3 10;
    opacity: 0.55;
  }
  .array-bg .a-ring {
    fill: none;
    stroke: currentColor;
    stroke-width: 6;
  }
  .array-bg .a-ring.a-thin {
    stroke-width: 3;
    opacity: 0.75;
  }
  .array-bg .a-tick {
    fill: none;
    stroke: currentColor;
    stroke-width: 5;
    opacity: 0.85;
  }
  .array-bg .a-poly {
    fill: none;
    stroke: currentColor;
    stroke-width: 6;
    opacity: 0.85;
  }
  .array-bg .a-core-frame {
    fill: none;
    stroke: currentColor;
    stroke-width: 7;
  }
  .array-bg .a-wu-ring {
    fill: none;
    stroke: currentColor;
    stroke-width: 6;
    opacity: 1;
  }
  .array-bg .a-wu-img {
    filter: drop-shadow(0 0 10px rgba(224, 190, 114, 0.35));
  }
  .array-bg .a-knot circle { fill: currentColor; }
  .array-bg .a-knot path { fill: none; stroke: currentColor; stroke-width: 6; }
  .array-bg .a-dot { fill: currentColor; stroke: none; }

  /* 纹样单元（雷纹/云纹/回纹/窃曲…）：统一走 currentColor，两层各自成金 */
  .array-bg #thunder-square path,
  .array-bg #thunder-hook path,
  .array-bg #thunder-wave path,
  .array-bg #cloud-single path,
  .array-bg #cloud-double path,
  .array-bg #cloud-s path,
  .array-bg #kui-curve path,
  .array-bg #quequ path,
  .array-bg #hui path,
  .array-bg #bronze-core path {
    fill: none;
    stroke: currentColor;
    stroke-width: 3.6;
  }
  .array-bg #cloud-single circle,
  .array-bg #cloud-double circle,
  .array-bg #cloud-s circle,
  .array-bg #bead-border circle,
  .array-bg #thunder-hook circle,
  .array-bg #quequ circle,
  .array-bg #kui-curve circle {
    fill: currentColor;
    stroke: none;
  }

  /* 八卦爻 / 太极 / 北斗 / 辰位 */
  .array-bg .a-tri { opacity: 0.95; }
  .array-bg .a-taiji { opacity: 0.5; }
  .array-bg .a-star { opacity: 0.9; }
  .array-bg .a-node { fill: #c79a4a; }
  .array-bg .a-node-ring { fill: none; stroke: #b08736; stroke-width: 4; opacity: 0.8; }

  /* 圆环呼吸高光：沿符文带流动的金色光晕 */
  .array-bg .a-sheen {
    fill: none;
    stroke: #d8ba74;
    stroke-width: 9;
    stroke-linecap: round;
    stroke-dasharray: 40 100;
    opacity: 0.4;
    animation: aSheen 20s linear infinite;
  }
  .array-bg .a-sheen2 {
    fill: none;
    stroke: #c9a55e;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 24 84;
    opacity: 0.32;
    animation: aSheen2 26s linear infinite;
  }
  @keyframes aSheen {
    0% { stroke-dashoffset: 0; opacity: 0.28; }
    45% { opacity: 0.55; }
    55% { opacity: 0.55; }
    100% { stroke-dashoffset: -620; opacity: 0.28; }
  }
  @keyframes aSheen2 {
    0% { stroke-dashoffset: 0; opacity: 0.2; }
    50% { opacity: 0.45; }
    100% { stroke-dashoffset: -460; opacity: 0.2; }
  }

  /* ---- 全阵缓转：外阵顺转 / 内阵逆转，核心与阵眼定住 ---- */
  .array-bg .a-rotate-cw,
  .array-bg .a-rotate-ccw {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }
  .array-bg .a-rotate-cw { animation: aSpinCw 200s linear infinite; }
  .array-bg .a-rotate-ccw { animation: aSpinCcw 260s linear infinite; }
  @keyframes aSpinCw {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes aSpinCcw {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .array-bg .a-sheen,
    .array-bg .a-sheen2 { animation: none; }
    .array-bg .a-rotate-cw,
    .array-bg .a-rotate-ccw { animation: none; }
  }
</style>
