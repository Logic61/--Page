---
import Base from '../../layouts/Base.astro';
import GoldNav from '../../components/GoldNav.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = '传授法门 · 上古祝门';
const description = '传授法门：咒法、偶景、鏖战、驻颜、真气疗愈五门正传，另立神道法一门以辨明，循门而入。';

interface Gate {
  glyph: string;
  name: string;
  subtitle: string;
  desc: string;
  route: string;
  /** 介绍页入口（卡片上暂不展示，保留以便随时恢复小字行） */
  intro: string;
  /** 报名入口；「辨明之门」不设报名，故可缺省（同上，暂不展示） */
  baoming?: string;
  accent: string;
}

const gates: Gate[] = [
  {
    glyph: '咒',
    name: '咒法',
    subtitle: '通窍 · 开脉 · 合一',
    desc: '上古祝门之根本。以诵咒通窍开脉，锻炼神形，追求天人合一，万物一咒。',
    route: '/zhoufa',
    intro: '/zhoufa/jieshao',
    baoming: '/zhoufa/baoming',
    accent: '#b89a5e',
  },
  {
    glyph: '景',
    name: '偶景',
    subtitle: '仙偶 · 道侣 · 双修',
    desc: '偶者仙偶，景者影也：偶景，又叫偶影，就是相与为偶，形影不离的意思。',
    route: '/oujing',
    intro: '/oujing/jieshao',
    baoming: '/oujing/baoming',
    accent: '#8291b7',
  },
  {
    glyph: '战',
    name: '鏖战',
    subtitle: '丹基 · 房中 · 养生',
    desc: '源自人元丹法筑基，交而不泄，养生配套，非邪法，养身以续其道。',
    route: '/aozhan',
    intro: '/aozhan/jieshao',
    baoming: '/aozhan/baoming',
    accent: '#b8785e',
  },
  {
    glyph: '颜',
    name: '驻颜',
    subtitle: '驻容 · 养容 · 生发',
    desc: '以气血温养为本，驻容颜于岁月之中，养容仪于日常之间。',
    route: '/zhuyanshu',
    intro: '/zhuyanshu/jieshao',
    baoming: '/zhuyanshu/baoming',
    accent: '#b99752',
  },
  {
    glyph: '气',
    name: '真气疗愈',
    subtitle: '外气 · 神气 · 激发',
    desc: '外气疗愈机理之辨：激发潜力、赋予精气、移除恶气，真气外发而愈人疾。',
    route: '/zhenqi',
    intro: '/zhenqi/jieshao',
    baoming: '/zhenqi/baoming',
    accent: '#7fa387',
  },
  {
    glyph: '神',
    name: '神道法',
    subtitle: '香火 · 封神 · 下种',
    desc: '由香火念力衍生之法门：聚念、拜神、下种、带功、灌顶、附身。其利在易，其弊在受制，故此门以辨明为归。',
    route: '/shendao',
    intro: '/shendao/jieshao',
    accent: '#cf8a52',
  },
];
---

<Base title={title} description={description} hideNav={true} search="gold">
  <div class="famen-scope">

    {/* 整页背景：与「修炼常识」同源的「山河金影」图（public/bg/shanhe-gold.webp）。
        原图顶部带站点导航栏，已裁掉（y 0-71），只保留山河星月水影画面。
        视口固定、cover 铺满，页面滚动时背景不动。 */}
    <div
      class="famen-pattern"
      aria-hidden="true"
      style={`background-image:url('${base}/bg/shanhe-gold.webp')`}
    ></div>

    {/* 顶部栏：玄金令牌，五个板块（首页 / 法门 / 秘闻 / 修炼常识 / 闲文），右侧带全局搜索（Ctrl+K） */}
    <GoldNav showSearch />

    <section class="famen-hero" aria-labelledby="famen-hero-title">
      <div class="famen-grain" aria-hidden="true"></div>
      <div class="famen-vignette" aria-hidden="true"></div>

      <div class="wrap famen-hero-wrap">
        <div class="famen-mark-block reveal">
          <span class="famen-mark-frame" aria-hidden="true"></span>
          <span class="famen-mark zhuan">法</span>
        </div>

        <div class="famen-hero-text reveal" data-d="2">
          <a class="famen-back kai" href={`${base}/famen`}>
            <span class="famen-back-arrow" aria-hidden="true">←</span> 返回法门
          </a>
          <p class="famen-eyebrow kai">法 门 · 五 门 正 传 · 一 门 以 辨</p>
          <h1 id="famen-hero-title" class="famen-title kai">传授法门</h1>
          <div class="famen-rule" aria-hidden="true"></div>
          <p class="famen-sub">诸法之门，循门而入。上古祝门之法分作五支，各承一脉；另立神道法一门，以辨香火之途。门门有径，径径通幽。</p>
          <p class="famen-meta kai">分支目录 · 五门正传 · 另立一门以辨</p>
        </div>
      </div>
    </section>

    <section class="gates" aria-labelledby="gates-title">
      <div class="wrap">
        <h2 id="gates-title" class="visually-hidden">六门目录</h2>

        <div class="gate-grid">
          {
            gates.map((g, i) => (
              <article class="gate reveal" style={`--c:${g.accent};`} data-d={i + 1}>
                <a class="gate-cover" href={`${base}${g.route}`} aria-label={`进入${g.name}`}></a>
                <span class="gate-glyph zhuan" aria-hidden="true">{g.glyph}</span>
                <div class="gate-body">
                  <h3 class="gate-name kai">{g.name}</h3>
                  <p class="gate-sub">{g.subtitle}</p>
                  <p class="gate-desc">{g.desc}</p>
                </div>
              </article>
            ))
          }
        </div>

      </div>
    </section>

  </div>
</Base>

<style>
  /* ============================================================
     法门 · 玄金之页
     与「修炼常识」同源：同一套黑金令牌（tokens）、同一张
     「山河金影」底图、同一套首屏（印框 + 鎏金标题 + 金线）。
     门卡沿用旧版结构，配色改压在同一套金线上。
     用 `html[data-theme]` 前缀，确保盖过 global.css 里的浅色主题。
     ============================================================ */

  html[data-theme] .famen-scope {
    --ink: #0a0604;
    --ink-2: #100b07;
    --ink-3: #18120b;
    --ink-line: rgba(248, 220, 160, 0.2);
    --bone: #f9edc1;
    --bone-dim: #e8d8b6;
    --bone-faint: #d0b98a;

    --heading: #fdf4d2;
    --gold: #f0d59f;
    --gold-bright: #fff0cb;
    --gold-deep: #bd9a55;
    /* brightest highlight stop, used for liquid-gold gradient text */
    --gold-edge: #fffceb;
    --gold-glow: rgba(248, 220, 160, 0.6);
    --gold-line: rgba(248, 220, 160, 0.42);
    --gold-line-strong: rgba(248, 220, 160, 0.72);

    --panel-soft: rgba(248, 220, 160, 0.08);
    /* 门卡混色用的亮金/暗金（旧版引用了这两个名字） */
    --bronze-bright: var(--gold-bright);
    --bronze-dim: #d2b67e;

    background: var(--ink);
    color: var(--bone);
    position: relative;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ============================================================
     整页背景 — 「山河金影」（与修炼常识页同一张图）
     视口固定、cover 铺满、不重复；页面滚动时背景不动。
     ============================================================ */
  .famen-pattern {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-repeat: no-repeat;
    background-position: 50% 50%;
    background-size: cover;
  }

  /* ============================================================
     Hero（与修炼常识首屏同构）
     ============================================================ */

  .famen-hero {
    position: relative;
    padding: clamp(2.6rem, 5vw, 4rem) 0 clamp(3rem, 6vw, 5rem);
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--gold-line);
  }
  .famen-grain {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.45;
    background-image:
      radial-gradient(circle at 22% 28%, rgba(236, 200, 121, 0.08) 0%, transparent 38%),
      radial-gradient(circle at 82% 18%, rgba(201, 169, 97, 0.06) 0%, transparent 42%),
      radial-gradient(circle at 58% 82%, rgba(201, 169, 97, 0.04) 0%, transparent 50%);
    mix-blend-mode: screen;
  }
  .famen-vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 80% at 50% 50%, transparent 35%, rgba(0, 0, 0, 0.65) 100%);
  }
  .famen-hero-wrap {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .famen-mark-block {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(8rem, 16vw, 12rem);
    height: clamp(8rem, 16vw, 12rem);
    flex: none;
  }
  .famen-mark-frame {
    position: absolute;
    inset: 0;
    border: 1px solid var(--gold-line-strong);
    transform: rotate(45deg);
  }
  .famen-mark-frame::before,
  .famen-mark-frame::after {
    content: '';
    position: absolute;
    background: var(--gold);
  }
  .famen-mark-frame::before {
    top: -1px;
    left: -1px;
    width: 1.2rem;
    height: 1px;
  }
  .famen-mark-frame::after {
    bottom: -1px;
    right: -1px;
    width: 1.2rem;
    height: 1px;
  }
  .famen-mark {
    font-family: var(--font-zhuan);
    font-size: clamp(4rem, 9vw, 6.5rem);
    line-height: 1;
    color: transparent;
    /* 鎏金 (liquid gold) gradient fill, animated */
    background: linear-gradient(135deg,
      var(--gold-edge) 0%,
      var(--gold-bright) 18%,
      var(--gold) 35%,
      var(--gold-deep) 52%,
      var(--gold) 68%,
      var(--gold-bright) 85%,
      var(--gold-edge) 100%);
    background-size: 220% 220%;
    -webkit-background-clip: text;
    background-clip: text;
    animation: famen-font-flow 9s ease-in-out infinite;
    text-shadow: 0 0 28px var(--gold-glow);
    user-select: none;
  }
  @keyframes famen-font-flow {
    0%, 100% { background-position: 0% 50%; }
    50%      { background-position: 100% 50%; }
  }

  .famen-hero-text { min-width: 0; }

  /* 返回总览：小圆牌，压在眼圈之上 */
  .famen-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1.15rem;
    padding: 0.34em 0.95em;
    border: 1px solid var(--gold-line);
    border-radius: 999px;
    color: var(--bone-dim);
    font-size: 0.76rem;
    letter-spacing: 0.22em;
    text-decoration: none;
    transition: border-color 0.35s var(--ease-soft), color 0.35s var(--ease-soft), background 0.35s var(--ease-soft);
  }
  .famen-back-arrow {
    font-size: 0.9em;
    transition: transform 0.35s var(--ease-soft);
  }
  .famen-back:hover {
    border-color: var(--gold-line-strong);
    background: rgba(248, 220, 160, 0.08);
    color: var(--gold-edge);
  }
  .famen-back:hover .famen-back-arrow { transform: translateX(-3px); }

  .famen-eyebrow {
    font-size: 0.78rem;
    letter-spacing: 0.42em;
    color: var(--gold);
    margin: 0;
  }
  .famen-title {
    margin: 1rem 0 0;
    font-weight: 600;
    font-size: clamp(2.4rem, 6vw, 4rem);
    letter-spacing: 0.32em;
    line-height: 1.15;
    /* Liquid-gold gradient applied to the title text */
    color: transparent;
    background: linear-gradient(180deg,
      var(--gold-edge) 0%,
      var(--gold-bright) 22%,
      var(--gold) 50%,
      var(--gold-deep) 80%,
      var(--gold) 100%);
    background-size: 100% 220%;
    -webkit-background-clip: text;
    background-clip: text;
    animation: famen-title-flow 12s ease-in-out infinite;
    text-shadow: 0 0 22px var(--gold-glow);
  }
  @keyframes famen-title-flow {
    0%, 100% { background-position: 0% 0%; }
    50%      { background-position: 0% 100%; }
  }
  .famen-rule {
    height: 1px;
    width: 4.5rem;
    margin: 1.6rem 0 0;
    background: linear-gradient(90deg, var(--gold) 0%, transparent 100%);
  }
  .famen-sub {
    margin: 1.4rem 0 0;
    max-width: 38em;
    color: var(--bone-dim);
    font-size: 1rem;
    line-height: 2.2;
  }
  .famen-meta {
    margin: 1.2rem 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.32em;
    color: var(--bone-faint);
  }

  /* ============================================================
     六门门卡
     ============================================================ */

  .gates {
    position: relative;
    z-index: 1; /* ride above the fixed panorama */
    padding-block: clamp(2.5rem, 5vw, 4rem);
    /* 让正文落在实处，固定底图只作气氛 */
    background: linear-gradient(180deg,
      rgba(10, 6, 4, 0) 0%,
      rgba(10, 6, 4, 0.6) 9rem,
      rgba(10, 6, 4, 0.72) 100%);
  }

  .gate-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: clamp(1rem, 2vw, 1.6rem);
  }

  .gate {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    border: 1px solid var(--gold-line);
    border-radius: 4px;
    background: var(--panel-soft);
    overflow: hidden;
    isolation: isolate;
    transition: border-color 0.4s var(--ease-soft), transform 0.35s var(--ease-soft), box-shadow 0.4s var(--ease-soft);
  }

  .gate::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(120% 90% at 12% 8%, color-mix(in srgb, var(--c) 16%, transparent), transparent 60%);
    opacity: 0;
    transition: opacity 0.45s var(--ease-soft);
  }

  .gate:hover,
  .gate:focus-visible {
    border-color: color-mix(in srgb, var(--c) 62%, transparent);
    transform: translateY(-4px);
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.5), 0 0 0 1px color-mix(in srgb, var(--c) 26%, transparent) inset;
  }
  .gate:hover::before,
  .gate:focus-visible::before { opacity: 1; }

  .gate-glyph {
    align-self: flex-start;
    font-size: clamp(3.4rem, 7vw, 4.6rem);
    line-height: 0.78;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--c) 88%, var(--gold-bright));
    text-shadow: 0 0 26px color-mix(in srgb, var(--c) 26%, transparent);
    margin-bottom: 1.3rem;
    user-select: none;
  }

  .gate-body { flex: 1; }

  .gate-name {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 600;
    letter-spacing: 0.24em;
    color: var(--heading);
    text-shadow: 0 0 18px rgba(248, 220, 160, 0.16);
  }

  .gate-sub {
    margin-top: 0.6rem;
    color: color-mix(in srgb, var(--c) 74%, var(--gold-bright));
    font-family: var(--font-kai);
    font-size: 0.82rem;
    letter-spacing: 0.36em;
  }

  .gate-desc {
    margin-top: 1.1rem;
    color: var(--bone-dim);
    font-size: 0.92rem;
    line-height: 2;
  }

  /* 覆盖整卡的隐形主链接：点击卡片任意处进入该法门主页 */
  .gate-cover {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  /* ============================================================
     Mobile / reduced motion
     ============================================================ */

  @media (max-width: 720px) {
    .famen-hero { padding: 2.2rem 0 2.5rem; }
    .famen-hero-wrap {
      grid-template-columns: 1fr;
      gap: 1.6rem;
      justify-items: center;
      text-align: center;
    }
    .famen-mark-block {
      width: 7rem;
      height: 7rem;
    }
    .famen-rule { margin-inline: auto; }
    .famen-back { margin-bottom: 1rem; }
  }

  @media (max-width: 560px) {
    .gate-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .famen-grain { opacity: 0.32; }
    .famen-mark,
    .famen-title { animation: none; }
    .gate { transition: none; }
  }
</style>
