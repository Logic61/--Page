---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Inheritance from '../components/Inheritance.astro';
import HardToLearn from '../components/HardToLearn.astro';
import StudyPath from '../components/StudyPath.astro';
import Footer from '../components/Footer.astro';

const { title, description } = {
  title: '传承修习 · 背景与判断',
  description: '阅读传承叙述、修习条件与课程准备，建立清晰的了解顺序。',
};
---

<Base title={title} description={description}>
  <PageIntro
    mark="隐"
    title="传承与修习"
    sub="先了解传承脉络，再整理修习前应当阅读、判断与确认的事项。"
  />
  <Inheritance />
  <HardToLearn />
  <StudyPath />
  <Footer />
</Base>
