---
import BranchLayout from '../../layouts/BranchLayout.astro';
import BranchSteps from '../../components/BranchSteps.astro';
import PageIntro from '../../components/PageIntro.astro';
import Registration from '../../components/Registration.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const { title, description } = {
  title: '报名 · 愿者自来',
  description: '有意拜师学习者，请踏实工作生活，勿抱侥幸思想。愿者来，不强迫，不强求。',
};
---

<BranchLayout
  title={title}
  description={description}
  glyph="气"
  label="真气疗愈"
  accent="#7fa387"
  bg={`${base}/bg/zhenqi-jianliu.webp`}
  bgDim={0.08}
  courseHref="/zhenqi/jieshao"
  baomingHref="/zhenqi/baoming"
>
  <PageIntro
    mark="缘"
    title="愿者自来"
    titleEn="The Willing Come"
    sub="有意拜师学习者，请踏实工作生活，勿抱侥幸思想。愿者来，不强迫，不强求。请考虑清楚，再决定是否报名。"
    subEn="Those who wish to seek a master and learn: live and work steadily, and hold no thoughts of luck. Those who wish may come — no coercion, no persuasion. Think it through, then decide whether to enroll."
    meta="报名请谨慎考虑，一经报名，概不退款、不打折、不调价、不分期。"
    metaEn="Consider enrollment carefully. Once enrolled: no refunds, no discounts, no price changes, no installments."
  />
  <Registration />

  {/* 最后一页只给两个去处：返回法门目录 · 介绍 */}
  <BranchSteps />
</BranchLayout>
