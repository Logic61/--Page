---
import BranchLayout from '../../layouts/BranchLayout.astro';
import BranchPortal from '../../components/BranchPortal.astro';
import BranchSteps from '../../components/BranchSteps.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = '真气疗愈 · 外气疗愈';
const description = '外气疗愈机理之辨：真气外发、神气加持与心理暗示。';
---

<BranchLayout
  title={title}
  description={description}
  glyph="气"
  label="真气疗愈"
  accent="#7fa387"
  bgDim={0.08}
  bg={`${base}/bg/zhenqi-jianliu.webp`}
  courseHref="/zhenqi/jieshao"
  baomingHref="/zhenqi/baoming"
>
  <BranchPortal
    glyph="气"
    title="真气疗愈"
    subtitle="外气 · 神气 · 激发"
    description="外气疗愈机理之辨：真气外发、神气加持与心理暗示。"
  />

  {/* 第一页只给两个去处：介绍 · 报名 */}
  <BranchSteps />
</BranchLayout>
