---
import BranchLayout from '../../layouts/BranchLayout.astro';
import BranchPortal from '../../components/BranchPortal.astro';
import BranchSteps from '../../components/BranchSteps.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = '真气疗愈 · 外气疗愈';
const description = '真气外放，祛病驱邪，沟通自然';
---

<BranchLayout
  title={title}
  description={description}
  glyph="气"
  label="真气疗愈"
  accent="#7fa387"
  bgDim={0.08}
  bg={`${base}/bg/zhenqi-jianliu.webp`}
  courseHref="/zhenqi/jieshao"
  baomingHref="/zhenqi/baoming"
>
  <BranchPortal
    glyph="气"
    title="真气疗愈"
    titleEn="True-Qi Healing"
    subtitle="外气 · 神气 · 激发"
    subtitleEn="Outer Qi · Spirit-Qi · Quickening"
    description="真气外放，祛病驱邪，沟通自然"
    descriptionEn="True qi sent outward — dispelling illness, driving off malevolence, communing with nature."
  />

  {/* 第一页只给两个去处：介绍 · 报名 */}
  <BranchSteps />
</BranchLayout>
