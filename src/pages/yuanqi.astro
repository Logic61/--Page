---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Origin from '../components/Origin.astro';
import Macro from '../components/Macro.astro';
import Systems from '../components/Systems.astro';
import Footer from '../components/Footer.astro';

const { title, description } = {
  title: '认识巫祝 · 上古祝门',
  description: '从巫祝的源流叙述、历史流变到祭祀与巫医两大体系，建立基础认识。',
};
---

<Base title={title} description={description}>
  <PageIntro
    mark="祝"
    title="认识巫祝"
    sub="从祝之由来、历史流变到祭祀与巫医两大体系，建立完整的基础认识。"
  />
  <Origin />
  <Macro />
  <Systems />
  <Footer />
</Base>
