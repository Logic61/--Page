---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import knowledge from '../data/knowledge.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cats = knowledge.categories;
const catName = (id) => cats.find((c) => c.id === id)?.name || '';
const faqSet = new Set(knowledge.faqIds);
const groups = cats.map((c) => ({
  ...c,
  items: knowledge.items.filter((i) => i.category === c.id),
}));
const countOf = (id) => knowledge.items.filter((i) => i.category === id).length;
---

<Base title="修炼常识 · 上古祝门" description="按修炼基础、师承传承、修行境界、祝法养生、宗教神道等类别整理的上古祝门问答与修炼常识，支持全文检索。" hideNav={true}>
  <div class="changshi-scope">

    <a class="changshi-back" href={base + '/'}>
      <span class="changshi-back-arrow" aria-hidden="true">←</span>
      <span class="changshi-back-text kai">返回总目录</span>
    </a>

    <section class="changshi-hero" aria-labelledby="changshi-hero-title">
      <div class="changshi-grain" aria-hidden="true"></div>
      <div class="changshi-vignette" aria-hidden="true"></div>

      <div class="wrap changshi-hero-wrap">
        <div class="changshi-mark-block reveal">
          <span class="changshi-mark-frame" aria-hidden="true"></span>
          <span class="changshi-mark kai">常</span>
        </div>

        <div class="changshi-hero-text reveal" data-d="2">
          <p class="changshi-eyebrow kai">修 炼 常 识 · {cats.length} 类 {knowledge.items.length} 条</p>
          <h1 id="changshi-hero-title" class="changshi-title kai">修炼常识</h1>
          <div class="changshi-rule" aria-hidden="true"></div>
          <p class="changshi-sub">由「修炼基础认知」与「祝法与修行」两份问答整理而来，分门别类，可检索、可展开全文。</p>
          <p class="changshi-meta kai">修行、修炼理论内容，未经科学证实，切勿迷信</p>
        </div>
      </div>
    </section>

    <section class="kb" aria-labelledby="kb-title">
      <div class="wrap">

        <div class="kb-notice reveal">
          <b class="kai">敬告</b>
          <p>{knowledge.notice.split('\n').filter(Boolean).join('。')}</p>
        </div>

        <details class="kb-preface reveal" data-d="2">
          <summary class="kai">作者前言 <span class="kb-summary-hint">展开阅读</span></summary>
          <div class="kb-preface-body">
            {knowledge.preface.map((p) => <p>{p}</p>)}
          </div>
        </details>

        <div class="kb-toolbar reveal" data-d="3">
          <div class="kb-tabs" role="tablist" aria-label="修炼常识分类">
            <button class="k-tab active" data-tab="faq" role="tab">常见问题 <em>{knowledge.faqIds.length}</em></button>
            <button class="k-tab" data-tab="all" role="tab">全部 <em>{knowledge.items.length}</em></button>
            {
              cats.map((c) => (
                <button class="k-tab" data-tab={c.id} role="tab">{c.name} <em>{countOf(c.id)}</em></button>
              ))
            }
          </div>
          <div class="kb-search">
            <input id="kSearch" type="search" placeholder="在当前分类中搜索关键词…" autocomplete="off" aria-label="修炼常识搜索" />
            <span class="kb-count" id="kCount"></span>
          </div>
        </div>

        <div class="k-list" id="kList">
          {
            groups.map((g) => (
              <div class="k-group" data-cat={g.id}>
                <h3 class="k-group-title kai">{g.name}<span>{g.items.length} 条</span></h3>
                {
                  g.items.map((it) => (
                    <article class="k-item" id={'k-' + it.id} data-cat={it.category} data-faq={faqSet.has(it.id) ? '1' : '0'}>
                      <button class="k-q" type="button" aria-expanded="false" aria-controls={'k-a-' + it.id}>
                        <span class="k-q-body">
                          <b>{it.title}</b>
                          <i>{it.excerpt}</i>
                        </span>
                        <span class="k-chevron" aria-hidden="true">＋</span>
                      </button>
                      <div class="k-a" id={'k-a-' + it.id} hidden>
                        {
                          it.content.map((p) => {
                            const m = p.match(/^【(.+?)】$/);
                            if (m) return <p class="k-sub"><b>{m[1]}</b></p>;
                            return <p>{p}</p>;
                          })
                        }
                      </div>
                    </article>
                  ))
                }
              </div>
            ))
          }
        </div>

        <p class="kb-trailer kai reveal">依据《知识点》整理 · 修行理论内容，未经科学证实，切勿迷信</p>

      </div>
    </section>

    <Footer />
  </div>
</Base>

<style>
  /* ============================================================
     修炼常识 · 玄金之页
     Same black + gold tokens as miwen, scoped here. Uses
     `html[data-theme]` prefix so the override beats the global
     `html[data-theme='light']` rule in src/styles/global.css.
     ============================================================ */

  html[data-theme] .changshi-scope {
    --ink: #050402;
    --ink-2: #0a0805;
    --ink-3: #110d07;
    --ink-line: rgba(201, 169, 97, 0.14);
    --bone: #d8be7a;
    --bone-dim: #9c8654;
    --bone-faint: #5e4f30;

    --heading: #ecd28a;
    --gold: #c9a961;
    --gold-bright: #ecc879;
    --gold-deep: #8a6f2e;
    /* brightest highlight stop, used for liquid-gold gradient text */
    --gold-edge: #fff4cc;
    --gold-glow: rgba(236, 200, 121, 0.45);
    --gold-line: rgba(201, 169, 97, 0.22);
    --gold-line-strong: rgba(201, 169, 97, 0.5);

    --panel-soft: rgba(201, 169, 97, 0.04);

    background: var(--ink);
    color: var(--bone);
    position: relative;
  }

  /* ============================================================
     Back link + Hero
     ============================================================ */

  .changshi-back {
    position: fixed;
    top: 1.4rem;
    left: 1.4rem;
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--gold-line);
    border-radius: 2px;
    background: rgba(5, 4, 2, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--gold-bright);
    font-family: var(--font-kai);
    font-size: 0.84rem;
    letter-spacing: 0.28em;
    transition:
      border-color 0.3s var(--ease-soft),
      color 0.3s var(--ease-soft),
      transform 0.25s var(--ease-soft),
      background 0.3s var(--ease-soft);
  }
  .changshi-back:hover {
    border-color: var(--gold);
    color: #fff0c4;
    background: rgba(201, 169, 97, 0.08);
    transform: translateX(-2px);
  }
  .changshi-back-arrow {
    display: inline-block;
    color: var(--gold);
    transition: transform 0.3s var(--ease-soft), color 0.3s var(--ease-soft);
  }
  .changshi-back:hover .changshi-back-arrow {
    transform: translateX(-3px);
    color: var(--gold-bright);
  }

  .changshi-hero {
    position: relative;
    padding: clamp(5rem, 9vw, 7rem) 0 clamp(3rem, 6vw, 5rem);
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--gold-line);
  }
  .changshi-grain {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.45;
    background-image:
      radial-gradient(circle at 22% 28%, rgba(236, 200, 121, 0.08) 0%, transparent 38%),
      radial-gradient(circle at 82% 18%, rgba(201, 169, 97, 0.06) 0%, transparent 42%),
      radial-gradient(circle at 58% 82%, rgba(201, 169, 97, 0.04) 0%, transparent 50%);
    mix-blend-mode: screen;
  }
  .changshi-vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 80% at 50% 50%, transparent 35%, rgba(0, 0, 0, 0.65) 100%);
  }
  .changshi-hero-wrap {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .changshi-mark-block {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(8rem, 16vw, 12rem);
    height: clamp(8rem, 16vw, 12rem);
    flex: none;
  }
  .changshi-mark-frame {
    position: absolute;
    inset: 0;
    border: 1px solid var(--gold-line-strong);
    transform: rotate(45deg);
  }
  .changshi-mark-frame::before,
  .changshi-mark-frame::after {
    content: '';
    position: absolute;
    background: var(--gold);
  }
  .changshi-mark-frame::before {
    top: -1px;
    left: -1px;
    width: 1.2rem;
    height: 1px;
  }
  .changshi-mark-frame::after {
    bottom: -1px;
    right: -1px;
    width: 1.2rem;
    height: 1px;
  }
  .changshi-mark {
    font-family: var(--font-zhuan);
    font-size: clamp(4rem, 9vw, 6.5rem);
    line-height: 1;
    color: transparent;
    /* 鎏金 (liquid gold) gradient fill, animated */
    background: linear-gradient(135deg,
      var(--gold-edge) 0%,
      var(--gold-bright) 18%,
      var(--gold) 35%,
      var(--gold-deep) 52%,
      var(--gold) 68%,
      var(--gold-bright) 85%,
      var(--gold-edge) 100%);
    background-size: 220% 220%;
    -webkit-background-clip: text;
    background-clip: text;
    animation: changshi-font-flow 9s ease-in-out infinite;
    text-shadow: 0 0 28px var(--gold-glow);
    user-select: none;
  }
  @keyframes changshi-font-flow {
    0%, 100% { background-position: 0% 50%; }
    50%      { background-position: 100% 50%; }
  }

  .changshi-hero-text { min-width: 0; }
  .changshi-eyebrow {
    font-size: 0.78rem;
    letter-spacing: 0.42em;
    color: var(--gold);
    margin: 0;
  }
  .changshi-title {
    margin: 1rem 0 0;
    font-weight: 600;
    font-size: clamp(2.4rem, 6vw, 4rem);
    letter-spacing: 0.32em;
    line-height: 1.15;
    /* Liquid-gold gradient applied to the title text */
    color: transparent;
    background: linear-gradient(180deg,
      var(--gold-edge) 0%,
      var(--gold-bright) 22%,
      var(--gold) 50%,
      var(--gold-deep) 80%,
      var(--gold) 100%);
    background-size: 100% 220%;
    -webkit-background-clip: text;
    background-clip: text;
    animation: changshi-title-flow 12s ease-in-out infinite;
    text-shadow: 0 0 22px var(--gold-glow);
  }
  @keyframes changshi-title-flow {
    0%, 100% { background-position: 0% 0%; }
    50%      { background-position: 0% 100%; }
  }
  .changshi-rule {
    height: 1px;
    width: 4.5rem;
    margin: 1.6rem 0 0;
    background: linear-gradient(90deg, var(--gold) 0%, transparent 100%);
  }
  .changshi-sub {
    margin: 1.4rem 0 0;
    max-width: 38em;
    color: var(--bone-dim);
    font-size: 1rem;
    line-height: 2.2;
  }
  .changshi-meta {
    margin: 1.2rem 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.32em;
    color: var(--bone-faint);
  }

  /* ============================================================
     Knowledge base section
     ============================================================ */

  .kb { padding-block: clamp(2.5rem, 5vw, 4rem); }

  /* Notice: amber-gold instead of cinnabar */
  .kb-notice {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    padding: 1.1rem 1.4rem;
    border: 1px solid var(--gold-line-strong);
    border-left: 3px solid var(--gold-deep);
    background: linear-gradient(180deg, rgba(138, 111, 46, 0.08), rgba(5, 4, 2, 0.4));
    border-radius: 2px;
  }
  .kb-notice b {
    flex: none;
    color: #f4e7c1;
    background: var(--gold-deep);
    padding: 0.28em 0.55em;
    font-size: 0.82rem;
    letter-spacing: 0.32em;
    border-radius: 2px;
    transform: translateY(0.2em);
  }
  .kb-notice p { color: var(--bone-dim); font-size: 0.9rem; line-height: 2; }

  /* Preface (作者前言) */
  .kb-preface {
    margin-top: 1.4rem;
    border: 1px solid var(--gold-line);
    border-radius: 3px;
    background: var(--panel-soft);
  }
  .kb-preface summary {
    cursor: pointer;
    padding: 0.9rem 1.2rem;
    color: var(--heading);
    font-size: 1rem;
    letter-spacing: 0.24em;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    transition: color 0.3s var(--ease-soft);
  }
  .kb-preface summary::-webkit-details-marker { display: none; }
  .kb-preface summary:hover { color: var(--gold-bright); }
  .kb-summary-hint {
    color: var(--gold);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
  }
  .kb-preface-body { padding: 0.4rem 1.3rem 1.1rem; border-top: 1px solid var(--gold-line); }
  .kb-preface-body p { margin-top: 0.7rem; color: var(--bone-dim); font-size: 0.9rem; line-height: 2; }

  /* Toolbar */
  .kb-toolbar { margin-top: clamp(2.2rem, 4vw, 3rem); }
  .kb-tabs { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .k-tab {
    font-family: var(--font-kai);
    font-size: 0.92rem;
    letter-spacing: 0.12em;
    padding: 0.5em 1.05em;
    border: 1px solid var(--gold-line);
    border-radius: 999px;
    background: transparent;
    color: var(--bone-dim);
    cursor: pointer;
    transition: color 0.3s var(--ease-soft), border-color 0.3s var(--ease-soft), background 0.3s var(--ease-soft);
  }
  .k-tab em { font-style: normal; color: var(--bone-faint); font-size: 0.72em; margin-left: 0.3em; }
  .k-tab:hover {
    color: var(--gold-bright);
    border-color: var(--gold-line-strong);
    background: rgba(201, 169, 97, 0.04);
  }
  .k-tab.active {
    color: #050402;
    border-color: var(--gold);
    background: linear-gradient(180deg, rgba(236, 200, 121, 0.95), rgba(201, 169, 97, 0.95));
  }
  .k-tab.active em { color: rgba(5, 4, 2, 0.7); }

  .kb-search {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .kb-search input {
    flex: 1;
    max-width: 30rem;
    padding: 0.65em 1em;
    border: 1px solid var(--gold-line);
    border-radius: 3px;
    background: var(--panel-soft);
    color: var(--bone);
    font-family: var(--font-song);
    font-size: 0.92rem;
    outline: none;
    transition: border-color 0.3s var(--ease-soft);
  }
  .kb-search input:focus { border-color: var(--gold-line-strong); }
  .kb-search input::placeholder { color: var(--bone-faint); }
  .kb-count { color: var(--gold); font-size: 0.8rem; letter-spacing: 0.18em; white-space: nowrap; }

  /* Knowledge list */
  .k-list { margin-top: 1.4rem; border-top: 1px solid var(--gold-line); }

  .k-group { margin-bottom: 2.2rem; }
  .k-group-title {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin: 1.6rem 0 0.4rem;
    padding-left: 0.9rem;
    border-left: 3px solid var(--gold);
    color: var(--heading);
    font-size: clamp(1.25rem, 2.6vw, 1.6rem);
    letter-spacing: 0.24em;
  }
  .k-group-title span { color: var(--gold); font-size: 0.78rem; letter-spacing: 0.22em; }

  .k-item { border-bottom: 1px solid var(--gold-line); }
  .k-q {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1.1rem 0.8rem;
    background: transparent;
    border: 0;
    text-align: left;
    cursor: pointer;
    transition: background 0.3s var(--ease-soft), padding-left 0.3s var(--ease-soft);
  }
  .k-q:hover {
    background: var(--panel-soft);
    padding-left: 1.1rem;
  }
  .k-q-body { display: block; min-width: 0; }
  .k-q-body b {
    display: block;
    color: var(--heading);
    font-size: 1.04rem;
    letter-spacing: 0.08em;
    line-height: 1.7;
    transition: color 0.3s var(--ease-soft);
  }
  .k-q:hover .k-q-body b { color: var(--gold-bright); }
  .k-q-body i {
    display: block;
    margin-top: 0.3rem;
    color: var(--bone-faint);
    font-size: 0.84rem;
    font-style: normal;
    line-height: 1.8;
    overflow: hidden;
  }
  .k-chevron {
    color: var(--gold);
    font-size: 1.1rem;
    transition: transform 0.3s var(--ease-soft), color 0.3s var(--ease-soft);
  }
  .k-item.open .k-chevron {
    transform: rotate(45deg);
    color: var(--gold-bright);
  }
  .k-q:hover .k-chevron { color: var(--gold-bright); }

  .k-a { padding: 0.2rem 1rem 1.2rem; }
  .k-a p {
    margin-top: 0.7rem;
    color: var(--bone-dim);
    font-size: 0.94rem;
    line-height: 2.1;
    text-indent: 2em;
  }
  .k-a p.k-sub { text-indent: 0; margin-top: 1rem; }
  .k-a p.k-sub b {
    color: var(--gold-bright);
    font-size: 0.92rem;
    letter-spacing: 0.14em;
  }

  .kb-trailer {
    margin-top: 2.4rem;
    text-align: center;
    color: var(--bone-faint);
    font-size: 0.82rem;
    letter-spacing: 0.22em;
  }

  /* ============================================================
     Mobile collapse
     ============================================================ */

  @media (max-width: 720px) {
    .changshi-hero { padding: 5rem 0 2.5rem; }
    .changshi-hero-wrap {
      grid-template-columns: 1fr;
      gap: 1.6rem;
      justify-items: center;
      text-align: center;
    }
    .changshi-mark-block {
      width: 7rem;
      height: 7rem;
    }
    .changshi-rule { margin-inline: auto; }
  }

  @media (max-width: 600px) {
    .k-q { grid-template-columns: 1fr auto; gap: 0.6rem; padding: 0.9rem 0.4rem; }
    .k-a { padding-left: 0.4rem; }
    .kb-notice { flex-direction: column; gap: 0.5rem; }
  }

  @media (max-width: 560px) {
    .changshi-back {
      top: 0.9rem;
      left: 0.9rem;
      padding: 0.4rem 0.75rem;
      font-size: 0.78rem;
      letter-spacing: 0.22em;
    }
  }

  /* ============================================================
     Reduced motion
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {
    .changshi-grain { opacity: 0.32; }
    .changshi-mark,
    .changshi-title { animation: none; }
    .k-tab,
    .k-q,
    .k-q-body b,
    .k-chevron,
    .changshi-back,
    .changshi-back-arrow { transition: none; }
  }
</style>

<script>
  const items = Array.from(document.querySelectorAll('.k-item'));
  const groups = Array.from(document.querySelectorAll('.k-group'));
  const tabBtns = Array.from(document.querySelectorAll('.k-tab'));
  const searchInput = document.getElementById('kSearch');
  const countEl = document.getElementById('kCount');

  function apply() {
    const tab = document.querySelector('.k-tab.active').dataset.tab;
    const q = searchInput.value.trim();
    let visible = 0;
    groups.forEach((g) => {
      const head = g.querySelector('.k-group-title');
      let gShow = false;
      g.querySelectorAll('.k-item').forEach((it) => {
        const inCat = tab === 'all' || (tab === 'faq' ? it.dataset.faq === '1' : it.dataset.cat === tab);
        const inQ = !q || it.textContent.includes(q);
        const show = inCat && inQ;
        it.style.display = show ? '' : 'none';
        if (show) { gShow = true; visible++; }
      });
      g.style.display = gShow ? '' : 'none';
      g.style.marginBottom = tab === 'faq' ? '0' : '';
      if (head) head.style.display = !q && tab !== 'faq' && gShow ? '' : 'none';
    });
    countEl.textContent = visible ? '共 ' + visible + ' 条' : '';
  }

  tabBtns.forEach((b) => b.addEventListener('click', () => {
    tabBtns.forEach((x) => x.classList.toggle('active', x === b));
    apply();
  }));
  searchInput.addEventListener('input', apply);

  document.querySelectorAll('.k-q').forEach((btn) => btn.addEventListener('click', () => {
    const art = btn.closest('.k-item');
    const open = art.classList.toggle('open');
    const ans = art.querySelector('.k-a');
    ans.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
  }));

  function openHash() {
    const m = location.hash.match(/^#k-(.+)$/);
    if (!m) return;
    const el = document.getElementById('k-' + m[1]);
    if (!el) return;
    el.classList.add('open');
    const ans = el.querySelector('.k-a');
    ans.hidden = false;
    el.querySelector('.k-q').setAttribute('aria-expanded', 'true');
    setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'center' }), 80);
  }
  window.addEventListener('hashchange', openHash);
  openHash();
  apply();
</script>
</content>
</invoke>