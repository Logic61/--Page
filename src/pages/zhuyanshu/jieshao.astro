---
import BranchLayout from '../../layouts/BranchLayout.astro';
import BranchSteps from '../../components/BranchSteps.astro';
import GateIntro from '../../components/GateIntro.astro';
import Treatise from '../../components/Treatise.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = '驻颜术 · 法门介绍';

const description = '驻颜术法门介绍：以气血温养为本，驻容颜于岁月之中。循门而入，先识其门，再问其径。';

// 正文：源文件《驻颜术》全篇，由 .qa/gzh-gen.mjs 机械生成，逐字未改
const chapters = [
  {
    blocks: [
      { t: 'p', text: '古往今来，多少人追求容颜不老？却苦求无果？' },
      { t: 'p', text: '难道神奇的驻颜之法真的不存在么？及时到如今科技发达，也有无数存在前仆后继，各种延缓衰老的内容与研发。' },
      { t: 'p', text: '那么这个神奇的东西真的存在么？' },
      { t: 'p', text: '答:其实是存在的，但并非一般人所想的那边一直不变化衰老，而是延缓衰老，比同龄看起来更年轻，甚至十到二十几岁。' },
      { t: 'p', text: '应大众之所求，如今公开传法相关驻颜之术，有缘者可求。' },
      { t: 'p', text: '作用：' },
      {
        t: 'items',
        items: [
          '1：此术可以滋阴养颜，润泽、活化面部皮肤，延缓皮肤老化和体貌衰老。',
          '2：可使人气机通畅，耳目聪明，身轻体健，颜色年轻，头发不易变白。',
          '3：此术可以消解头部风邪，消解疲惫与气血衰败。可降火去燥，令人身体阴阳平衡，养生益寿。',
          '4;此术极有益于女性健康，男性锻炼同样有效。',
          '5:依法坚持锻炼一两月内可以明显见效，一年内身体可达到年轻数年状态，长期坚持，身体面貌最多可达到比实际年龄年轻十岁左右的程度。（二十几岁以下除外，二十几岁，只能做预防和延缓肌肤衰老。）',
        ],
      },
      { t: 'p', text: '除此之外还有形体美化等诸多秘传手诀等内容，具体请入相关群。公众号二维码：' },
    ],
  },
];
---

<BranchLayout
  title={title}
  description={description}
  glyph="颜"
  label="驻颜"
  accent="#b99752"
  bgDim={0.12}
  bg={`${base}/bg/zhuyanshu-meizhi.webp`}
  courseHref="/zhuyanshu/jieshao"
  baomingHref="/zhuyanshu/baoming"
>
  <GateIntro
    glyph="颜"
    name="驻颜术"
    subtitle="驻容 · 养容 · 生发"
  >
    <Treatise chapters={chapters} />

    {/* 二维码在正文之后、页底两个跳转之前 */}
    <section class="zhuyan-contact">
      <div class="contact-inner">
        <div class="contact-qr">
          <div class="qr-frame">
            <img src={`${base}/公众号二维码.jpg`} alt="公众号二维码" loading="lazy" />
          </div>
          <p>扫码关注 · 联系巫恒先生</p>
        </div>
      </div>
    </section>
  </GateIntro>

  {/* 中间页只给两个去处：上一页名字 · 下一页名字 */}
  <BranchSteps />
</BranchLayout>

<style>
  /* 二维码紧跟正文末行：global.css 给每个 <section> 带了 clamp(3rem,6vw,5.5rem)
     的上下内边距，正文末尾本身还有 86px 内边距 + 42px 外边距 + 96px 收尾，
     一并去掉，避免引子与二维码之间空出一大段。 */
  .zhuyan-contact {
    margin-top: 0;
    padding-block: 0;
  }
  :global(.gi-wrap > .treatise) { padding-bottom: 0; }
  :global(.gi-wrap > .treatise > .wrap > section:last-of-type) {
    margin-bottom: 0;
    padding-bottom: 1.4rem;
  }
  .contact-inner {
    max-width: 48em;
    margin-inline: auto;
    display: flex;
    justify-content: center;
  }
  .contact-qr { text-align: center; }
  .qr-frame {
    width: min(15rem, 60vw);
    padding: 0.6rem;
    border: 1px solid color-mix(in srgb, var(--branch-accent) 45%, transparent);
    border-radius: 3px;
    background: rgba(6, 10, 14, 0.6);
  }
  .qr-frame img { width: 100%; height: auto; display: block; border-radius: 2px; }
  .contact-qr p {
    margin-top: 0.8rem;
    color: #c2b7a4;
    font-size: 0.86rem;
    letter-spacing: 0.2em;
  }
  @media (max-width: 640px) {
    .contact-inner { justify-content: center; }
  }
</style>
