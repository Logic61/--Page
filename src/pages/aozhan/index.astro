---
import BranchLayout from '../../layouts/BranchLayout.astro';
import BranchPortal from '../../components/BranchPortal.astro';
import BranchSteps from '../../components/BranchSteps.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = '鏖战之法 · 丹基房中';
const description = '源自人元丹法筑基，交而不泄，养生配套。';
---

<BranchLayout
  title={title}
  description={description}
  glyph="战"
  label="鏖战之法"
  accent="#b8785e"
  bgDim={0.3}
  bg={`${base}/bg/aozhan-chiyan.webp`}
  courseHref="/aozhan/jieshao"
  baomingHref="/aozhan/baoming"
>
  <BranchPortal
    glyph="战"
    title="鏖战之法"
    titleEn="Aozhan — the Fierce Rite"
    subtitle="丹基 · 房中 · 养生"
    subtitleEn="Elixir Foundation · Bedchamber · Nourishing Life"
    description="源自人元丹法筑基，交而不泄，养生配套。"
    descriptionEn="Born of the human-primordial elixir practice: union without emission, with its supporting regimen for nourishing life."
  />

  {/* 第一页只给两个去处：介绍 · 报名 */}
  <BranchSteps />
</BranchLayout>
