---
// 法脉总览（首页）：主体是《分支图》本身——它就是首页的目录地图。
// 图层结构（稳定方案）：黑背景 → 完整明亮法阵(z0) → 树贴图(z1，真 alpha) → 热点(z3)。
// 树贴图用 分支图-final.png（1366×2049，自带 alpha：树体/牌匾不透明，背景透明）。
// 法阵保持高亮度鎏金，不做压暗处理。
import NineStarArray from '../components/ritual/NineStarArray.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 分支图-final 的四个牌匾位置（法门/修炼常识/秘闻/闲文，圆徽在牌匾正上方；
// 热区对准牌匾中心，恰好压在四个分支的字样上）。
// 坐标由 Python 在原图上扫描深色矩形 plaque 区域得到（dark connected regions
// with width/height ratio ≥ 1.5），避开了上方的圆形徽章。
const branches = [
  { name: '法门', route: '/famen', x: 19.40, y: 42.85, w: 22, h: 7 },
  { name: '修炼常识', route: '/zhoufa/zhishi', x: 80.82, y: 42.85, w: 22, h: 7 },
  { name: '秘闻', route: '/zhoufa/wenzhang', x: 19.33, y: 71.21, w: 22, h: 7 },
  { name: '闲文', route: '/xianwen', x: 80.67, y: 71.21, w: 22, h: 7 },
];
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="古巫祝脉一树四枝：法门、修炼常识、秘闻、闲文。循脉而入，可览上古祝门传承。" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>古巫祝脉 · 法脉总览</title>
  </head>
  <body>
    <div class="veil" aria-hidden="true"></div>

    <header class="top">
      <a class="brand kai" href={`${base}/`}>古巫祝脉</a>
      <a class="top-link kai" href={`${base}/zhoufa`}>进入祝门</a>
    </header>

    <main>
      <!-- 舞台：主体图在底层，法阵压在其上，圆环盖过图面左右展开 -->
      <div class="stage">
        <!-- 法阵 → 树融合层：金线由外向内消隐（不到海报边缘即化入黑），金尘粒子弥散在树与法阵之间 -->
        <svg class="vein-lines" viewBox="-700 -700 1400 1400" aria-hidden="true">
          <defs>
            <linearGradient id="rayR" gradientUnits="userSpaceOnUse" x1="340" y1="0" x2="560" y2="0">
              <stop offset="0" stop-color="#fce18c" stop-opacity="0" />
              <stop offset="0.72" stop-color="#fce18c" stop-opacity="0.16" />
              <stop offset="1" stop-color="#fce18c" stop-opacity="0.42" />
            </linearGradient>
            <linearGradient id="rayL" gradientUnits="userSpaceOnUse" x1="-340" y1="0" x2="-560" y2="0">
              <stop offset="0" stop-color="#fce18c" stop-opacity="0" />
              <stop offset="0.72" stop-color="#fce18c" stop-opacity="0.16" />
              <stop offset="1" stop-color="#fce18c" stop-opacity="0.42" />
            </linearGradient>
            <linearGradient id="rayB" gradientUnits="userSpaceOnUse" x1="0" y1="340" x2="0" y2="560">
              <stop offset="0" stop-color="#fce18c" stop-opacity="0" />
              <stop offset="0.72" stop-color="#fce18c" stop-opacity="0.16" />
              <stop offset="1" stop-color="#fce18c" stop-opacity="0.42" />
            </linearGradient>
            <linearGradient id="rayT" gradientUnits="userSpaceOnUse" x1="0" y1="-340" x2="0" y2="-560">
              <stop offset="0" stop-color="#fce18c" stop-opacity="0" />
              <stop offset="0.72" stop-color="#fce18c" stop-opacity="0.16" />
              <stop offset="1" stop-color="#fce18c" stop-opacity="0.42" />
            </linearGradient>
            <linearGradient id="rayNE" gradientUnits="userSpaceOnUse" x1="240.4" y1="-240.4" x2="396" y2="-396">
              <stop offset="0" stop-color="#fce18c" stop-opacity="0" />
              <stop offset="0.72" stop-color="#fce18c" stop-opacity="0.14" />
              <stop offset="1" stop-color="#fce18c" stop-opacity="0.34" />
            </linearGradient>
            <linearGradient id="raySE" gradientUnits="userSpaceOnUse" x1="240.4" y1="240.4" x2="396" y2="396">
              <stop offset="0" stop-color="#fce18c" stop-opacity="0" />
              <stop offset="0.72" stop-color="#fce18c" stop-opacity="0.14" />
              <stop offset="1" stop-color="#fce18c" stop-opacity="0.34" />
            </linearGradient>
            <linearGradient id="raySW" gradientUnits="userSpaceOnUse" x1="-240.4" y1="240.4" x2="-396" y2="396">
              <stop offset="0" stop-color="#fce18c" stop-opacity="0" />
              <stop offset="0.72" stop-color="#fce18c" stop-opacity="0.14" />
              <stop offset="1" stop-color="#fce18c" stop-opacity="0.34" />
            </linearGradient>
            <linearGradient id="rayNW" gradientUnits="userSpaceOnUse" x1="-240.4" y1="-240.4" x2="-396" y2="-396">
              <stop offset="0" stop-color="#fce18c" stop-opacity="0" />
              <stop offset="0.72" stop-color="#fce18c" stop-opacity="0.14" />
              <stop offset="1" stop-color="#fce18c" stop-opacity="0.34" />
            </linearGradient>
          </defs>
          <g fill="none" stroke-width="1.4" stroke-linecap="round">
            <line x1="340" y1="0" x2="560" y2="0" stroke="url(#rayR)" />
            <line x1="-340" y1="0" x2="-560" y2="0" stroke="url(#rayL)" />
            <line x1="0" y1="340" x2="0" y2="560" stroke="url(#rayB)" />
            <line x1="0" y1="-340" x2="0" y2="-560" stroke="url(#rayT)" />
            <line x1="240.4" y1="-240.4" x2="396" y2="-396" stroke="url(#rayNE)" />
            <line x1="240.4" y1="240.4" x2="396" y2="396" stroke="url(#raySE)" />
            <line x1="-240.4" y1="240.4" x2="-396" y2="396" stroke="url(#raySW)" />
            <line x1="-240.4" y1="-240.4" x2="-396" y2="-396" stroke="url(#rayNW)" />
          </g>
          <!-- 根脉牵引：沿树枝方向只在法阵外缘显形，让金线像从树梢生出 -->
          <g class="root-weave" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M-286-92 C-354-118 -406-154 -470-212 C-514-252 -548-276 -590-286" />
            <path d="M286-96 C352-116 410-148 472-204 C520-248 553-270 598-282" />
            <path d="M-264 142 C-334 164 -396 204 -452 260 C-492 300 -532 322 -576 330" />
            <path d="M264 144 C334 164 394 202 452 258 C494 298 530 320 576 330" />
            <path d="M-88-300 C-108-360 -132-410 -166-470 C-186-504 -198-536 -202-574" />
            <path d="M94-300 C112-360 136-410 170-468 C190-504 202-536 204-574" />
          </g>
          <!-- 金尘：弥散在树与法阵之间的细碎粒子 -->
          <g fill="#fce18c">
            <circle cx="327" cy="-46" r="1.6" opacity="0.5" />
            <circle cx="347" cy="14" r="1.2" opacity="0.4" />
            <circle cx="377" cy="-26" r="2.1" opacity="0.35" />
            <circle cx="317" cy="44" r="1.3" opacity="0.45" />
            <circle cx="-362" cy="14" r="1.7" opacity="0.5" />
            <circle cx="-332" cy="-46" r="1.2" opacity="0.4" />
            <circle cx="-372" cy="74" r="2.2" opacity="0.3" />
            <circle cx="-322" cy="34" r="1.4" opacity="0.45" />
            <circle cx="-52" cy="-446" r="1.8" opacity="0.45" />
            <circle cx="27" cy="-466" r="1.2" opacity="0.35" />
            <circle cx="-102" cy="-436" r="2.4" opacity="0.28" />
            <circle cx="-62" cy="444" r="1.9" opacity="0.45" />
            <circle cx="17" cy="464" r="1.3" opacity="0.35" />
            <circle cx="87" cy="444" r="2.3" opacity="0.3" />
            <circle cx="-372" cy="464" r="1.5" opacity="0.4" />
            <circle cx="-352" cy="434" r="1.1" opacity="0.5" />
            <circle cx="327" cy="-446" r="1.6" opacity="0.45" />
            <circle cx="367" cy="-466" r="1.2" opacity="0.35" />
            <circle cx="-372" cy="-446" r="2.0" opacity="0.3" />
            <circle cx="347" cy="444" r="1.5" opacity="0.4" />
            <circle cx="367" cy="464" r="1.1" opacity="0.5" />
            <circle cx="327" cy="434" r="1.9" opacity="0.32" />
            <circle cx="480" cy="-80" r="1.4" opacity="0.4" />
            <circle cx="-480" cy="100" r="1.6" opacity="0.35" />
            <circle cx="60" cy="520" r="1.3" opacity="0.4" />
            <circle cx="-60" cy="-520" r="1.5" opacity="0.38" />
            <!-- 贴近海报边缘的柔金尘：连接主体与法阵 -->
            <circle cx="352" cy="-92" r="2.6" opacity="0.2" />
            <circle cx="346" cy="118" r="3" opacity="0.16" />
            <circle cx="-350" cy="104" r="2.8" opacity="0.18" />
            <circle cx="-344" cy="-128" r="2.4" opacity="0.2" />
            <circle cx="64" cy="-352" r="2.7" opacity="0.18" />
            <circle cx="-88" cy="356" r="2.5" opacity="0.2" />
            <circle cx="262" cy="-258" r="2.2" opacity="0.18" />
            <circle cx="-268" cy="246" r="2.5" opacity="0.16" />
            <!-- 小亮星：海报羽化边上的残痕金点 -->
            <circle cx="338" cy="42" r="1" opacity="0.6" />
            <circle cx="-336" cy="-66" r="0.9" opacity="0.55" />
            <circle cx="22" cy="-340" r="1" opacity="0.5" />
            <circle cx="-38" cy="342" r="1.1" opacity="0.55" />
            <circle cx="240" cy="242" r="0.9" opacity="0.45" />
            <circle cx="-236" cy="-238" r="1" opacity="0.45" />
          </g>
        </svg>

        <div class="map-frame">
          <!-- 法阵：完整显示，位于树的下层（z0 < z1），保持鎏金亮度不压暗 -->
          <div class="array-layer" aria-hidden="true">
            <NineStarArray structureDim={0} />
          </div>
          <!-- 树贴图（真 alpha 版）：树体遮挡阵纹，四处节点圆盘镂空透阵 -->
          <img class="map-img" src={`${base}/分支图-final.png`} alt="古巫祝脉分支图：法门、修炼常识、秘闻、闲文" loading="eager" />
          {branches.map((b) => (
            <a
              class="map-hotspot"
              href={`${base}${b.route}`}
              aria-label={`进入${b.name}`}
              data-name={b.name}
              style={`left:${b.x}%; top:${b.y}%; width:${b.w}%; --hs-h:${b.h}%;`}
            >
              <span class="hotspot-ring" aria-hidden="true"></span>
              {b.name === '法门' && (
                <img
                  class="hotspot-rune"
                  src={`${base}/leiwen/17-gold.png`}
                  alt=""
                  aria-hidden="true"
                />
              )}
            </a>
          ))}
        </div>
      </div>
    </main>

    <footer class="foot kai">诸枝同源 · 各有所传</footer>

    <script is:inline>
      // 中低端设备兜底：首屏采样帧率，低于阈值则冻结旋转/流光动画。
      // 注意：必须等 load（雷纹/巫字图解码完毕）后再测量，否则图片解码
      // 占住主线程会误判低帧率，导致法阵一进页就被冻住不转。
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        function measure() {
          var frames = 0, start = performance.now(), sum = 0, last = start;
          function tick(t) {
            var dt = t - last; last = t; sum += dt; frames++;
            if (t - start < 3000) { requestAnimationFrame(tick); return; }
            var fps = 1000 / (sum / frames);
            if (fps < 15) document.documentElement.classList.add('low-perf');
          }
          requestAnimationFrame(tick);
        }
        if (document.readyState === 'complete') measure();
        else window.addEventListener('load', measure, { once: true });
      })();
    </script>
  </body>
</html>

<style>
  :root {
    --gold: #d19b2b;
    --gold-bright: #fce18c;
    --gold-line: #fce18c;
    --gold-hi: #ffe08a;
    --gold-dim: #9a7020;
    --ink: #d9d2c2;
    --ink-faint: #6b5730;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    overflow-x: hidden;
    overflow-x: clip;
  }

  body {
    min-height: 100dvh;
    padding-top: clamp(2rem, 5vw, 4.5rem);
    background:
      radial-gradient(ellipse 72% 56% at 50% 45%, rgba(189, 148, 64, 0.08), transparent 72%),
      #030303;
    color: var(--ink);
    font-family: "Songti SC", "STSong", "SimSun", "Noto Serif SC", serif;
    -webkit-font-smoothing: antialiased;
  }

  .kai { font-family: "Kaiti SC", "STKaiti", "KaiTi", serif; }

  .veil {
    position: fixed;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 48% at 50% 46%, rgba(189, 148, 64, 0.06), transparent 72%),
      linear-gradient(90deg, rgba(0,0,0,.38), transparent 12%, transparent 88%, rgba(0,0,0,.38));
  }

  .top {
    position: relative;
    z-index: 6;
    width: 100%;
    padding: 1.1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(201, 165, 94, 0.26);
  }

  .brand, .top-link {
    color: #d9b96a;
    font-size: 0.9rem;
    letter-spacing: 0.32em;
    text-decoration: none;
    transition: color 0.25s;
  }
  .brand:hover, .top-link:hover { color: #f6e9bd; }
  .top-link { justify-self: end; }

  main {
    position: relative;
    z-index: 2;
    padding-bottom: 1.5rem;
  }

  /* ---- 舞台：法阵层 + 主体图。整体下移使法阵顶露出，且法阵与海报中心保持对齐（transform 平移不破坏两者同心） ---- */
  .stage {
    position: relative;
    display: flex;
    justify-content: center;
    padding-bottom: clamp(1rem, 3vw, 2.5rem);
    transform: translateY(clamp(3rem, 12vh, 8rem));
  }

  /* 法阵 → 树融合层：径向金线由外向内消隐于海报边缘之前，金尘弥散，焊接法阵与主体 */
  .vein-lines {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 1400px;
    height: 1400px;
    z-index: 1;
    pointer-events: none;
    opacity: 0.85;
  }
  .vein-lines line {
    stroke-linecap: round;
  }
  .vein-lines .root-weave {
    stroke: rgba(252, 225, 140, 0.34);
    stroke-width: 2.2;
    stroke-dasharray: 2 14 26 11;
    filter: drop-shadow(0 0 5px rgba(229, 174, 59, 0.5));
    opacity: 0.7;
    animation: rootPulse 9s ease-in-out infinite;
  }
  @keyframes rootPulse {
    0%, 100% { opacity: 0.38; stroke-dashoffset: 0; }
    50% { opacity: 0.82; stroke-dashoffset: -34; }
  }

  /* 大法阵：完整明亮的第二视觉主体——鎏金主体线条，轻微外发光，不压暗。
     位于树的下层（z0 < 树 z1），中心不再挖静区：树体自然遮挡中心部分 */
  .array-layer {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(165%, 1340px);
    aspect-ratio: 1 / 1;
    z-index: 0;
    /* 整体不再压暗：压暗已移入阵内结构层 .array-body（NineStarArray），
       符文环不受压暗，保持与中心树一致的亮度 */
    opacity: 1;
    filter: drop-shadow(0 0 4px rgba(255, 220, 120, 0.28)) drop-shadow(0 0 10px rgba(190, 140, 45, 0.2));
    pointer-events: none;
  }

  .map-frame {
    position: relative;
    z-index: 2;
    /* 分支图-final 为竖幅（1366×2049，≈ 2:3），收窄容器控制整页高度 */
    width: min(100% - 1.5rem, 70vw, 860px);
  }

  /* 法阵中心背光：从树背后透出的暗金径向光，把树主体托出法阵 */
  .map-frame::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 55%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background:
      radial-gradient(
        circle,
        rgba(214, 169, 67, 0.12) 0%,
        rgba(214, 169, 67, 0.055) 35%,
        rgba(214, 169, 67, 0.02) 58%,
        transparent 75%
      );
    filter: blur(15px);
    z-index: 0;
    pointer-events: none;
  }

  /* 主体边缘金尘/烟雾：一圈贴着海报轮廓的金色薄雾，把羽化边焊进法阵 */
  .map-frame::after {
    content: "";
    position: absolute;
    inset: -4%;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(ellipse 15% 10% at 28% 42%, rgba(249, 207, 111, 0.19), transparent 74%),
      radial-gradient(ellipse 16% 10% at 73% 41%, rgba(249, 207, 111, 0.19), transparent 74%),
      radial-gradient(ellipse 15% 11% at 20% 64%, rgba(249, 207, 111, 0.15), transparent 74%),
      radial-gradient(ellipse 16% 11% at 73% 63%, rgba(249, 207, 111, 0.15), transparent 74%),
      radial-gradient(ellipse closest-side at 50% 50%, transparent 58%, rgba(214, 158, 45, 0.09) 76%, rgba(120, 88, 30, 0.05) 88%, transparent 99%);
    filter: blur(13px);
    mix-blend-mode: screen;
    opacity: 0.9;
  }

  /* 主体图（树）：真 alpha 贴图，位于法阵上层（z1 > 阵 z0）。
     与法阵严格同 filter 链：sepia(0.4) 把树源图里偏冷黄的高光压成琥珀棕，
     saturate 1.0 不再放大黄度；hue-rotate(0deg) 维持天然暖色调；
     brightness 0.88 比法阵 0.82 略高保留主体性。 */
  .map-img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    filter:
      sepia(0.4) hue-rotate(0deg) saturate(1.0) brightness(0.88) contrast(1.05)
      drop-shadow(0 0 2px rgba(255, 220, 120, 0.3))
      drop-shadow(0 0 6px rgba(190, 140, 45, 0.16));
    /* 边框淡化融入背景：四周羽化（贴图暗底已透明，此处只收残留纹理边缘） */
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, #000 15%, #000 85%, transparent 100%),
      linear-gradient(180deg, transparent 0%, #000 11%, #000 88%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 15%, #000 85%, transparent 100%),
      linear-gradient(180deg, transparent 0%, #000 11%, #000 88%, transparent 100%);
    mask-composite: intersect;
  }

  /* ---- 图上透明热区：真正的交互节点 ---- */
  .map-hotspot {
    position: absolute;
    height: var(--hs-h, 10%);
    transform: translate(-50%, -50%);
    border-radius: 14px;
    z-index: 3;
    outline: none;
    cursor: pointer;
  }

  .hotspot-ring {
    position: absolute;
    inset: 6%;
    border: 1px solid rgba(240, 222, 170, 0.45);
    border-radius: 50%;
    opacity: 0.55;
    animation: hsBreath 3.6s ease-in-out infinite;
    transition: border-color 0.25s, box-shadow 0.25s, background 0.25s, transform 0.25s, opacity 0.25s;
  }

  @keyframes hsBreath {
    0%, 100% { box-shadow: 0 0 8px rgba(236, 217, 164, 0.12), inset 0 0 10px rgba(236, 217, 164, 0.08); }
    50% { box-shadow: 0 0 20px rgba(236, 217, 164, 0.3), inset 0 0 16px rgba(236, 217, 164, 0.16); }
  }

  .map-hotspot:hover .hotspot-ring,
  .map-hotspot:focus-visible .hotspot-ring {
    animation: none;
    opacity: 1;
    border-color: rgba(240, 217, 160, 0.9);
    background: rgba(231, 211, 154, 0.1);
    box-shadow: 0 0 26px rgba(231, 211, 154, 0.45), inset 0 0 18px rgba(231, 211, 154, 0.25);
    transform: scale(1.07);
  }

  /* hover 显示分支名小签 */
  .map-hotspot::after {
    content: attr(data-name);
    position: absolute;
    left: 50%;
    top: calc(100% + 6px);
    transform: translateX(-50%);
    padding: 0.28em 0.8em;
    white-space: nowrap;
    color: #f0e3c8;
    background: rgba(10, 7, 3, 0.88);
    border: 1px solid rgba(189, 148, 64, 0.5);
    font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
    z-index: 7;
  }
  .map-hotspot:hover::after,
  .map-hotspot:focus-visible::after { opacity: 1; }

  /* 第一分支（法门）牌匾中心黑洞：叠一张雷纹图源填补
     hotspot 容器宽 22%（法门牌匾宽），高按 --hs-h=7% 撑开
