---
// 驻颜术 —— 独立临时页：自包含布局与样式，不依赖任何其它页面组件。
import FlowRibbons from '../components/FlowRibbons.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="驻颜术：上古祝门五脉之一，驻颜养容、生发驻春，此支内容尚在整理。" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>驻颜术 · 上古祝门</title>
  </head>
  <body>
    <div class="ribbons" aria-hidden="true"><FlowRibbons /></div>
    <div class="aura" aria-hidden="true"></div>

    <header class="top">
      <a class="back" href={`${base}/four-veins`}>← 返回法脉总览</a>
      <span class="top-name">上古祝门 · 五脉之一</span>
    </header>

    <main>
      <section class="hero">
        <span class="glyph" aria-hidden="true">颜</span>
        <p class="kicker">一脉一门 · 驻颜养容</p>
        <h1>驻颜术</h1>
        <p class="sub">驻颜 · 养容 · 生发</p>
      </section>

      <section class="body-copy">
        <p class="label">分脉提要</p>
        <p>驻颜一脉，以气血温养为本，驻容颜于岁月之中，养容仪于日常之间。此支内容尚在整理，后续篇章将在此展开。</p>
      </section>

      <aside class="soon">
        <span class="soon-mark" aria-hidden="true"></span>
        <p>此支法脉，篇幅尚待开示。</p>
      </aside>
    </main>

    <footer class="foot">五脉同源 · 各有所传</footer>
  </body>
</html>

<style>
  :root {
    --gold: #b99752;
    --gold-bright: #e7d39a;
    --gold-dim: #66502a;
    --ink: #d9d2c2;
    --ink-faint: #6b5730;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(ellipse 58% 42% at 50% 30%, rgba(185, 151, 82, 0.1), transparent 70%),
      linear-gradient(180deg, #0a0806 0%, #050505 55%, #0b0a08 100%);
    color: var(--ink);
    font-family: "Songti SC", "STSong", "SimSun", "Noto Serif SC", serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    isolation: isolate;
  }

  .ribbons {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .aura {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      repeating-linear-gradient(90deg, transparent 0 7rem, rgba(185, 151, 82, 0.05) 7rem 7.06rem),
      repeating-linear-gradient(0deg, transparent 0 7rem, rgba(185, 151, 82, 0.035) 7rem 7.06rem);
  }

  .top {
    width: min(100% - 3rem, 72rem);
    min-height: 4.8rem;
    margin-inline: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(185, 151, 82, 0.18);
  }

  .back, .top-name {
    font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
    font-size: 0.85rem;
    letter-spacing: 0.26em;
  }
  .back { color: var(--gold-bright); text-decoration: none; transition: color 0.25s; }
  .back:hover { color: #fff3db; }
  .top-name { color: var(--ink-faint); }

  main {
    flex: 1;
    width: min(100% - 3rem, 52rem);
    margin-inline: auto;
    padding: clamp(4rem, 10vw, 8rem) 0 clamp(4rem, 8vw, 7rem);
  }

  .hero {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: clamp(1.4rem, 4vw, 3rem);
    align-items: end;
    padding-bottom: clamp(2.6rem, 5vw, 4rem);
    border-bottom: 1px solid rgba(185, 151, 82, 0.16);
  }

  .glyph {
    grid-row: 1 / span 3;
    color: transparent;
    -webkit-text-stroke: 1px var(--gold);
    font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
    font-size: clamp(6rem, 15vw, 11rem);
    line-height: 0.72;
    text-shadow: 0 0 34px rgba(185, 151, 82, 0.18);
  }

  .kicker, .label {
    color: var(--gold);
    font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
    font-size: 0.76rem;
    letter-spacing: 0.5em;
  }

  h1 {
    margin-top: 0.5rem;
    background: linear-gradient(180deg, #fff1a8 0%, #d8b45a 25%, #a67c2f 55%, #f3d77a 75%, #8a6425 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.26em;
  }

  .sub {
    margin-top: 0.8rem;
    color: #938a76;
    font-size: 0.85rem;
    letter-spacing: 0.28em;
  }

  .body-copy {
    width: min(100%, 44rem);
    margin: clamp(2.8rem, 6vw, 4.5rem) 0 0 auto;
  }
  .body-copy > p:last-child {
    margin-top: 1rem;
    color: #c1b8a7;
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 2.25;
  }

  .soon {
    display: flex;
    gap: 1rem;
    width: min(100%, 44rem);
    margin: clamp(2.4rem, 5vw, 4rem) 0 0 auto;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(185, 151, 82, 0.18);
    color: #847b68;
    font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
    font-size: 0.88rem;
    letter-spacing: 0.24em;
  }
  .soon-mark {
    width: 0.48rem;
    height: 0.48rem;
    flex: none;
    margin-top: 0.5rem;
    border: 1px solid var(--gold);
    transform: rotate(45deg);
  }

  .foot {
    padding: 1.6rem 0 2.2rem;
    border-top: 1px solid rgba(185, 151, 82, 0.12);
    color: var(--ink-faint);
    text-align: center;
    font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
    font-size: 0.72rem;
    letter-spacing: 0.4em;
  }

  @media (max-width: 640px) {
    .top { width: min(100% - 2.2rem, 72rem); }
    main { width: min(100% - 2.2rem, 52rem); }
    .hero { column-gap: 1rem; align-items: center; }
    .glyph { font-size: 5.4rem; }
    .top-name { display: none; }
    .sub { letter-spacing: 0.16em; }
  }
</style>
