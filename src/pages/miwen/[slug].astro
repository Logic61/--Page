---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nums = ['一', '二', '三', '四', '五', '六', '七', '八', '九', '十', '十一'];

export async function getStaticPaths() {
  const modules = import.meta.glob('../../../巫/*.md', { eager: true });
  const all = Object.entries(modules)
    .map(([path, mod]) => ({
      params: { slug: mod.frontmatter.slug },
      props: {
        mod,
        order: mod.frontmatter.order,
        title: mod.frontmatter.title,
        summary: mod.frontmatter.summary,
      },
    }))
    .sort((a, b) => a.props.order - b.props.order);

  return all.map((entry, i) => ({
    ...entry,
    props: {
      ...entry.props,
      prev: i > 0 ? { slug: all[i - 1].params.slug, title: all[i - 1].props.title } : null,
      next: i < all.length - 1 ? { slug: all[i + 1].params.slug, title: all[i + 1].props.title } : null,
    },
  }));
}

const { mod, order, title, summary, prev, next } = Astro.props;
const { Content } = mod;
---

<Base title={title + ' · 秘闻 · 上古祝门'} description={summary}>
  <article class="post" aria-labelledby="post-title">
    <div class="wrap">

      <header class="post-head reveal">
        <p class="post-series kai">系列《神机秘闻》 · 第 {order} 篇</p>
        <h1 id="post-title" class="kai">{title}</h1>
        <div class="post-rule"></div>
        <p class="post-summary">{summary}</p>
      </header>

      <aside class="post-notice reveal" data-d="2">
        <b class="kai">敬告</b>
        <p>本文内容纯属虚构，如有雷同，纯属雷同。公众版相较内群版删减大量内容，以□代替；请理性阅读，不要沉浸其中，不要尝试文中内容。</p>
      </aside>

      <div class="prose reveal">
        <Content />
      </div>

      <nav class="post-nav reveal" aria-label="秘闻导航">
        {
          prev ? (
            <a class="post-pager" href={base + '/miwen/' + prev.slug}>
              <span class="pager-label">上一篇</span>
              <span class="pager-title kai">{prev.title}</span>
            </a>
          ) : <span class="post-pager is-empty"><span class="pager-label">上一篇</span><span class="pager-title kai">已是首篇</span></span>
        }
        <a class="post-back btn" href={base + '/miwen'}>返回秘闻列表</a>
        {
          next ? (
            <a class="post-pager is-next" href={base + '/miwen/' + next.slug}>
              <span class="pager-label">下一篇</span>
              <span class="pager-title kai">{next.title}</span>
            </a>
          ) : <span class="post-pager is-next is-empty"><span class="pager-label">下一篇</span><span class="pager-title kai">已是末篇</span></span>
        }
      </nav>

    </div>
  </article>

  <Footer />
</Base>

<style>
  .post { border-top: 1px solid var(--ink-line); padding-bottom: clamp(2rem, 4vw, 3rem); }

  .post-head {
    max-width: 46em;
    margin-inline: auto;
    padding-top: clamp(2.2rem, 5vw, 4rem);
  }
  .post-series {
    color: var(--bronze);
    font-size: 0.84rem;
    letter-spacing: 0.3em;
  }
  .post-head h1 {
    margin-top: 1rem;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: 0.24em;
    color: var(--heading);
  }
  .post-rule {
    height: 1px;
    width: 4.5rem;
    margin-top: 1.4rem;
    background: linear-gradient(90deg, var(--cinnabar), transparent);
  }
  .post-summary {
    margin-top: 1.2rem;
    max-width: 44em;
    color: var(--bone-dim);
    font-size: 0.94rem;
    line-height: 2.05;
  }

  .post-notice {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    max-width: 46em;
    margin: 2rem auto;
    padding: 1.05rem 1.3rem;
    border: 1px solid var(--ink-line);
    border-left: 3px solid var(--cinnabar);
    background: var(--panel-soft);
    border-radius: 2px;
  }
  .post-notice b {
    flex: none;
    color: #f2dfc4;
    background: var(--cinnabar);
    padding: 0.28em 0.55em;
    font-size: 0.82rem;
    letter-spacing: 0.3em;
    border-radius: 2px;
    transform: translateY(0.2em);
  }
  .post-notice p { color: var(--bone-dim); font-size: 0.88rem; line-height: 2; }

  .prose { max-width: 46em; margin-inline: auto; padding-bottom: 2rem; }
  .prose :global(p) {
    margin: 0;
    padding: 0;
    color: var(--bone-dim);
    font-size: 0.96rem;
    line-height: 2.15;
    text-indent: 2em;
    overflow-wrap: anywhere;
  }
  .prose :global(p + p) { margin-top: 0.85em; }
  .prose :global(p:first-child) { text-indent: 0; }
  .prose :global(strong), .prose :global(b) { color: var(--bronze-bright); font-weight: 600; }
  .prose :global(em) { color: var(--cinnabar-bright); font-style: normal; }
  .prose :global(blockquote) {
    margin: 1.2rem 0;
    padding: 0.8rem 1.2rem;
    border-left: 2px solid var(--bronze-dim);
    background: var(--panel-soft);
    color: var(--bone-faint);
    font-size: 0.9rem;
    line-height: 2;
  }
  .prose :global(ol), .prose :global(ul) { margin: 0.9rem 0; padding-left: 1.6em; color: var(--bone-dim); font-size: 0.94rem; line-height: 2.1; }
  .prose :global(li) { margin: 0.3rem 0; }
  .prose :global(h2), .prose :global(h3), .prose :global(h4) {
    margin: 1.8rem 0 0.8rem;
    color: var(--heading);
    font-family: var(--font-kai);
    letter-spacing: 0.18em;
  }
  .prose :global(h2) { font-size: 1.5rem; }
  .prose :global(h3) { font-size: 1.25rem; }
  .prose :global(h4) { font-size: 1.1rem; color: var(--bronze-bright); }
  .prose :global(hr) { margin: 2rem 0; border: 0; border-top: 1px solid var(--ink-line); }
  .prose :global(code) {
    padding: 0.1em 0.4em;
    border: 1px solid var(--ink-line);
    border-radius: 2px;
    background: var(--panel-soft);
    color: var(--bronze-bright);
    font-size: 0.88em;
  }
  .prose :global(a) { color: var(--bronze-bright); text-decoration: underline; text-underline-offset: 3px; }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.2rem;
    align-items: stretch;
    max-width: 46em;
    margin: 1.5rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid var(--ink-line);
  }
  .post-pager {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--ink-line);
    border-radius: 3px;
    background: var(--panel-soft);
    transition: border-color 0.3s var(--ease-soft), transform 0.2s var(--ease-soft);
  }
  .post-pager:hover { border-color: var(--bronze-dim); transform: translateY(-2px); }
  .post-pager.is-next { text-align: right; }
  .post-pager.is-empty { opacity: 0.55; pointer-events: none; }
  .pager-label { color: var(--bone-faint); font-size: 0.74rem; letter-spacing: 0.24em; }
  .pager-title { color: var(--heading); font-size: 1.02rem; letter-spacing: 0.12em; }
  .post-back { align-self: center; white-space: nowrap; }

  @media (max-width: 720px) {
    .post-nav { grid-template-columns: 1fr; }
    .post-back { justify-self: start; }
    .post-pager.is-next { text-align: left; }
  }
</style>
