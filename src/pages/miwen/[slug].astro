---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nums = ['一', '二', '三', '四', '五', '六', '七', '八', '九', '十', '十一'];

export async function getStaticPaths() {
  const modules = import.meta.glob('../../../巫/*.md', { eager: true });
  const all = Object.entries(modules)
    .map(([path, mod]) => ({
      params: { slug: mod.frontmatter.slug },
      props: {
        mod,
        order: mod.frontmatter.order,
        title: mod.frontmatter.title,
        summary: mod.frontmatter.summary,
      },
    }))
    .sort((a, b) => a.props.order - b.props.order);

  return all.map((entry, i) => ({
    ...entry,
    props: {
      ...entry.props,
      prev: i > 0 ? { slug: all[i - 1].params.slug, title: all[i - 1].props.title } : null,
      next: i < all.length - 1 ? { slug: all[i + 1].params.slug, title: all[i + 1].props.title } : null,
    },
  }));
}

const { mod, order, title, summary, prev, next } = Astro.props;
const { Content } = mod;
const num = nums[order - 1] || String(order);
---

<Base title={title + ' · 秘闻 · 上古祝门'} description={summary} hideNav={true}>
  <div class="miwen-scope">

    <a class="miwen-back" href={base + '/'}>
      <span class="miwen-back-arrow" aria-hidden="true">←</span>
      <span class="miwen-back-text kai">返回总目录</span>
    </a>

    <article class="post" aria-labelledby="post-title">
      <div class="post-grain" aria-hidden="true"></div>

      <div class="wrap">

        <header class="post-head reveal">
          <p class="post-series kai">
            <span class="post-series-mark">秘</span>
            <span>神机秘闻 · 第 {num} 篇</span>
          </p>
          <h1 id="post-title" class="kai">{title}</h1>
          <div class="post-rule"></div>
          <p class="post-summary">{summary}</p>
        </header>

        <aside class="post-notice reveal" data-d="2">
          <b class="kai">敬告</b>
          <p>本文内容纯属虚构，如有雷同，纯属雷同。公众版相较内群版删减大量内容，以□代替；请理性阅读，不要沉浸其中，不要尝试文中内容。</p>
        </aside>

        <div class="prose reveal" data-d="3">
          <Content />
        </div>

        <nav class="post-nav reveal" data-d="3" aria-label="秘闻导航">
          {
            prev ? (
              <a class="post-pager" href={base + '/miwen/' + prev.slug}>
                <span class="pager-label kai">上一篇</span>
                <span class="pager-title kai">{prev.title}</span>
              </a>
            ) : <span class="post-pager is-empty"><span class="pager-label kai">上一篇</span><span class="pager-title kai">已是首篇</span></span>
          }
          <a class="post-back btn" href={base + '/miwen'}>返回秘闻列表</a>
          {
            next ? (
              <a class="post-pager is-next" href={base + '/miwen/' + next.slug}>
                <span class="pager-label kai">下一篇</span>
                <span class="pager-title kai">{next.title}</span>
              </a>
            ) : <span class="post-pager is-next is-empty"><span class="pager-label kai">下一篇</span><span class="pager-title kai">已是末篇</span></span>
          }
        </nav>

      </div>
    </article>

    <Footer />
  </div>
</Base>

<style>
  /* ============================================================
     秘闻文章 · 玄金之页
     Same black + gold palette as the miwen index, scoped here.
     ============================================================ */

  /* Scope selectors deliberately use `html[data-theme]` so the
     .miwen-scope tokens win over the global `html[data-theme='light']`
     override in src/styles/global.css, so article pages stay gold+black
     regardless of the saved user theme. */
  html[data-theme] .miwen-scope {
    --ink: #050402;
    --ink-2: #0a0805;
    --ink-3: #110d07;
    --ink-line: rgba(201, 169, 97, 0.14);
    --bone: #d8be7a;
    --bone-dim: #9c8654;
    --bone-faint: #5e4f30;

    --heading: #ecd28a;
    --gold: #c9a961;
    --gold-bright: #ecc879;
    --gold-deep: #8a6f2e;
    --gold-glow: rgba(236, 200, 121, 0.45);
    --gold-line: rgba(201, 169, 97, 0.22);
    --gold-line-strong: rgba(201, 169, 97, 0.5);

    --panel-soft: rgba(201, 169, 97, 0.04);

    background: var(--ink);
    color: var(--bone);
    position: relative;
  }

  /* Article */
  .post {
    position: relative;
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--gold-line);
    overflow: hidden;
    isolation: isolate;
  }

  /* Same gold-dust grain as the index page */
  .post-grain {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.4;
    background-image:
      radial-gradient(circle at 12% 18%, rgba(236, 200, 121, 0.09) 0%, transparent 38%),
      radial-gradient(circle at 88% 70%, rgba(201, 169, 97, 0.06) 0%, transparent 42%);
    mix-blend-mode: screen;
  }

  .post > .wrap {
    position: relative;
    z-index: 1;
  }

  /* Header */
  .post-head {
    max-width: 46em;
    margin-inline: auto;
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
  }

  /* Back link, fixed top-left, replaces the global nav on this page */
  .miwen-back {
    position: fixed;
    top: 1.4rem;
    left: 1.4rem;
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--gold-line);
    border-radius: 2px;
    background: rgba(5, 4, 2, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--gold-bright);
    font-family: var(--font-kai);
    font-size: 0.84rem;
    letter-spacing: 0.28em;
    transition:
      border-color 0.3s var(--ease-soft),
      color 0.3s var(--ease-soft),
      transform 0.25s var(--ease-soft),
      background 0.3s var(--ease-soft);
  }
  .miwen-back:hover {
    border-color: var(--gold);
    color: #fff0c4;
    background: rgba(201, 169, 97, 0.08);
    transform: translateX(-2px);
  }
  .miwen-back-arrow {
    display: inline-block;
    color: var(--gold);
    transition: transform 0.3s var(--ease-soft), color 0.3s var(--ease-soft);
  }
  .miwen-back:hover .miwen-back-arrow {
    transform: translateX(-3px);
    color: var(--gold-bright);
  }

  @media (max-width: 560px) {
    .miwen-back {
      top: 0.9rem;
      left: 0.9rem;
      padding: 0.4rem 0.75rem;
      font-size: 0.78rem;
      letter-spacing: 0.22em;
    }
  }

  .post-series {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--gold);
    font-size: 0.84rem;
    letter-spacing: 0.32em;
    margin: 0;
  }

  .post-series-mark {
    display: inline-grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    font-family: var(--font-zhuan);
    font-size: 1rem;
    color: var(--gold-bright);
    border: 1px solid var(--gold-line-strong);
    border-radius: 2px;
    text-shadow: 0 0 12px var(--gold-glow);
    line-height: 1;
  }

  .post-head h1 {
    margin: 1rem 0 0;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: 0.24em;
    color: var(--heading);
    line-height: 1.3;
  }

  .post-rule {
    height: 1px;
    width: 4.5rem;
    margin-top: 1.4rem;
    background: linear-gradient(90deg, var(--gold), transparent);
  }

  .post-summary {
    margin-top: 1.2rem;
    max-width: 44em;
    color: var(--bone-dim);
    font-size: 0.94rem;
    line-height: 2.05;
  }

  /* Notice (敬告): amber-gold, replaces cinnabar */
  .post-notice {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    max-width: 46em;
    margin: 2rem auto;
    padding: 1.05rem 1.3rem;
    border: 1px solid var(--gold-line-strong);
    border-left: 3px solid var(--gold-deep);
    background: linear-gradient(180deg, rgba(138, 111, 46, 0.08), rgba(5, 4, 2, 0.4));
    border-radius: 2px;
  }
  .post-notice b {
    flex: none;
    color: #f4e7c1;
    background: var(--gold-deep);
    padding: 0.28em 0.55em;
    font-size: 0.82rem;
    letter-spacing: 0.32em;
    border-radius: 2px;
    transform: translateY(0.2em);
  }
  .post-notice p {
    color: var(--bone-dim);
    font-size: 0.88rem;
    line-height: 2;
  }

  /* Prose (markdown body) */
  .prose {
    max-width: 46em;
    margin-inline: auto;
    padding-bottom: 2rem;
  }
  .prose :global(p) {
    margin: 0;
    padding: 0;
    color: var(--bone-dim);
    font-size: 0.96rem;
    line-height: 2.15;
    text-indent: 2em;
    overflow-wrap: anywhere;
  }
  .prose :global(p + p) { margin-top: 0.85em; }
  .prose :global(p:first-child) { text-indent: 0; }
  .prose :global(strong),
  .prose :global(b) {
    color: var(--gold-bright);
    font-weight: 600;
  }
  .prose :global(em) {
    color: var(--gold);
    font-style: normal;
  }
  .prose :global(blockquote) {
    margin: 1.2rem 0;
    padding: 0.8rem 1.2rem;
    border-left: 2px solid var(--gold-line-strong);
    background: var(--panel-soft);
    color: var(--bone-faint);
    font-size: 0.9rem;
    line-height: 2;
  }
  .prose :global(ol),
  .prose :global(ul) {
    margin: 0.9rem 0;
    padding-left: 1.6em;
    color: var(--bone-dim);
    font-size: 0.94rem;
    line-height: 2.1;
  }
  .prose :global(li) { margin: 0.3rem 0; }
  .prose :global(li::marker) { color: var(--gold); }
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    margin: 1.8rem 0 0.8rem;
    color: var(--heading);
    font-family: var(--font-kai);
    letter-spacing: 0.18em;
  }
  .prose :global(h2) { font-size: 1.5rem; }
  .prose :global(h3) { font-size: 1.25rem; }
  .prose :global(h4) {
    font-size: 1.1rem;
    color: var(--gold-bright);
  }
  .prose :global(hr) {
    margin: 2rem 0;
    border: 0;
    border-top: 1px solid var(--gold-line);
  }
  .prose :global(code) {
    padding: 0.1em 0.4em;
    border: 1px solid var(--gold-line);
    border-radius: 2px;
    background: var(--panel-soft);
    color: var(--gold-bright);
    font-size: 0.88em;
  }
  .prose :global(a) {
    color: var(--gold-bright);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--gold-line-strong);
    transition: text-decoration-color 0.3s var(--ease-soft), color 0.3s var(--ease-soft);
  }
  .prose :global(a:hover) {
    color: #fff0c4;
    text-decoration-color: var(--gold);
  }

  /* Post nav */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.2rem;
    align-items: stretch;
    max-width: 46em;
    margin: 1.5rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid var(--gold-line);
  }
  .post-pager {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--gold-line);
    border-radius: 3px;
    background: var(--panel-soft);
    transition: border-color 0.3s var(--ease-soft), transform 0.2s var(--ease-soft), background 0.3s var(--ease-soft);
  }
  .post-pager:hover {
    border-color: var(--gold-line-strong);
    transform: translateY(-2px);
    background: rgba(201, 169, 97, 0.06);
  }
  .post-pager.is-next { text-align: right; }
  .post-pager.is-empty { opacity: 0.55; pointer-events: none; }
  .pager-label {
    color: var(--gold);
    font-size: 0.74rem;
    letter-spacing: 0.28em;
  }
  .pager-title {
    color: var(--heading);
    font-size: 1.02rem;
    letter-spacing: 0.12em;
    transition: color 0.3s var(--ease-soft);
  }
  .post-pager:hover .pager-title { color: var(--gold-bright); }
  .post-back { align-self: center; white-space: nowrap; }

  /* Override .btn default cinnabar hover state within miwen-scope */
  .miwen-scope :global(.btn) {
    border-color: var(--gold-line-strong);
    color: var(--gold-bright);
  }
  .miwen-scope :global(.btn:hover) {
    border-color: var(--gold);
    color: #050402;
    background: rgba(236, 200, 121, 0.92);
  }

  /* Mobile collapse */
  @media (max-width: 720px) {
    .post-nav { grid-template-columns: 1fr; }
    .post-back { justify-self: start; }
    .post-pager.is-next { text-align: left; }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .post-grain { opacity: 0.28; }
    .post-pager,
    .pager-title,
    .prose :global(a),
    .miwen-back,
    .miwen-back-arrow { transition: none; }
  }
</style>
</content>
</invoke>