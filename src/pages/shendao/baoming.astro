---
import BranchLayout from '../../layouts/BranchLayout.astro';
import BranchSteps from '../../components/BranchSteps.astro';
import PageIntro from '../../components/PageIntro.astro';
import Registration from '../../components/Registration.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const { title, description } = {
  title: '神道法报名 · 愿者自来',
  description: '有意拜师学习者，请踏实工作生活，勿抱侥幸思想。愿者来，不强迫，不强求。',
};
---

<BranchLayout
  title={title}
  description={description}
  glyph="神"
  label="神道法"
  accent="#cf8a52"
  bg={`${base}/bg/shen-dao-zhenxiang.webp`}
  bgDim={0.22}
  courseHref="/shendao/jieshao"
  baomingHref="/shendao/baoming"
>
  {/* 报名须知各分脉共用同一套内容（Registration + 同一段题头），
      各页只换本脉主色与背景图；此处即神道法的入口，不再外借咒法那页 */}
  <PageIntro
    mark="缘"
    title="愿者自来"
    sub="有意拜师学习者，请踏实工作生活，勿抱侥幸思想。愿者来，不强迫，不强求。请考虑清楚，再决定是否报名。"
    meta="报名请谨慎考虑，一经报名，概不退款、不打折、不调价、不分期。"
  />
  <Registration />

  {/* 最后一页只给两个去处：返回法门目录 · 介绍 */}
  <BranchSteps />
</BranchLayout>
