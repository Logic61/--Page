---
import BranchLayout from '../../layouts/BranchLayout.astro';
import BranchPortal from '../../components/BranchPortal.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = '神道法 · 香火之途';
const description = '神道法辨明：由香火念力衍生的法门——聚念、拜神、下种、带功、灌顶、附身。香火有毒，断绝道途，此门只作辨明，不劝人入。';
---

<BranchLayout
  title={title}
  description={description}
  glyph="神"
  label="神道法"
  accent="#cf8a52"
  bgDim={0.22}
  bg={`${base}/bg/shen-dao-zhenxiang.webp`}
>
  <BranchPortal
    glyph="神"
    title="神道法"
    subtitle="香火 · 封神 · 下种"
    description="神道与自力，是修行的两条路。此门所讲，是神道一途的来路与去处：何以容易，何以受制，何以被内行人称作「堕入神道」。"
    introHref={base + '/shendao/jieshao'}
  />
</BranchLayout>
