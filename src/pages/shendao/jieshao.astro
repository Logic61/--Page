---
import BranchLayout from '../../layouts/BranchLayout.astro';
import GateIntro from '../../components/GateIntro.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = '神道法 · 法门介绍';
const lead = "神道与自力，是修行的两条路。自力者，纯以自身神炁成就：形神兼修也好，单炼其神也好，神炁终归自己，所谓伟力归于自身；神道者，由香火念力衍生，借神明祖师之力成道。此门所讲，不是劝人入神道，而是把这条路的前因后果说明白——知而后择，明明白白。";

const blocks = [
  {
    label: '渊源',
    title: '香火者，信念之火',
    paras: [
      '神道法，指由香火念力衍生出来的法门。香火不是香与火，是人的信念之火，即所谓信仰之力；聚念、拜神、下种、带功、灌顶、附身，皆属此路。',
      '祖先神与自然神，是这世上最早的神灵。祖先受后人景仰追思而聚成形，其力亦来源于此；自然神则由人对日月山川的崇拜，因物赋职。神道一脉，自此而起。'
    ]
  },
  {
    label: '门类',
    title: '神道法有四',
    paras: [
      '一曰祖先神道，及由其衍出的三不朽神道、祖师神道；二曰封神法，汇聚万民心念以成神佛，即通常所说的香火神道，含百姓封神、朝廷封神、立教修神；三曰传教积功，取神道功德，死后受封为神官；四曰依附神明祖师仙佛，以自身神气或修炼壮大神明种子，终成有自我意识的神佛化身。',
      '二、三两种可以重叠。丹家所谓功行圆满、受诏飞升，本质上就是受封神官。'
    ]
  },
  {
    label: '所辨',
    title: '其利在易，其弊在受制',
    paras: [
      '神道之利，在于容易。上有神佛祖师相携，入门即可借用部分法力，符箓、咒诀、印诀上手便用，成功的几率比自力大得多。',
      '神道之弊，在于受制。无论因崇拜结缘，还是因借法结缘，你的精气神核心或修炼核心都会渐变为神佛祖师的：练的是它，壮大的也是它，属于自己的越来越少，思维亦在不知不觉间受其影响，最终趋于同化。神佛不缺香火时容你自在，真要用时，分身随时收回。'
    ]
  },
  {
    label: '所戒',
    title: '香火有毒，断绝道途',
    paras: [
      '香火念力驳杂而带污染，久炼则魂魄渐往聻（鬼死为聻）的性质上转。故内行人把入神道叫做「堕入神道」：不是没有成就，而是那条路的尽头，已经不是自己的道。',
      '神道与自力之间非此即彼，没有中间路线。不沾香火尚可自主，沾上一分便已入神道——灌顶、下种乃至神佛观想，皆是神道修法，不止烧香磕头才算。'
    ]
  },
  {
    label: '宜何人',
    paras: [
      '欲明辨神道、自守自力者；已有师承、须审自家法脉是否沾染香火者。若意在求速成、求神通、求人在上拉一把，则此门所列，正该先读三遍。'
    ]
  }
];

const description = '神道法门介绍：香火念力所生之法——聚念、拜神、下种、带功、灌顶、附身；神道法有四，其利在易，其弊在受制。本门所传为自力一路，此门只为辨明。';
---

<BranchLayout
  title={title}
  description={description}
  glyph="神"
  label="神道法"
  accent="#cf8a52"
  bgDim={0.22}
  bg={`${base}/bg/shen-dao-zhenxiang.webp`}
>
  <GateIntro
    glyph="神"
    name="神道法"
    subtitle="香火 · 封神 · 下种"
    lead={lead}
    blocks={blocks}
    note="本门所传为自力一路。此门所列，只为辨明：不劝人入神道，亦不代神道授法；修与不修，全凭自择，自由选择，自己承担后果。修行理论未经科学证实，切勿迷信。"
    altHref={base + '/zhoufa/jieshao'}
    altLabel="自力之门 · 咒法"
  />
</BranchLayout>
