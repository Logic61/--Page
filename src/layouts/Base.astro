---
import '../styles/global.css';
import Atmosphere from '../components/Atmosphere.astro';
import GoldNav from '../components/GoldNav.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import SeoHead from '../components/SeoHead.astro';

interface Props {
  title?: string;
  description?: string;
  hideNav?: boolean;
  /** 'gold' 时改用玄金顶栏（GoldNav），并保留搜索与明暗切换 */
  navVariant?: 'default' | 'gold';
  /** 页面自绘顶栏（hideNav={true}）时的搜索开关：
      true = 普通顶栏；'gold' = 玄金令牌顶栏（GoldNav，浮层需压在其之上）。 */
  search?: boolean | 'gold';
  /** 黑金页：暖黑底 + 鎏金字 + 整页「山河金影」底图，并隐含 navVariant="gold"
      （玄金令牌顶栏，且不再提供明暗切换）。/zhoufa 各页用，
      配色与 /famen、/changshi、/miwen、/xianwen 同源。 */
  inkGold?: boolean;
  /** 搜索关键词（keywords 元标签）。Google 已不看它，百度/360/搜狗仍参考，
      默认覆盖站名与主要法门词，个别页面可自行覆盖。 */
  keywords?: string;
}

const {
  title = '上古祝门 · 古巫祝脉',
  description = '古巫祝脉，上古祝门，传承祝法之道。祝，咒也。以诵咒通窍开脉，锻炼神形，追求天人合一，万物一咒。',
  keywords = '古巫祝脉, 上古祝门, 祝门, 祝法, 咒法, 祝由, 巫祝, 修炼常识, 秘闻, 法门',
  hideNav = false,
  navVariant = 'default',
  search = false,
  inkGold = false,
} = Astro.props;

const goldNav = navVariant === 'gold' || inkGold;
const showDefaultNav = !hideNav && !goldNav;
// 顶栏自带搜索按钮时（默认顶栏的「搜」/ GoldNav 的 showSearch）由本布局渲染浮层
const searchGold = search === 'gold' || goldNav;
const showSearch = search !== false || !hideNav || goldNav;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (Astro.url.pathname.replace(/\/$/, '') || '/').replace(base, '') || '/';

const nav = [
  { href: '/', label: '总目录', aliases: ['/four-veins'] },
  { href: '/zhoufa/mailuo', label: '巫祝脉络', aliases: ['/zhoufa/yuanqi', '/zhoufa/tixi'] },
  { href: '/miwen', label: '秘闻', aliases: ['/zhoufa/wenzhang'] },
  { href: '/changshi', label: '修炼常识', aliases: ['/zhoufa/zhishi', '/zhoufa/wenda', '/zhoufa/yangsheng'] },
  { href: '/zhoufa/xuexi', label: '体系学习', aliases: ['/zhoufa/chuancheng'] },
  { href: '/zhoufa/kecheng', label: '课程介绍', aliases: [] },
  { href: '/zhoufa/baoming', label: '报名须知', aliases: [] },
];

const isActive = (item: (typeof nav)[number]) =>
    path === item.href || item.aliases.includes(path) || (item.href.length > 1 && path.startsWith(item.href + '/'));
---

<!doctype html>
<html lang="zh-CN" data-theme="light" {...(inkGold ? { 'data-theme-lock': 'dark' } : {})}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead title={title} description={description} keywords={keywords} />
    <script>
      (function () {
        var root = document.documentElement;
        // 黑金页（data-theme-lock="dark"）：底图与配色都是暖黑鎏金，锁定暗色，
        // 既不读本地偏好也不写回，别的页面照旧跟随明暗切换
        var lock = root.getAttribute('data-theme-lock');
        var saved = null;
        if (!lock) {
          try { saved = localStorage.getItem('zhumen-theme'); } catch (e) {}
        }
        var dark = lock ? lock === 'dark' : saved ? saved === 'dark' : false;
        root.setAttribute('data-theme', dark ? 'dark' : 'light');
        root.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <Atmosphere />

    {goldNav && <GoldNav showSearch showTheme={!inkGold} />}

    {showDefaultNav && (
      <header class="nav" id="nav">
        <div class="nav-inner wrap">
          <a class="brand" href={`${base}/`}>
            <span class="brand-seal"><img src={`${base}/巫字.png`} alt="巫" width="155" height="153" /></span>
            <span class="brand-name">
              <b>上古祝门</b>
              <small>古巫祝脉</small>
            </span>
          </a>
          <nav class="nav-links" aria-label="主导航">
            {
              nav.map((n) => (
                <a href={`${base}${n.href}`} class:list={{ active: isActive(n) }}>{n.label}</a>
              ))
            }
          </nav>
          <button class="nav-search" id="searchToggle" type="button" aria-label="全局搜索" title="搜索（Ctrl+K）">搜</button>
          <button class="theme-toggle" id="themeToggle" type="button" aria-label="切换明暗模式" title="切换明暗模式">
            <span class="theme-symbol theme-symbol--dark" aria-hidden="true">月</span>
            <span class="theme-symbol theme-symbol--light" aria-hidden="true">日</span>
          </button>
          <button class="nav-burger" id="navBurger" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="mobileMenu">
            <span></span><span></span><span></span>
          </button>
        </div>
      </header>
    )}

    {showDefaultNav && (
      <div class="drawer" id="mobileMenu" aria-hidden="true">
        <nav class="drawer-links" aria-label="移动端导航">
          {
            nav.map((n) => (
                <a href={`${base}${n.href}`} class:list={{ active: isActive(n) }}>{n.label}</a>
            ))
          }
        </nav>
      </div>
    )}

    {/* ink-gold 的整页底图由 main 的 ::before 画（见 global.css），
        这里只把图片地址按 base 前缀传进去 */}
    <main
      id="top"
      class:list={{ 'nav-gold': goldNav, 'ink-gold': inkGold }}
      style={inkGold ? `--ink-gold-bg:url('${base}/bg/zhoufa-xingpan.webp')` : undefined}
    >
      <slot />
    </main>

    {/* 搜索浮层：放在 <main> 之后，确保页面自绘的顶栏（GoldNav 等）已解析，
        脚本才拿得到顶栏里的 #searchToggle；浮层本身 position:fixed，顺序不影响视觉 */}
    {showSearch && <SearchOverlay gold={searchGold} />}

    <script>
      const rootEl = document.documentElement;
      const toggle = document.getElementById('themeToggle');

      const applyTheme = (theme) => {
        rootEl.setAttribute('data-theme', theme);
        try { localStorage.setItem('zhumen-theme', theme); } catch (e) {}
      };

      toggle?.addEventListener('click', () => {
        const next = rootEl.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        applyTheme(next);
      });

      const burger = document.getElementById('navBurger');
      const drawer = document.getElementById('mobileMenu');
      const closeDrawer = () => {
        drawer?.setAttribute('aria-hidden', 'true');
        burger?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('menu-open');
      };
      burger?.addEventListener('click', () => {
        const open = drawer?.getAttribute('aria-hidden') === 'false';
        if (open) closeDrawer();
        else {
          drawer?.setAttribute('aria-hidden', 'false');
          burger?.setAttribute('aria-expanded', 'true');
          document.body.classList.add('menu-open');
        }
      });
      drawer?.addEventListener('click', (e) => {
        if (e.target === drawer) closeDrawer();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDrawer();
      });
      drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeDrawer));

      const revealAll = () =>
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
      if (!('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
        setTimeout(revealAll, 1600);
      }
    </script>

  </body>
</html>

<style>
  .nav-search {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border: 1px solid var(--ink-line);
    border-radius: 50%;
    background: transparent;
    color: var(--bronze-bright);
    font-family: var(--font-kai);
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 0.3s var(--ease-soft), color 0.3s var(--ease-soft), transform 0.2s var(--ease-soft);
  }
  .nav-search:hover { border-color: var(--bronze); color: var(--cinnabar-bright); transform: translateY(-1px); }

  /* 搜索浮层与结果样式见 components/SearchOverlay.astro（含脚本） */
</style>
