---
import '../styles/global.css';
import Atmosphere from '../components/Atmosphere.astro';
import searchIndex from '../data/search-index.json';

interface Props {
  title?: string;
  description?: string;
  hideNav?: boolean;
}

const { title = '上古祝门 · 古巫祝脉', description = '古巫祝脉，上古祝门，传承祝法之道。祝，咒也。以诵咒通窍开脉，锻炼神形，追求天人合一，万物一咒。', hideNav = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (Astro.url.pathname.replace(/\/$/, '') || '/').replace(base, '') || '/';

const nav = [
  { href: '/', label: '总目录', aliases: ['/four-veins'] },
  { href: '/zhoufa/mailuo', label: '咒法脉络', aliases: ['/zhoufa/yuanqi', '/zhoufa/tixi'] },
  { href: '/miwen', label: '秘闻', aliases: ['/zhoufa/wenzhang'] },
  { href: '/changshi', label: '修炼常识', aliases: ['/zhoufa/zhishi', '/zhoufa/wenda', '/zhoufa/yangsheng'] },
  { href: '/zhoufa/xuexi', label: '体系学习', aliases: ['/zhoufa/chuancheng'] },
  { href: '/zhoufa/kecheng', label: '课程介绍', aliases: [] },
  { href: '/zhoufa/baoming', label: '报名须知', aliases: [] },
];

const isActive = (item: (typeof nav)[number]) =>
    path === item.href || item.aliases.includes(path) || (item.href.length > 1 && path.startsWith(item.href + '/'));
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
    <script>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('zhumen-theme'); } catch (e) {}
        var dark = saved ? saved === 'dark' : false;
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <Atmosphere />

    {!hideNav && (
      <header class="nav" id="nav">
        <div class="nav-inner wrap">
          <a class="brand" href={`${base}/`}>
            <span class="brand-seal"><img src={`${base}/巫字.png`} alt="巫" width="155" height="153" /></span>
            <span class="brand-name">
              <b>上古祝门</b>
              <small>古巫祝脉</small>
            </span>
          </a>
          <nav class="nav-links" aria-label="主导航">
            {
              nav.map((n) => (
                <a href={`${base}${n.href}`} class:list={{ active: isActive(n) }}>{n.label}</a>
              ))
            }
          </nav>
          <button class="nav-search" id="searchToggle" type="button" aria-label="全局搜索" title="搜索（Ctrl+K）">搜</button>
          <button class="theme-toggle" id="themeToggle" type="button" aria-label="切换明暗模式" title="切换明暗模式">
            <span class="theme-symbol theme-symbol--dark" aria-hidden="true">月</span>
            <span class="theme-symbol theme-symbol--light" aria-hidden="true">日</span>
          </button>
          <button class="nav-burger" id="navBurger" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="mobileMenu">
            <span></span><span></span><span></span>
          </button>
        </div>
      </header>
    )}

    {!hideNav && (
      <div class="drawer" id="mobileMenu" aria-hidden="true">
        <nav class="drawer-links" aria-label="移动端导航">
          {
            nav.map((n) => (
                <a href={`${base}${n.href}`} class:list={{ active: isActive(n) }}>{n.label}</a>
            ))
          }
        </nav>
      </div>
    )}

    {!hideNav && (
      <div class="search-overlay" id="searchOverlay" aria-hidden="true" role="dialog" aria-label="全局搜索">
        <div class="search-panel">
          <div class="search-bar">
            <input id="searchInput" type="search" placeholder="搜索修炼常识、秘闻…（Esc 关闭）" autocomplete="off" />
            <button class="search-close" id="searchClose" type="button" aria-label="关闭搜索">×</button>
          </div>
          <div class="search-results" id="searchResults">
            <p class="search-hint">输入关键词，可搜索全部修炼常识与《神机秘闻》秘闻</p>
          </div>
        </div>
      </div>
    )}

    <main id="top">
      <slot />
    </main>

    <script>
      const rootEl = document.documentElement;
      const toggle = document.getElementById('themeToggle');

      const applyTheme = (theme) => {
        rootEl.setAttribute('data-theme', theme);
        try { localStorage.setItem('zhumen-theme', theme); } catch (e) {}
      };

      toggle?.addEventListener('click', () => {
        const next = rootEl.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        applyTheme(next);
      });

      const burger = document.getElementById('navBurger');
      const drawer = document.getElementById('mobileMenu');
      const closeDrawer = () => {
        drawer?.setAttribute('aria-hidden', 'true');
        burger?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('menu-open');
      };
      burger?.addEventListener('click', () => {
        const open = drawer?.getAttribute('aria-hidden') === 'false';
        if (open) closeDrawer();
        else {
          drawer?.setAttribute('aria-hidden', 'false');
          burger?.setAttribute('aria-expanded', 'true');
          document.body.classList.add('menu-open');
        }
      });
      drawer?.addEventListener('click', (e) => {
        if (e.target === drawer) closeDrawer();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDrawer();
      });
      drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeDrawer));

      const revealAll = () =>
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
      if (!('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
        setTimeout(revealAll, 1600);
      }
    </script>

    <script define:vars={{ searchIndex, base }}>
      const st = document.getElementById('searchToggle');
      const so = document.getElementById('searchOverlay');
      const si = document.getElementById('searchInput');
      const sr = document.getElementById('searchResults');
      const sc = document.getElementById('searchClose');
      const openSearch = () => {
        so.setAttribute('aria-hidden', 'false');
        document.body.classList.add('search-open');
        setTimeout(() => si.focus(), 30);
      };
      const closeSearch = () => {
        so.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('search-open');
        si.value = '';
        sr.innerHTML = '<p class="search-hint">输入关键词，可搜索全部修炼常识与《神机秘闻》秘闻</p>';
      };
      st?.addEventListener('click', openSearch);
      sc?.addEventListener('click', closeSearch);
      so?.addEventListener('click', (e) => { if (e.target === so) closeSearch(); });
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openSearch(); }
        else if (e.key === 'Escape' && so?.getAttribute('aria-hidden') === 'false') closeSearch();
      });
      const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      si?.addEventListener('input', () => {
        const q = si.value.trim().toLowerCase();
        if (!q) { sr.innerHTML = '<p class="search-hint">输入关键词，可搜索全部修炼常识与《神机秘闻》秘闻</p>'; return; }
        const hits = searchIndex.filter((x) => (x.title + x.snippet + x.category).toLowerCase().includes(q))
          .sort((a, b) => (b.title.toLowerCase().includes(q) ? 1 : 0) - (a.title.toLowerCase().includes(q) ? 1 : 0));
        const kw = hits.filter((h) => h.type === 'knowledge');
        const art = hits.filter((h) => h.type === 'article');
        let html = '';
        if (kw.length) {
          html += '<h4 class="search-group-title">修炼常识（' + kw.length + '）</h4>';
          html += kw.slice(0, 12).map((h) => '<a class="search-hit" href="' + base + h.url + '"><b>' + esc(h.title) + '</b><span>' + esc(h.category) + ' · ' + esc(h.snippet) + '</span></a>').join('');
        }
        if (art.length) {
          html += '<h4 class="search-group-title">秘闻（' + art.length + '）</h4>';
          html += art.slice(0, 6).map((h) => '<a class="search-hit" href="' + base + h.url + '"><b>' + esc(h.title) + '</b><span>' + esc(h.snippet) + '</span></a>').join('');
        }
        if (!html) html = '<p class="search-hint">未找到与「' + esc(q) + '」相关的内容</p>';
        sr.innerHTML = html;
      });
    </script>
  </body>
</html>

<style>
  .nav-search {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border: 1px solid var(--ink-line);
    border-radius: 50%;
    background: transparent;
    color: var(--bronze-bright);
    font-family: var(--font-kai);
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 0.3s var(--ease-soft), color 0.3s var(--ease-soft), transform 0.2s var(--ease-soft);
  }
  .nav-search:hover { border-color: var(--bronze); color: var(--cinnabar-bright); transform: translateY(-1px); }

  :global(body.search-open) { overflow: hidden; }

  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-nav) + 3);
    background: rgba(5, 8, 12, 0.84);
    backdrop-filter: blur(6px);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 13vh 1.2rem 2rem;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s var(--ease-soft), visibility 0.3s;
  }
  .search-overlay[aria-hidden='false'] { visibility: visible; opacity: 1; }

  .search-panel { width: min(100%, 44rem); }
  .search-bar { display: flex; gap: 0.6rem; }
  .search-bar :global(input) {
    flex: 1;
    min-width: 0;
    padding: 0.85em 1.1em;
    border: 1px solid var(--ink-line);
    border-radius: 4px;
    background: var(--ink-3);
    color: var(--bone);
    font-family: var(--font-song);
    font-size: 1.05rem;
    outline: none;
    transition: border-color 0.3s var(--ease-soft);
  }
  .search-bar :global(input:focus) { border-color: var(--bronze-dim); }
  .search-bar :global(input::placeholder) { color: var(--bone-faint); }
  .search-close {
    width: 48px;
    flex: none;
    border: 1px solid var(--ink-line);
    border-radius: 4px;
    background: transparent;
    color: var(--bone-dim);
    font-size: 1.25rem;
    cursor: pointer;
    transition: border-color 0.3s var(--ease-soft), color 0.3s var(--ease-soft);
  }
  .search-close:hover { border-color: var(--cinnabar); color: var(--cinnabar-bright); }

  .search-results { margin-top: 1.1rem; max-height: 62vh; overflow-y: auto; padding-right: 0.3rem; }
  .search-results :global(.search-hint) { color: var(--bone-faint); padding: 1rem 0.2rem; font-size: 0.9rem; line-height: 2; }
  .search-results :global(.search-group-title) {
    margin: 1.1rem 0 0.5rem;
    color: var(--bronze-bright);
    font-family: var(--font-kai);
    font-size: 0.86rem;
    letter-spacing: 0.24em;
  }
  .search-results :global(.search-hit) {
    display: block;
    padding: 0.8rem 0.95rem;
    margin-bottom: 0.55rem;
    border: 1px solid var(--ink-line);
    border-left: 2px solid var(--bronze-dim);
    border-radius: 3px;
    background: var(--panel-soft);
    transition: border-color 0.25s var(--ease-soft), transform 0.2s var(--ease-soft);
  }
  .search-results :global(.search-hit:hover) { border-color: var(--bronze-bright); transform: translateY(-1px); }
  .search-results :global(.search-hit b) { display: block; color: var(--heading); font-size: 0.98rem; letter-spacing: 0.06em; }
  .search-results :global(.search-hit span) { display: block; margin-top: 0.3rem; color: var(--bone-faint); font-size: 0.8rem; line-height: 1.8; }
  .search-results :global(.search-hit:hover b) { color: var(--bronze-bright); }
</style>
