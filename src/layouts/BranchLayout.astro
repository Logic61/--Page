---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';

// ============================================================
// 五脉分支页布局（偶景 / 鏖战 / 驻颜 / 真气 …）
// 顶栏：只保留三个全站入口——返回总目录 · 课程介绍 · 报名须知
// 背景：整页固定一张实景图（bg 传入），不再叠金色环带与雷纹
// ============================================================

interface Props {
  title: string;
  description: string;
  /** 分脉字形与名号（由各页 hero 呈现，顶栏不再重复；保留入参以兼容现有页面） */
  glyph: string;
  label: string;
  /** 分脉主色：用于文字、描边与顶栏强调 */
  accent: string;
  /** 整页背景图，含 base 前缀，如 `${base}/bg/oujing-shenying.webp` */
  bg: string;
  /** 背景定位，缺省居中 */
  bgPos?: string;
  /** 背景额外压暗 0~1（原图偏亮时用 0.1~0.25） */
  bgDim?: number;
  /** 该分脉的搜索关键词，覆盖 SeoHead 的默认值 */
  keywords?: string;
  /** 顶栏「课程介绍」入口，缺省指向咒法课程页 */
  courseHref?: string;
  /** 顶栏「报名须知」入口，缺省指向咒法报名页 */
  baomingHref?: string;
  /** 顶栏右侧入口；给出时整组覆盖上面的缺省三项 */
  navItems?: { href: string; label: string }[];
}

const {
  title,
  description,
  accent,
  bg,
  bgPos = '50% 50%',
  bgDim = 0,
  keywords,
  courseHref = '/zhoufa/kecheng',
  baomingHref = '/zhoufa/baoming',
  navItems,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 顶栏右侧三项；左上角另设「返回法门列表」（回到五门目录）
const entries = navItems ?? [
  { href: '/', label: '返回总目录' },
  { href: courseHref, label: '课程介绍' },
  { href: baomingHref, label: '报名须知' },
];
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <SeoHead title={title} description={description} keywords={keywords} />
  </head>
  <body
    class="branch-page"
    style={`--branch-accent: ${accent}; --branch-bg: url('${bg}'); --branch-bg-pos: ${bgPos}; --branch-dim: ${bgDim};`}
  >
    {/* 整页背景：固定不随滚动，cover 铺满；上面压一层压暗/渐隐，保证文字可读 */}
    <div class="branch-scene" aria-hidden="true"></div>
    <div class="branch-scrim" aria-hidden="true"></div>

    <header class="branch-nav">
      <div class="branch-nav-inner">
        <a class="branch-nav-back kai" href={`${base}/famen/chuanshou`}>
          <span class="branch-nav-arrow" aria-hidden="true">←</span>返回法门列表
        </a>
        <nav class="branch-nav-links kai" aria-label="全站入口">
          {
            entries.map((e, i) => (
              <>
                {i > 0 && <span class="branch-nav-sep" aria-hidden="true">·</span>}
                <a href={`${base}${e.href}`}>{e.label}</a>
              </>
            ))
          }
        </nav>
      </div>
    </header>

    <main><slot /></main>
  </body>
</html>

<style>
  .branch-page {
    min-height: 100dvh;
    position: relative;
    background: #05070a;
    color: #d9d2c2;
    /* 实景图当底时，半透明面板要更实一点，否则正文压在亮部上读不清 */
    --panel-grad: linear-gradient(180deg, rgba(6, 10, 14, 0.82), rgba(4, 6, 9, 0.74));
    --panel-mid: linear-gradient(180deg, rgba(6, 10, 14, 0.86), rgba(4, 6, 9, 0.78));
    --panel-strong: linear-gradient(180deg, rgba(6, 10, 14, 0.92), rgba(4, 6, 9, 0.86));
    --panel-soft: rgba(6, 10, 14, 0.76);
  }

  /* ---------- 背景：实景图 + 可读性遮罩 ---------- */
  .branch-scene {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: var(--branch-bg);
    background-size: cover;
    background-position: var(--branch-bg-pos);
    background-repeat: no-repeat;
  }

  .branch-scrim {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(4, 6, 9, 0.9) 0%,
        rgba(4, 6, 9, 0.72) 16%,
        rgba(4, 6, 9, 0.68) 40%,
        rgba(4, 6, 9, 0.76) 72%,
        rgba(4, 6, 9, 0.94) 100%
      ),
      radial-gradient(
        ellipse 80% 58% at 50% 32%,
        color-mix(in srgb, var(--branch-accent) 9%, transparent),
        transparent 72%
      ),
      rgba(4, 6, 9, var(--branch-dim));
  }

  /* ---------- 顶栏：三个全站入口 ---------- */
  .branch-nav {
    position: sticky;
    top: 0;
    z-index: 3;
    background: linear-gradient(
      180deg,
      rgba(4, 6, 9, 0.86) 0%,
      rgba(4, 6, 9, 0.5) 64%,
      rgba(4, 6, 9, 0) 100%
    );
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .branch-nav-inner {
    width: min(100% - 3rem, 72rem);
    min-height: 4.6rem;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--branch-accent) 26%, transparent);
  }

  .branch-nav-back,
  .branch-nav-links a {
    font-size: 0.88rem;
    letter-spacing: 0.3em;
    text-decoration: none;
  }

  .branch-nav-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: color-mix(in srgb, var(--branch-accent) 80%, #efe3c8);
    transition: color 0.25s var(--ease-soft), text-shadow 0.25s var(--ease-soft);
  }
  .branch-nav-back:hover {
    color: #fff3db;
    text-shadow: 0 0 16px color-mix(in srgb, var(--branch-accent) 45%, transparent);
  }
  .branch-nav-arrow {
    font-size: 0.9em;
    transition: transform 0.3s var(--ease-soft);
  }
  .branch-nav-back:hover .branch-nav-arrow {
    transform: translateX(-3px);
  }

  .branch-nav-links {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .branch-nav-links a {
    position: relative;
    color: #a89c85;
    transition: color 0.25s var(--ease-soft);
  }
  .branch-nav-links a::after {
    content: '';
    position: absolute;
    left: 50%;
    right: 50%;
    bottom: -0.45rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--branch-accent), transparent);
    opacity: 0;
    transition: left 0.4s var(--ease-soft), right 0.4s var(--ease-soft), opacity 0.3s var(--ease-soft);
  }
  .branch-nav-links a:hover {
    color: #fff3db;
  }
  .branch-nav-links a:hover::after {
    left: 0;
    right: 0;
    opacity: 0.9;
  }
  .branch-nav-sep {
    color: color-mix(in srgb, var(--branch-accent) 62%, #efe3c8);
    font-size: 0.8rem;
  }

  main {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 640px) {
    .branch-nav-inner {
      width: min(100% - 2.2rem, 72rem);
      min-height: 4rem;
      gap: 0.6rem;
    }
    .branch-nav-back,
    .branch-nav-links a {
      font-size: 0.74rem;
      letter-spacing: 0.08em;
    }
    .branch-nav-back {
      gap: 0.3rem;
    }
    /* 窄屏去掉间隔点，靠间距区分 */
    .branch-nav-links {
      gap: 0.85rem;
    }
    .branch-nav-sep {
      display: none;
    }
  }

  @media (max-width: 430px) {
    .branch-nav-inner {
      width: min(100% - 1.8rem, 72rem);
    }
    .branch-nav-back,
    .branch-nav-links a {
      font-size: 0.71rem;
      letter-spacing: 0;
    }
  }
</style>
