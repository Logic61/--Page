---
import '../styles/global.css';
import GoldBand from '../components/GoldBand.astro';

interface Props {
  title: string;
  description: string;
  glyph: string;
  label: string;
  accent: string;
}

const { title, description, glyph, label, accent } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class="branch-page" style={`--branch-accent: ${accent}`}>
    <div class="branch-aura" aria-hidden="true"></div>
    <div class="branch-bands" aria-hidden="true"><GoldBand /></div>
    <header class="branch-nav">
      <a class="branch-back kai" href={`${base}/famen`}>返回目录</a>
      <span class="branch-nav-name kai"><b>{glyph}</b>{label}</span>
    </header>
    <main><slot /></main>
  </body>
</html>

<style>
  .branch-page { min-height: 100dvh; background: #070807; color: #d9d2c2; position: relative; }
  .branch-bands { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .branch-aura { position: fixed; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(ellipse 72% 46% at 50% -6%, color-mix(in srgb, var(--branch-accent) 14%, transparent), transparent 66%), radial-gradient(ellipse 46% 34% at 10% 92%, color-mix(in srgb, var(--branch-accent) 8%, transparent), transparent 72%), radial-gradient(ellipse 42% 30% at 92% 22%, color-mix(in srgb, var(--branch-accent) 7%, transparent), transparent 72%), #070807; }
  .branch-nav { position: relative; z-index: 2; width: min(100% - 3rem, 72rem); height: 5.3rem; margin-inline: auto; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid color-mix(in srgb, var(--branch-accent) 25%, transparent); }
  main { position: relative; z-index: 1; }
  .branch-back, .branch-nav-name { font-size: 0.88rem; letter-spacing: 0.3em; }
  .branch-back { color: color-mix(in srgb, var(--branch-accent) 80%, #efe3c8); transition: color 0.25s var(--ease-soft); }
  .branch-back:hover { color: #fff3db; }
  .branch-nav-name { color: #8e856f; }
  .branch-nav-name b { display: inline-block; margin-right: 0.5rem; color: var(--branch-accent); font-size: 1.25rem; font-weight: 400; }
  @media (max-width: 640px) { .branch-nav { width: min(100% - 2.2rem, 72rem); } .branch-back, .branch-nav-name { font-size: 0.8rem; letter-spacing: 0.2em; } }
</style>
