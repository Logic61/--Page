---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '上古祝门 · 四脉分支',
  description = '上古祝门法脉总览。'
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class="veins-page">
    <div class="veins-backdrop" style={`--veins-texture: url('${base}/veins-stone-texture.svg')`} aria-hidden="true"></div>
    <header class="veins-nav">
      <a class="veins-brand kai" href={`${base}/`}>上古祝门</a>
      <span class="veins-nav-title kai">法脉总览</span>
      <a class="veins-nav-link kai" href={`${base}/zhoufa`}>进入祝门</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="veins-footer kai">四脉同源 · 各有所传</footer>
  </body>
</html>

<style>
  .veins-page {
    min-height: 100dvh;
    background: #080604;
    color: #d9d2c2;
  }

  .veins-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 58% 42% at 52% 42%, rgba(89, 56, 25, 0.1), transparent 72%),
      radial-gradient(ellipse 42% 28% at 14% 84%, rgba(72, 45, 23, 0.06), transparent 74%),
      var(--veins-texture) center top / cover no-repeat;
    opacity: 0.5;
  }

  .veins-backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.72), transparent 18%, transparent 82%, rgba(0, 0, 0, 0.76));
  }

  .veins-nav,
  .veins-footer {
    position: relative;
    z-index: 3;
    width: min(100% - 3rem, 76rem);
    margin-inline: auto;
  }

  .veins-nav {
    min-height: 4.6rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid rgba(181, 135, 65, 0.18);
  }

  .veins-brand,
  .veins-nav-link {
    color: #d4b877;
    font-size: 0.9rem;
    letter-spacing: 0.32em;
  }

  .veins-nav-title {
    color: #817253;
    font-size: 0.7rem;
    letter-spacing: 0.44em;
  }

  .veins-nav-link {
    justify-self: end;
    color: #a99565;
    transition: color 0.25s var(--ease-soft);
  }

  .veins-nav-link:hover { color: #f0e3c8; }

  .veins-footer {
    padding: 1.5rem 0 2.3rem;
    border-top: 1px solid rgba(212, 184, 119, 0.12);
    color: #766746;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.42em;
  }

  @media (max-width: 640px) {
    .veins-nav,
    .veins-footer { width: min(100% - 2.2rem, 76rem); }
    .veins-nav { grid-template-columns: 1fr auto; }
    .veins-nav-title { display: none; }
    .veins-brand,
    .veins-nav-link { font-size: 0.8rem; letter-spacing: 0.22em; }
  }
</style>
