---
// 九星芒阵 —— 九重对称玄阵（黑金），与云雷祭阵同语系（复用 a-* 全局样式类）
// 结构：
//   外环（顺时针）：双主环 + 三重九芒星交织（{9/2}/{9/4}/{9/3}）+ 九辰节点
//   外圈符文带：最外一道符文环（顺时针），盖过双主环之外
//   符文环共六道（976/848/745/642/562/392），相邻两两顺逆交替
//   压暗结构（array-body opacity .75）只包住结构层与轨道线；
//   六道符文环走 .a-rune（与中心树同滤镜链、同源色），亮度颜色与树像素级一致
//   中环（逆时针）：八十一刻度环 + 廿七雷文带 + 九瓣莲旋
//   内环（逆转细层）：九瓣内莲 + 细九芒 + 珠环
//   定核（不转）：双九边形 + 亮九芒星 + 太极巫字
import Taiji from './patterns/taiji.astro';
import { ringUses } from './ritual.js';

// structureDim：结构层（array-body）整体压暗系数；0 = 不压暗（jiuxing 等页保持旧观感）。
// four-veins 传 0：法阵亮度由页内 CSS 分层控制（符文/轨道全亮、结构压暗）。
const { structureDim = 0 } = Astro.props;

const n2 = (v) => Math.round(v * 10) / 10;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const TAU = Math.PI * 2;

// 巫/雷纹 17 张截图符号（含 17 号现代⚡）：按 1-2-…-17-1-2-… 连续循环排列
const LEI = Array.from({ length: 17 }, (_, i) => `lei-${i + 1}`);
// 符文圈：1-17 连续环绕；数量取 17 倍数保证无缝衔接
const leiRing = (r, n, s, offset) =>
  ringUses(LEI.map((id) => ({ id, scale: s })), r, n, { offset, scaleCycle: [1] });

// 星形折线 {n/k}：n 角星，每步跨 k 角，折线闭合
const starPath = (n, k, R, rotDeg = 0) => {
  const rot = (rotDeg * Math.PI) / 180;
  const pts = Array.from({ length: n }, (_, i) => {
    const a = rot + (i * k * TAU) / n;
    return `${n2(Math.cos(a) * R)} ${n2(Math.sin(a) * R)}`;
  });
  return `M ${pts.join(' L ')} Z`;
};

// 直线 → 雷纹2号紧密排列：以 lei-2 为单元，沿折线密铺成“雷纹线”
const gcd = (a, b) => (b ? gcd(b, a % b) : a);
// 取出 {n/k} 星形的全部直线子段（含互不相连的三角组）
const starPolylines = (n, k, R, rotDeg = 0) => {
  const rot = (rotDeg * Math.PI) / 180;
  const g = gcd(n, k);
  const polys = [];
  for (let s = 0; s < g; s++) {
    const pts = [];
    let idx = s;
    for (let j = 0; j <= n / g; j++) {
      const a = rot + (idx * TAU) / n;
      pts.push([Math.cos(a) * R, Math.sin(a) * R]);
      idx = (idx + k) % n;
    }
    polys.push(pts);
  }
  return polys;
};
// 沿一条折线密铺雷纹2号（每隔 spacing 放一枚，随线段切线旋转）
const beadsAlong = (pts, spacing, sc, rotDeg = 0) => {
  const out = [];
  for (let i = 0; i < pts.length - 1; i++) {
    const [x1, y1] = pts[i];
    const [x2, y2] = pts[i + 1];
    const dx = x2 - x1, dy = y2 - y1;
    const len = Math.hypot(dx, dy);
    if (len < 1) continue;
    const ang = (Math.atan2(dy, dx) * 180) / Math.PI + rotDeg;
    const n = Math.max(1, Math.round(len / spacing));
    for (let j = 0; j <= n; j++) {
      const t = j / n;
      out.push(`<use href="#lei-2" transform="translate(${n2(x1 + dx * t)} ${n2(y1 + dy * t)}) rotate(${n2(ang)}) scale(${n2(sc)})"/>`);
    }
  }
  return out;
};
const beadStroke = (polys, spacing, sc, rotDeg = 0) =>
  polys.flatMap((p) => beadsAlong(p, spacing, sc, rotDeg)).join('');

// 莲瓣：以外弧鼓出的两段贝塞尔构成一枚瓣
const petalPath = (aDeg, r1, r2, halfDeg) => {
  const a = (aDeg * Math.PI) / 180;
  const h = (halfDeg * Math.PI) / 180;
  const p = (r, ang) => `${n2(Math.cos(ang) * r)} ${n2(Math.sin(ang) * r)}`;
  return `M ${p(r1, a - h)} Q ${p(r2, a - h / 2)} ${p(r2, a)} Q ${p(r2, a + h / 2)} ${p(r1, a + h)} Q ${p((r1 + r2) / 2, a)} ${p(r1, a - h)} Z`;
};

// ---- 外环（顺时针缓转）----
const ring950 = `<circle class="a-ring" r="950"/><circle class="a-ring a-thin" r="912"/>`;
// 三重九芒星交织：所有直线由「雷纹2号」紧密排列密铺而成
const nonagramWeb = beadStroke(starPolylines(9, 2, 884, 0), 30, 0.32) +
  beadStroke(starPolylines(9, 4, 884, 20), 30, 0.32) +
  beadStroke(starPolylines(9, 3, 862, 10), 30, 0.26);
// 九辰节点：{9/2} 九个外尖上的阵眼
const nodes9 = Array.from({ length: 9 }, (_, i) => {
  const a = (i * TAU) / 9;
  return `<g transform="translate(${n2(Math.cos(a) * 884)} ${n2(Math.sin(a) * 884)})"><circle class="a-node" r="11"/><circle class="a-node-ring" r="19"/></g>`;
}).join('');
// 四道符文环：以 1-17 雷纹连续环绕，半径重排并收紧，数量取 17 倍数无缝衔接
const lei0 = leiRing(976, 68, 0.72, 0.5);
const lei1 = leiRing(848, 51, 0.64, 0.5);
const lei2 = leiRing(745, 51, 0.6, 0.5);
const lei3 = leiRing(642, 34, 0.54, 0.5);
// 内侧再加两道符文环：一道在莲旋与内莲之间，一道在珠环与细九芒之间
const lei4 = leiRing(562, 34, 0.46, 0.5);
const lei5 = leiRing(392, 34, 0.4, 0.5);
// 每道符文环两侧的轨道线：比一般线条稍亮、比符文弱（a-track）
const trackFor = (r) =>
  `<circle class="a-track a-ring a-thin" r="${n2(r - 25)}"/><circle class="a-track a-ring a-thin" r="${n2(r + 25)}"/>`;
const track0 = trackFor(976);
const track1 = trackFor(848);
const track2 = trackFor(745);
const track3 = trackFor(642);
const track4 = trackFor(562);
const track5 = trackFor(392);

// ---- 中环（逆时针缓转）----
// 九瓣莲旋：九枚外鼓莲瓣首尾相衔
const lotus9 = Array.from({ length: 9 }, (_, i) =>
  `<path class="a-poly" d="${petalPath(i * 40 + 20, 596, 700, 15)}"/>`
).join('');

// ---- 内环（逆转细层）----
// 内莲：九枚反向小瓣 + 细九芒 {9/6}（即倒写三三角）
const lotusInner9 = Array.from({ length: 9 }, (_, i) =>
  `<path class="a-poly a-faint" d="${petalPath(i * 40, 468, 540, 13)}"/>`
).join('');
const nonagramInner = beadStroke(starPolylines(9, 6, 442, 0), 22, 0.22);
const ring430 = `<circle class="a-ring a-thin" r="414"/>`;
const beads54 = ringUses([{ id: 'bead-border' }], 356, 54, { scaleCycle: [1] });
// 最内环：与雷纹线同工艺——以雷纹2号沿正六十边形密铺成环
const ring300 = beadStroke(starPolylines(60, 1, 300, 0), 26, 0.2);

// ---- 定核（不转）----
// 双九边形偏轴交叠（雷纹2号密铺）+ 太极巫字镇心
const corePoly = beadStroke(starPolylines(9, 1, 236, 0), 18, 0.22) +
  beadStroke(starPolylines(9, 1, 236, 20), 18, 0.22);
const core = `
  <g class="a-taiji"><use href="#taiji" transform="scale(1.15)"/></g>
  <image
    class="a-wu-img"
    href="${base}/巫字-gold.png"
    x="-70" y="-70" width="140" height="140"
    preserveAspectRatio="xMidYMid meet"
  />`;
---

<svg
  class="array-bg"
  viewBox="0 0 2000 2000"
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
>
  <defs>
    <Taiji />
    <image id="lei-1" href={`${base}/leiwen/1-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-2" href={`${base}/leiwen/2-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-3" href={`${base}/leiwen/3-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-4" href={`${base}/leiwen/4-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-5" href={`${base}/leiwen/5-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-6" href={`${base}/leiwen/6-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-7" href={`${base}/leiwen/7-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-8" href={`${base}/leiwen/8-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-9" href={`${base}/leiwen/9-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-10" href={`${base}/leiwen/10-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-11" href={`${base}/leiwen/11-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-12" href={`${base}/leiwen/12-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-13" href={`${base}/leiwen/13-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-14" href={`${base}/leiwen/14-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-15" href={`${base}/leiwen/15-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-16" href={`${base}/leiwen/16-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    <image id="lei-17" href={`${base}/leiwen/17-gold.png`} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
  </defs>

  <g transform="translate(1000 1000)">
    <!-- 结构层：原 .array-layer 的整体 opacity 0.75 压暗移入此处，结构观感与旧版完全一致 -->
    <g class="array-body" {...(structureDim > 0 ? { opacity: structureDim } : {})}>
      <!-- 外环：顺时针缓转（结构层） -->
      <g class="a-rotate-cw">
        <g class="a-dim">
          <g set:html={ring950} />
          <g set:html={nonagramWeb} />
          <g set:html={nodes9} />
        </g>
        <circle class="a-sheen" r="932" />
      </g>

      <!-- 中环：逆时针缓转（结构层） -->
      <g class="a-rotate-ccw">
        <g class="a-dim">
          <g set:html={lotus9} />
        </g>
        <circle class="a-sheen2" r="668" />
      </g>

      <!-- 内环：逆转细层（结构层） -->
      <g class="a-rotate-cw">
        <g class="a-dim">
          <g set:html={lotusInner9} />
          <g set:html={nonagramInner} />
          <g set:html={ring430} />
          <g set:html={beads54} />
          <g set:html={ring300} />
        </g>
      </g>

      <!-- 六道符文环的轨道线：留在压暗层内随各自环向转动（.a-track 不透明度已补偿） -->
      <g class="a-rotate-cw"><g class="a-track" set:html={track0} /></g>
      <g class="a-rotate-ccw"><g class="a-track" set:html={track1} /></g>
      <g class="a-rotate-cw"><g class="a-track" set:html={track2} /></g>
      <g class="a-rotate-ccw"><g class="a-track" set:html={track3} /></g>
      <g class="a-rotate-cw"><g class="a-track" set:html={track4} /></g>
      <g class="a-rotate-ccw"><g class="a-track" set:html={track5} /></g>

      <!-- 定核：不转；雷纹线九边暗、巫字太极亮 -->
      <g class="a-dim" set:html={corePoly} />
      <g class="a-bright" set:html={core} />
    </g>

    <!-- 六道符文环：相邻两两顺逆交替（cw / ccw 交替）。
         不参与整体压暗，走 .a-rune（与中心树同滤镜链、同源色），
         渲染色与树亮金一致 ≈ rgb(240,224,176)）。 -->
    <g class="a-rotate-cw"><g class="a-bright a-rune" set:html={lei0} /></g>
    <g class="a-rotate-ccw"><g class="a-bright a-rune" set:html={lei1} /></g>
    <g class="a-rotate-cw"><g class="a-bright a-rune" set:html={lei2} /></g>
    <g class="a-rotate-ccw"><g class="a-bright a-rune" set:html={lei3} /></g>
    <g class="a-rotate-cw"><g class="a-bright a-rune" set:html={lei4} /></g>
    <g class="a-rotate-ccw"><g class="a-bright a-rune" set:html={lei5} /></g>
  </g>
</svg>
