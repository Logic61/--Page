---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const faqs = [
  {
    q: '什么是修炼？',
    a: '修炼并非离开日常生活去追逐奇谈，而是在正常生活中不断锻炼身心、磨炼心性。先把工作、家庭与身体安顿好，才谈得上长期修习。',
  },
  {
    q: '什么是音诀（咒音）？',
    a: '音诀又称咒音，属于咒法的一种。通过不同音诀的发出，带动内在振动，用以调养身心、锻炼神形。',
  },
  {
    q: '咒音和宗教咒语是一回事吗？',
    a: '二者同属广义咒法，却有不同的形式与作用。音诀多为单音节发声，重在声音本身；宗教咒语则更重视文字含义与信仰语境。',
  },
  {
    q: '为什么强调长期与生活基础？',
    a: '修习不是一时兴起。稳定工作、正常生活、持续投入与耐心，都是走得长远的前提。好高骛远、急于求成，往往难以得其门径。',
  },
  {
    q: '没有师承，能否只靠自悟？',
    a: '道贵师传，法贵专精。读书与思考可以帮助入门，却不能代替长期的印证与规范的引导。得到一法之后，也应专心而行，不可随意增减、自作聪明。',
  },
  {
    q: '为什么自古以来，修炼之事常人难知？',
    a: '古代阶层分明，许多法门本就掌握在少数人手中。后来传承又转为隐传、密传、师寻徒传，加之修习需要时间、财力与机缘，因而常人难以得见。',
  },
  {
    q: '课程与传授有什么次序？',
    a: '课程分为基础、特殊与进阶层级。先打好根基，再循序深入；不求一步登天，也不把一时的感觉当作成就。',
  },
  {
    q: '报名之前应先确认什么？',
    a: '先通读报名要求，确认自己有时间、有耐心，也能踏实面对长期练习。想清楚后再联系，切勿因一时好奇或焦虑而仓促决定。',
  },
];
---

<section class="faq" id="wenda">
  <div class="wrap">
    <header class="s-head reveal">
      <div class="title-row">
        <span class="eyebrow">修炼问答</span>
        <h2 class="section-title">常见疑问</h2>
      </div>
      <div class="rule"></div>
    </header>

    <div class="faq-list">
      {
        faqs.map((f, i) => (
          <details class={['faq-item', 'reveal'].join(' ')}>
            <summary>
              <span class="faq-num kai">{('壹贰叁肆伍陆柒捌玖拾')[i]}</span>
              <span class="faq-q">{f.q}</span>
              <span class="faq-ico" aria-hidden="true"></span>
            </summary>
            <div class="faq-a">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>

    <p class="faq-more reveal">
      继续阅读<a href={`${base}/kecheng`}>课程准备</a>与<a href={`${base}/baoming`}>报名说明</a>。
    </p>
  </div>
</section>

<style>
  .faq {
    border-top: 1px solid var(--ink-line);
  }

  .faq-list {
    border-top: 1px solid var(--ink-line);
  }

  .faq-item {
    border-bottom: 1px solid var(--ink-line);
  }

  .faq-item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 1.3rem;
    padding: 1.5rem 0.5rem;
    transition: padding-left 0.4s var(--ease-soft);
    user-select: none;
  }

  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary:hover {
    padding-left: 1rem;
  }

  .faq-num {
    color: var(--cinnabar);
    font-size: 1.2rem;
    min-width: 2.2rem;
  }

  .faq-q {
    font-family: var(--font-kai);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    letter-spacing: 0.12em;
    color: var(--heading);
  }

  .faq-ico {
    margin-left: auto;
    width: 14px;
    height: 14px;
    position: relative;
    flex: none;
  }

  .faq-ico::before,
  .faq-ico::after {
    content: '';
    position: absolute;
    background: var(--bronze-dim);
    transition: transform 0.4s var(--ease-soft), background 0.3s;
  }

  .faq-ico::before {
    width: 14px;
    height: 1px;
    top: 6.5px;
  }

  .faq-ico::after {
    width: 1px;
    height: 14px;
    left: 6.5px;
  }

  .faq-item[open] summary .faq-ico::after {
    transform: scaleY(0);
  }

  .faq-item[open] summary .faq-ico::before {
    background: var(--cinnabar-bright);
  }

  .faq-a {
    padding: 0 0.5rem 1.8rem 3.5rem;
  }

  .faq-a p {
    color: var(--bone-dim);
    max-width: 46em;
    line-height: 2.15;
    font-size: 0.96rem;
  }

  .faq-more {
    margin-top: 2rem;
    text-align: center;
    color: var(--bone-faint);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
  }

  .faq-more a {
    color: var(--bronze);
    border-bottom: 1px solid var(--bronze-dim);
  }
</style>
