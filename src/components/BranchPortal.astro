---
interface Props {
  glyph: string;
  title: string;
  subtitle: string;
  description: string;
}

const { glyph, title, subtitle, description } = Astro.props;
---

<article class="branch-portal">
  <div class="branch-wrap">
    <header class="portal-hero">
      <span class="portal-glyph zhuan" aria-hidden="true">{glyph}</span>
      <p class="portal-kicker kai">一脉一门</p>
      <h1 class="kai">{title}</h1>
      <p class="portal-subtitle">{subtitle}</p>
    </header>
    <section class="portal-reading" aria-labelledby="portal-reading-title">
      <p id="portal-reading-title" class="portal-label kai">分脉提要</p>
      <p>{description}</p>
    </section>
    <section class="portal-note" aria-label="内容说明">
      <span class="portal-note-mark" aria-hidden="true"></span>
      <p>此支内容尚在整理，后续篇章将在此展开。</p>
    </section>
  </div>
</article>

<style>
  .branch-portal { position: relative; z-index: 1; padding: clamp(4.5rem, 10vw, 9rem) 0 clamp(5rem, 10vw, 9rem); }
  .branch-wrap { width: min(100% - 3rem, 72rem); margin-inline: auto; }
  .portal-hero { display: grid; grid-template-columns: auto 1fr; column-gap: clamp(1.4rem, 4vw, 3.5rem); align-items: end; padding-bottom: clamp(3rem, 6vw, 5rem); border-bottom: 1px solid color-mix(in srgb, var(--branch-accent) 35%, transparent); }
  .portal-glyph { grid-row: 1 / span 3; color: transparent; -webkit-text-stroke: 1px var(--branch-accent); font-size: clamp(7rem, 17vw, 13rem); line-height: 0.7; text-shadow: 0 0 34px color-mix(in srgb, var(--branch-accent) 22%, transparent); }
  .portal-kicker, .portal-label { color: var(--branch-accent); font-size: 0.78rem; letter-spacing: 0.54em; }
  .portal-hero h1 { margin-top: 0.5rem; color: #eee5d3; font-size: clamp(2.5rem, 6vw, 5.2rem); line-height: 1.2; letter-spacing: 0.28em; }
  .portal-subtitle { margin-top: 0.9rem; color: #938a76; font-size: 0.9rem; letter-spacing: 0.3em; }
  .portal-reading { width: min(100%, 48rem); margin: clamp(3.5rem, 8vw, 7rem) 0 0 auto; }
  .portal-reading > p:last-child { margin-top: 1.2rem; color: #c1b8a7; font-size: clamp(1rem, 1.5vw, 1.12rem); line-height: 2.25; }
  .portal-note { display: flex; gap: 1rem; width: min(100%, 48rem); margin: clamp(3rem, 6vw, 5rem) 0 0 auto; padding-top: 1.2rem; border-top: 1px solid color-mix(in srgb, var(--branch-accent) 25%, transparent); color: #847b68; font-size: 0.9rem; line-height: 2; }
  .portal-note-mark { width: 0.48rem; height: 0.48rem; flex: none; margin-top: 0.7rem; border: 1px solid var(--branch-accent); transform: rotate(45deg); }
  @media (max-width: 640px) { .branch-wrap { width: min(100% - 2.2rem, 72rem); } .portal-hero { column-gap: 1rem; } .portal-glyph { font-size: 6.3rem; } .portal-subtitle { letter-spacing: 0.17em; } }
</style>
