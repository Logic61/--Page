---
interface Props {
  glyph: string;
  title: string;
  subtitle: string;
  description: string;
}

// 页内不再自设动作行：一脉三页的前后跳转统一由 BranchSteps 在页底给两个去处
const { glyph, title, subtitle, description } = Astro.props;
---

<article class="branch-portal">
  <div class="branch-wrap">
    <header class="portal-hero">
      <span class="portal-glyph zhuan" aria-hidden="true">{glyph}</span>
      <p class="portal-kicker kai">一脉一门</p>
      <h1 class="kai">{title}</h1>
      <p class="portal-subtitle">{subtitle}</p>
    </header>
    <section class="portal-reading" aria-labelledby="portal-reading-title">
      <p id="portal-reading-title" class="portal-label kai">分脉提要</p>
      <p>{description}</p>
    </section>
  </div>
</article>

<style>
  .branch-portal { position: relative; z-index: 1; padding: clamp(4.5rem, 10vw, 9rem) 0 clamp(2.6rem, 5vw, 4rem); }
  .branch-wrap { width: min(100% - 3rem, 48rem); margin-inline: auto; }
  .portal-hero { display: grid; grid-template-columns: auto 1fr; column-gap: clamp(1.4rem, 4vw, 3.5rem); align-items: end; padding-bottom: clamp(3rem, 6vw, 5rem); border-bottom: 1px solid color-mix(in srgb, var(--branch-accent) 35%, transparent); }
  .portal-glyph { grid-row: 1 / span 3; color: transparent; -webkit-text-stroke: 1.9px color-mix(in srgb, var(--branch-accent) 38%, #fff8e6); font-size: clamp(7rem, 17vw, 13rem); line-height: 0.7; text-shadow: 0 0 34px color-mix(in srgb, var(--branch-accent) 22%, transparent); }
  .portal-kicker, .portal-label { color: color-mix(in srgb, var(--branch-accent) 66%, #f4ead4); font-size: 0.78rem; letter-spacing: 0.54em; }
  .portal-hero h1 { margin-top: 0.5rem; color: #f8f3e9; font-size: clamp(2.5rem, 6vw, 5.2rem); line-height: 1.2; letter-spacing: 0.28em; }
  .portal-subtitle { margin-top: 0.9rem; color: #e0d8c8; font-size: 0.9rem; letter-spacing: 0.3em; }
  .portal-reading { width: min(100%, 48rem); margin: clamp(3.5rem, 8vw, 7rem) auto 0; }
  .portal-reading > p:last-child { margin-top: 1.2rem; color: #f0ebdf; font-size: clamp(1rem, 1.5vw, 1.12rem); line-height: 2.25; }
  @media (max-width: 640px) { .branch-wrap { width: min(100% - 2.2rem, 48rem); } .portal-hero { column-gap: 1rem; } .portal-glyph { font-size: 6.3rem; } .portal-subtitle { letter-spacing: 0.17em; } }
</style>
