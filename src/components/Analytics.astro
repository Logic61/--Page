---
/**
 * 访问统计（GoatCounter + MapMyVisitors）：配置见 src/data/analytics.ts。
 *
 * GoatCounter：脚本自托管（public/count.js）而非官方 CDN：实测国内网络访问 gc.zgo.at
 * 连接超时（DNS 亦被干扰），脚本加载不出来则统计完全失效；
 * 自托管文件与官方分发逐字节一致（9213 字节，
 * sha256 792b7abd26c1fb6ae62906833e09a301251e2641816e69e4f95aba518f3fe3f0，
 * 2026-10-09 自 gc.zgo.at 与官方仓库双向核对），如需升级照此重取即可。
 * 上报端点 https://<站点>.goatcounter.com/count 国内可达，不受影响。
 *
 * MapMyVisitors：页面加载一次其 widget_call_home.js 即完成计数（服务端按 IP
 * 定位到城市），响应弃用——不渲染它的地图、不加载它的 jQuery/jVectorMap。
 * 城市数据由每日快照取回（scripts/snapshot-cities.mjs），画在首页访客星图。
 * 带时间戳参数绕开浏览器缓存，保证每次页面访问都真正请求一次。
 *
 * 仅在正式构建且填了相应配置时输出；本地开发不加载，
 * 避免开发预览的访问混进统计（信标另有本地域名守卫，防预览点击计数）。
 */
import { analytics } from '../data/analytics';

// 站点代码容错：去空格、转小写（填成 LOGIC 之类也能正常工作）
const site = analytics.goatcounterSite.trim().toLowerCase();
const mmvKey = analytics.mapmyvisitorsWidgetKey.trim();
const on = import.meta.env.PROD && Boolean(site);
const mmvOn = import.meta.env.PROD && Boolean(mmvKey);
// BASE_URL 未必以斜杠结尾（base 为 /--Page 时就没有），先归一化再拼
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const mmvBeacon = `(function(){try{var h=location.hostname;if(!h||h==='localhost'||h==='127.0.0.1'||/^(192\\.168\\.|10\\.|172\\.(1[6-9]|2\\d|3[01])\\.)/.test(h))return}catch(e){}fetch('https://mapmyvisitors.com/widget_call_home.js?cl=ffffff&w=300&t=n&d=${mmvKey}&r='+Date.now(),{mode:'no-cors',cache:'no-store',credentials:'omit'}).catch(function(){})})();`;
---

{
  on && (
    <script
      is:inline
      async
      src={`${base}/count.js`}
      data-goatcounter={`https://${site}.goatcounter.com/count`}
    />
  )
}

{mmvOn && <script is:inline set:html={mmvBeacon} />}
