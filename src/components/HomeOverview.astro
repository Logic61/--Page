---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const items = [
  { href: '/yuanqi', num: '壹', title: '认识巫祝', sub: '源流 · 体系', desc: '从史、祝、卜的分工读起，了解巫祝的历史叙述、祭祀体系与巫医体系。' },
  { href: '/zhufa', num: '贰', title: '祝法养生', sub: '音诀 · 日常', desc: '辨析祝祷、祝由与音诀的不同，并从日常可实践的养生习惯开始。' },
  { href: '/chuancheng', num: '叁', title: '传承修习', sub: '背景 · 判断', desc: '阅读传承叙述，理解为何修习重视耐心、边界与长期的生活基础。' },
  { href: '/kecheng', num: '肆', title: '课程准备', sub: '路径 · 要求', desc: '查看课程层级、学习前的准备与不适合参与的情况，再决定是否继续了解。' },
  { href: '/wenda', num: '伍', title: '修习问答', sub: '基础 · 辨析', desc: '从基础认识、练习原则、传承与辨别三个主题，逐步厘清常见问题。' },
  { href: '/baoming', num: '陆', title: '报名说明', sub: '流程 · 敬告', desc: '了解报名流程与联系入口。阅读完前序内容后，再作决定。' },
];
---

<section class="overview">
  <div class="wrap">
    <header class="s-head reveal">
      <div class="title-row">
        <span class="eyebrow">阅读导览</span>
        <h2 class="section-title">从认识到决定</h2>
      </div>
      <div class="rule"></div>
    </header>

    <ul class="gate">
      {
        items.map((it, i) => (
          <li class="reveal" data-d={String((i % 4) + 2)}>
            <a href={`${base}${it.href}`} class="gate-row">
              <span class="gate-num kai">{it.num}</span>
              <span class="gate-title kai">{it.title}</span>
              <span class="gate-sub">{it.sub}</span>
              <span class="gate-desc">{it.desc}</span>
              <span class="gate-arrow" aria-hidden="true"></span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .overview {
    border-top: 1px solid var(--ink-line);
  }

  .gate {
    list-style: none;
    border-top: 1px solid var(--ink-line);
  }

  .gate-row {
    display: grid;
    grid-template-columns: 3.4rem 5.5rem 7rem 1fr 1.6rem;
    align-items: baseline;
    gap: 1.2rem;
    padding: 1.5rem 0.6rem;
    border-bottom: 1px solid var(--ink-line);
    transition: background 0.4s var(--ease-soft), padding-left 0.4s var(--ease-soft);
  }

  .gate-row:hover {
    background: linear-gradient(90deg, rgba(178, 58, 44, 0.06), transparent 70%);
    padding-left: 1.2rem;
  }

  .gate-num {
    font-size: 1.4rem;
    color: var(--cinnabar);
    letter-spacing: 0.1em;
  }

  .gate-title {
    font-size: 1.35rem;
    letter-spacing: 0.2em;
    color: var(--heading);
  }

  .gate-sub {
    font-size: 0.8rem;
    letter-spacing: 0.26em;
    color: var(--bronze);
  }

  .gate-desc {
    font-size: 0.9rem;
    color: var(--bone-dim);
    line-height: 1.9;
    max-width: 34em;
  }

  .gate-arrow {
    position: relative;
    width: 16px;
    height: 16px;
  }

  .gate-arrow::before,
  .gate-arrow::after {
    content: '';
    position: absolute;
    background: var(--bronze-dim);
    transition: background 0.3s, transform 0.4s var(--ease-soft);
  }

  .gate-arrow::before {
    width: 14px;
    height: 1px;
    top: 7px;
    left: 0;
  }

  .gate-arrow::after {
    width: 8px;
    height: 8px;
    top: 3.5px;
    left: 6px;
    border-right: 1px solid var(--bronze-dim);
    border-bottom: 1px solid var(--bronze-dim);
    transform: rotate(-45deg);
  }

  .gate-row:hover .gate-arrow::before,
  .gate-row:hover .gate-arrow::after {
    background: var(--cinnabar-bright);
    border-color: var(--cinnabar-bright);
  }

  @media (max-width: 820px) {
    .gate-row {
      grid-template-columns: 2.6rem 1fr 1.4rem;
      row-gap: 0.4rem;
    }
    .gate-sub { grid-column: 2; }
    .gate-desc { grid-column: 2; }
    .gate-arrow { grid-column: 3; grid-row: 1; }
  }
</style>
