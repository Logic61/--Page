---
// 流带背景 v2 —— 流淌的丝带
// 设计：四条柔光丝带沿视口四周流淌（上、下、左、右各一条），不穿过中央内容区。
// 带身 = 暗金 + 分支主题色混合的「发光丝带」：中心最亮、向两侧晕散（三层同形多边形 + 高斯柔化）。
// 带中沿弧长等距排布 16 枚雷文符文（与法门总览页的雷纹环同源：public/leiwen/1..16-gold.png），
// 按 1→16 循环交替，并由脚本驱动沿带子方向持续流动；另有一道高光沿带滑过。
// 尊重 prefers-reduced-motion：停掉所有动画、符文停在初始位；无 JS 时符文也静止可见。
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const P = (x, y) => ({ x, y });

function cubicPoint(p0, p1, p2, p3, t) {
  const mt = 1 - t;
  const x = mt * mt * mt * p0.x + 3 * mt * mt * t * p1.x + 3 * mt * t * t * p2.x + t * t * t * p3.x;
  const y = mt * mt * mt * p0.y + 3 * mt * mt * t * p1.y + 3 * mt * t * t * p2.y + t * t * t * p3.y;
  const dx = 3 * mt * mt * (p1.x - p0.x) + 6 * mt * t * (p2.x - p1.x) + 3 * t * t * (p3.x - p2.x);
  const dy = 3 * mt * mt * (p1.y - p0.y) + 6 * mt * t * (p2.y - p1.y) + 3 * t * t * (p3.y - p2.y);
  return { x, y, dx, dy };
}

function sampleCurve(segs, n) {
  const total = segs.length * n;
  const pts = [];
  for (let i = 0; i <= total; i++) {
    const t = (i / total) * segs.length;
    const seg = Math.min(segs.length - 1, Math.floor(t));
    pts.push(cubicPoint(segs[seg][0], segs[seg][1], segs[seg][2], segs[seg][3], t - seg));
  }
  return pts;
}

// 符文「立姿」角：沿带切线 +90°（符文正面朝向带外），再归一化到 ±90°，
// 保证横带上的符文大体直立、竖带上的符文不颠倒，读起来像沿带排列的篆刻铭文
function uprightAng(dx, dy) {
  let a = (Math.atan2(dy, dx) * 180) / Math.PI + 90;
  while (a > 180) a -= 360;
  while (a < -180) a += 360;
  if (a > 90) a -= 180; else if (a < -90) a += 180;
  return a;
}

// 沿折线按弧长定位（构建期与运行期共用同一套逻辑）
function posAt(pts, cum, s) {
  let lo = 1, hi = cum.length - 1;
  while (lo < hi) {
    const m = (lo + hi) >> 1;
    if (cum[m] < s) lo = m + 1; else hi = m;
  }
  const i = lo;
  const seg = cum[i] - cum[i - 1] || 1;
  let t = (s - cum[i - 1]) / seg;
  if (t < 0) t = 0; else if (t > 1) t = 1;
  const a = pts[i - 1], b = pts[i];
  return {
    x: a.x + (b.x - a.x) * t,
    y: a.y + (b.y - a.y) * t,
    dx: a.dx + (b.dx - a.dx) * t,
    dy: a.dy + (b.dy - a.dy) * t,
  };
}

// 16 枚雷文符文：与法门总览页的雷纹环同源，按 1→16 循环交替
const LEI16 = Array.from({ length: 16 }, (_, i) => i + 1);
const MOTIF_IDS = LEI16.map((n) => 'fr-lei-' + n);

function buildRibbon({ segs, wMax, wMin, spacing, scale, orderOffset, speed, dashDir = 1, minor = false }) {
  const pts = sampleCurve(segs, 200);
  const n = pts.length - 1;
  const cum = new Array(pts.length);
  cum[0] = 0;
  for (let i = 1; i < pts.length; i++) cum[i] = cum[i - 1] + Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y);
  const totalLen = cum[n];

  const f = (v) => v.toFixed(1);
  const wOf = (t) => wMin + (wMax - wMin) * Math.pow(Math.sin(Math.PI * t), 0.7);

  // 三层同形多边形：full / mid / core，宽度递减，叠出「中心亮、边缘晕散」的丝光带身
  const buildLayer = (mult) => {
    const top = [];
    const bottom = [];
    for (let i = 0; i <= n; i++) {
      const p = pts[i];
      const t = i / n;
      const len = Math.hypot(p.dx, p.dy) || 1;
      const nx = -p.dy / len;
      const ny = p.dx / len;
      const w = (wOf(t) * mult) / 2;
      top.push(f(p.x + nx * w) + ' ' + f(p.y + ny * w));
      bottom.push(f(p.x - nx * w) + ' ' + f(p.y - ny * w));
    }
    return 'M ' + top.join(' L ') + ' L ' + bottom.reverse().join(' L ') + ' Z';
  };

  const line = 'M ' + pts.map((p) => f(p.x) + ' ' + f(p.y)).join(' L ');

  // 符文槽位：沿弧长等距；两端留出半间距（两端在视口外，回绕不可见）
  const slots = [];
  let s = spacing * 0.55;
  while (s < totalLen - spacing * 0.45) {
    slots.push(Math.round(s * 10) / 10);
    s += spacing;
  }

  // 高光沿带滑过：dash 周期 200，速度约 70 设计单位/秒
  const period = 200;
  const cycles = Math.ceil(totalLen / period) + 2;
  const cyclePx = cycles * period;
  const dur = Math.max(8, cyclePx / 70);

  // 初始（相位 0）符文排布：无 JS / reduced-motion 时就是最终样子
  const uses = slots
    .map((s0, k) => {
      const p = posAt(pts, cum, s0);
      const t = s0 / totalLen;
      const wLocal = wOf(t);
      const alpha = 0.18 + 0.72 * (wLocal / wMax);
      const ang = uprightAng(p.dx, p.dy);
      const id = MOTIF_IDS[(k + orderOffset) % MOTIF_IDS.length];
      return '<use class="fr-rune" href="#' + id + '" transform="translate(' + p.x.toFixed(1) + ' ' + p.y.toFixed(1) + ') rotate(' + ang.toFixed(1) + ') scale(' + scale + ')" opacity="' + alpha.toFixed(2) + '"/>';
    })
    .join('');

  return {
    body: buildLayer(1),
    mid: buildLayer(0.62),
    core: buildLayer(0.3),
    line,
    uses,
    minor: !!minor,
    // 运行期数据（序列化为 JSON 交给页面脚本）
    xs: pts.map((p) => f(p.x)),
    ys: pts.map((p) => f(p.y)),
    dxs: pts.map((p) => f(p.dx)),
    dys: pts.map((p) => f(p.dy)),
    cum: cum.map((v) => f(v)),
    slots,
    L: totalLen,
    wMax,
    wMin,
    speed,
    scale,
    orderOffset,
    sheen: {
      dash: '20 180',
      dur: dur.toFixed(1),
      from: dashDir > 0 ? 0 : -cyclePx,
      to: dashDir > 0 ? -cyclePx : 0,
    },
  };
}

// 四条丝带绕视口四周，中央内容区留白：
// A 下带（主带）· B 上带 · C 左丝线 · D 右丝线；B/D 逆向流动，形成回环
const ribbons = [
  buildRibbon({
    segs: [
      [P(-80, 1120), P(220, 980), P(480, 910), P(780, 830)],
      [P(780, 830), P(1100, 750), P(1400, 720), P(1680, 680)],
    ],
    wMax: 58, wMin: 10, spacing: 92, scale: 0.42, orderOffset: 0, speed: 22, dashDir: 1,
  }),
  buildRibbon({
    segs: [
      [P(-80, 180), P(200, 130), P(480, 120), P(720, 150)],
      [P(720, 150), P(1000, 180), P(1320, 200), P(1680, 240)],
    ],
    wMax: 34, wMin: 8, spacing: 62, scale: 0.28, orderOffset: 5, speed: -18, dashDir: -1,
  }),
  buildRibbon({
    segs: [
      [P(60, -80), P(100, 140), P(40, 380), P(85, 600)],
      [P(85, 600), P(130, 820), P(100, 980), P(120, 1120)],
    ],
    wMax: 22, wMin: 6, spacing: 56, scale: 0.16, orderOffset: 9, speed: 14, dashDir: 1, minor: true,
  }),
  buildRibbon({
    segs: [
      [P(1550, -80), P(1510, 140), P(1560, 380), P(1525, 600)],
      [P(1525, 600), P(1490, 820), P(1520, 980), P(1500, 1120)],
    ],
    wMax: 18, wMin: 5, spacing: 46, scale: 0.13, orderOffset: 13, speed: -12, dashDir: -1, minor: true,
  }),
];

const runData = ribbons.map((r) => ({
  xs: r.xs, ys: r.ys, dxs: r.dxs, dys: r.dys, cum: r.cum,
  slots: r.slots, L: Math.round(r.L * 10) / 10,
  wMax: r.wMax, wMin: r.wMin, speed: r.speed, scale: r.scale, offset: r.orderOffset,
}));
---

<svg class="flow-ribbons" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    {LEI16.map((n) => (
      <image id={'fr-lei-' + n} href={base + '/leiwen/' + n + '-gold.png'} x="-50" y="-50" width="100" height="100" preserveAspectRatio="xMidYMid meet" />
    ))}
  </defs>

  {ribbons.map((r, i) => (
    <g
      class:list={['fr-band', { 'fr-minor': r.minor }]}
      style={'--fr-from:' + r.sheen.from + ';--fr-to:' + r.sheen.to + ';--fr-dur:' + r.sheen.dur + 's;--fr-dash:' + r.sheen.dash}
    >
      <g class="fr-layers">
        <path class="fr-fill" d={r.body} />
        <path class="fr-fill fr-mid" d={r.mid} />
        <path class="fr-fill fr-core" d={r.core} />
      </g>
      <path class="fr-line" d={r.line} />
      <g class="fr-runes" data-ribbon={i} set:html={r.uses} />
      <path class="fr-sheen" d={r.line} />
    </g>
  ))}
</svg>

<script type="application/json" id="fr-data">{JSON.stringify(runData)}</script>
<script>
  (function () {
    var dataEl = document.getElementById('fr-data');
    if (!dataEl) return;
    var DATA;
    try { DATA = JSON.parse(dataEl.textContent); } catch (e) { return; }
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var svg = document.querySelector('.flow-ribbons');
    if (!svg || !window.requestAnimationFrame) return;

    var ribbons = DATA.map(function (r, i) {
      return {
        data: r,
        phase: 0,
        nodes: Array.prototype.slice.call(svg.querySelectorAll('.fr-runes[data-ribbon="' + i + '"] .fr-rune')),
      };
    });

    function posAt(r, s) {
      var cum = r.cum, n = cum.length - 1;
      var lo = 1, hi = n;
      while (lo < hi) {
        var m = (lo + hi) >> 1;
        if (cum[m] < s) lo = m + 1; else hi = m;
      }
      var i = lo;
      var seg = cum[i] - cum[i - 1] || 1;
      var t = (s - cum[i - 1]) / seg;
      if (t < 0) t = 0; else if (t > 1) t = 1;
      return {
        x: r.xs[i - 1] + (r.xs[i] - r.xs[i - 1]) * t,
        y: r.ys[i - 1] + (r.ys[i] - r.ys[i - 1]) * t,
        dx: r.dxs[i - 1] + (r.dxs[i] - r.dxs[i - 1]) * t,
        dy: r.dys[i - 1] + (r.dys[i] - r.dys[i - 1]) * t,
      };
    }

    var last = null;
    function frame(now) {
      if (last === null) last = now;
      var dt = Math.min((now - last) / 1000, 0.05);
      last = now;

      for (var i = 0; i < ribbons.length; i++) {
        var rb = ribbons[i], r = rb.data;
        rb.phase = (rb.phase + r.speed * dt) % r.L;
        if (rb.phase < 0) rb.phase += r.L;

        for (var k = 0; k < rb.nodes.length; k++) {
          var s = (r.slots[k] + rb.phase) % r.L;
          if (s < 0) s += r.L;
          var p = posAt(r, s);
          var t = s / r.L;
          var w = r.wMin + (r.wMax - r.wMin) * Math.pow(Math.sin(Math.PI * t), 0.7);
          var alpha = 0.18 + 0.72 * (w / r.wMax);
          var ang = Math.atan2(p.dy, p.dx) * 180 / Math.PI + 90;
          while (ang > 180) ang -= 360;
          while (ang < -180) ang += 360;
          if (ang > 90) ang -= 180; else if (ang < -90) ang += 180;
          rb.nodes[k].setAttribute(
            'transform',
            'translate(' + p.x.toFixed(1) + ' ' + p.y.toFixed(1) + ') rotate(' + ang.toFixed(1) + ') scale(' + r.scale + ')'
          );
          rb.nodes[k].setAttribute('opacity', alpha.toFixed(2));
        }
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  })();
</script>

<style is:global>
  /* 流带：暗底上的柔光丝带，中心亮、两侧晕散；符文与高光沿带流动，整体压低不抢内容 */
  .flow-ribbons {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    --fr-tint: var(--branch-accent, #c9a55e);
  }

  .flow-ribbons .fr-band { pointer-events: none; }

  /* 左右两条细丝线：整体再压暗半档，只作收边不作主角 */
  .flow-ribbons .fr-band.fr-minor { opacity: 0.85; }
  .flow-ribbons .fr-band.fr-minor .fr-runes { opacity: 0.38; }

  /* 三层同形多边形叠成丝光带身，柔化边缘 */
  .flow-ribbons .fr-layers {
    filter: blur(5px);
    animation: frBreathe 11s ease-in-out infinite alternate;
  }
  .flow-ribbons .fr-fill { fill: color-mix(in srgb, var(--fr-tint) 30%, rgba(201, 165, 94, 0.05)); }
  .flow-ribbons .fr-fill.fr-mid { fill: color-mix(in srgb, var(--fr-tint) 34%, rgba(218, 186, 112, 0.09)); }
  .flow-ribbons .fr-fill.fr-core { fill: color-mix(in srgb, var(--fr-tint) 38%, rgba(238, 210, 148, 0.15)); }

  .flow-ribbons .fr-line {
    fill: none;
    stroke: color-mix(in srgb, var(--fr-tint) 26%, rgba(244, 222, 170, 0.24));
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /* 符文：鎏金雷纹，压暗一档，嵌在带身中 */
  .flow-ribbons .fr-runes { opacity: 0.55; }
  .flow-ribbons .fr-rune { filter: brightness(0.94) saturate(0.9); }

  /* 高光沿带滑过 */
  .flow-ribbons .fr-sheen {
    fill: none;
    stroke: color-mix(in srgb, var(--fr-tint) 20%, rgba(250, 232, 184, 0.5));
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: var(--fr-dash, 20 180);
    opacity: 0.5;
    animation: frFlow var(--fr-dur, 26s) linear infinite;
  }

  @keyframes frFlow {
    from { stroke-dashoffset: var(--fr-from, 0); }
    to { stroke-dashoffset: var(--fr-to, -2200); }
  }

  @keyframes frBreathe {
    from { opacity: 0.9; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-ribbons .fr-sheen,
    .flow-ribbons .fr-layers { animation: none; }
    .flow-ribbons .fr-sheen { opacity: 0.28; }
  }

  @media (max-width: 640px) {
    .flow-ribbons { opacity: 0.85; }
    .flow-ribbons .fr-layers { filter: blur(4px); }
  }
</style>
