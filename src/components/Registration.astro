---
import Zl from './Zl.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const steps = [
  { num: '壹', numEn: 'I', title: '加群交流', titleEn: 'Join the Group', text: '加入群聊满一月，时常交流，相互了解。', textEn: 'Join the group chat for a full month; talk often; come to know one another.' },
  { num: '贰', numEn: 'II', title: '通读文件', titleEn: 'Read the Documents', text: '通读群内文件，明白、了解修炼之目的。', textEn: 'Read through the group\'s documents and understand the purpose of cultivation.' },
  { num: '叁', numEn: 'III', title: '心诚考察', titleEn: 'Sincerity, Reviewed', text: '真心修行，经考察与双方认同后，方可学习。', textEn: 'Sincere aspiration is required; only after review and mutual acceptance may study begin.' },
  { num: '肆', numEn: 'IV', title: '循序修习', titleEn: 'Practice Step by Step', text: '师父领进门，修行在个人。修法可学，课程不卖。', textEn: 'The master leads you to the gate; the practice is your own. The method may be learned; the course is not for sale.' },
];

const rules = [
  { zh: '自古道法不传外族，报名要求为华夏一族之苗裔。', en: 'Since old, the ways have not been passed beyond the clan; applicants must be of Hua-Xia lineage.' },
  { zh: '有门派宗门者、宗教偏执狂热者，请勿开口。', en: 'Those already belonging to a school or sect, and religious zealots, need not apply.' },
  { zh: '一切内容未经报备、允许，不得外泄（现实、网络，乃至父母亲人也不可）。', en: 'Nothing taught may be disclosed without permission — not in life, not online, not even to parents or kin.' },
  { zh: '修法可学，课程不卖。学员有学习的权利，无归属与传播的权利。', en: 'The method may be learned; the course is not for sale. Students have the right to learn, not to own or to spread.' },
  { zh: '报名请谨慎考虑，一经报名，概不退款、不打折、不调价、不分期。', en: 'Consider carefully before enrolling. Once enrolled: no refunds, no discounts, no price changes, no installments.' },
];
---

<section class="reg" id="baoming">
  <div class="wrap">
    <header class="s-head reveal">
      <div class="title-row">
        <span class="eyebrow"><Zl zh="报名须知" en="Enrollment Notes" /></span>
        <h2 class="section-title"><Zl zh="愿者自来" en="The Willing Come" /></h2>
      </div>
      <div class="rule"></div>
      <p class="sub">
        <Zl
          zh="有意拜师学习者，请踏实工作生活，勿抱侥幸思想。愿者来，不强迫，不强求。"
          en="Those who wish to seek a master and learn: live and work steadily, and hold no thoughts of luck. Those who wish may come — no coercion, no persuasion."
        />
      </p>
    </header>

    <div class="reg-grid">
      <div class="reg-steps reveal">
        <ol class="steps">
          {
            steps.map((s) => (
              <li>
                <span class="step-num kai"><Zl zh={s.num} en={s.numEn} /></span>
                <div>
                  <h3><Zl zh={s.title} en={s.titleEn} /></h3>
                  <p><Zl zh={s.text} en={s.textEn} /></p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="reg-side">
        <div class="reg-qr reveal" data-d="2">
          <div class="qr-frame">
            <img src={`${base}/公众号二维码.jpg`} alt="公众号二维码" data-en-alt="WeChat Official Account QR code" loading="lazy" />
          </div>
          <p><Zl zh="扫码关注 · 联系巫恒先生" en="Scan to follow · Contact Master Wuheng" /></p>
        </div>

        <div class="reg-qr reveal" data-d="3">
          <div class="qr-frame">
            <img src={`${base}/微信好友二维码.png`} alt="个人微信二维码" data-en-alt="Personal WeChat QR code" loading="lazy" />
          </div>
          <p><Zl zh="扫码添加 · 微信好友" en="Scan to add me on WeChat" /></p>
        </div>

        <aside class="reg-disclaim reveal" data-d="4">
          <span class="reg-disclaim-mark zhuan">敬</span>
          <p>
            <Zl
              zh="报名之前，请确认自己了解课程内容、学习节奏与相关要求。愿者自来，不强迫，不强求。"
              en="Before enrolling, be sure you understand the course content, the pace of study, and the requirements. The willing come of their own accord — no coercion, no persuasion."
            />
          </p>
        </aside>
      </div>
    </div>

    <div class="reg-rules reveal">
      <h3 class="reg-rules-title kai"><Zl zh="报名要求" en="Enrollment Requirements" /></h3>
      <ul>
        {
          rules.map((r) => (
            <li>
              <span class="rule-dot"></span>
              <p><Zl zh={r.zh} en={r.en} /></p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .reg {
    border-top: 1px solid var(--ink-line);
  }

  .reg-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .steps {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .steps li {
    display: flex;
    gap: 1.5rem;
    padding: 1.6rem 0.4rem;
    border-top: 1px solid var(--ink-line);
    align-items: flex-start;
  }

  .steps li:first-child { border-top: none; padding-top: 0.4rem; }

  .step-num {
    flex: none;
    font-size: 1.5rem;
    color: var(--cinnabar-ink);
    letter-spacing: 0.15em;
    width: 2.6rem;
    padding-top: 0.2rem;
  }

  .steps h3 {
    font-family: var(--font-kai);
    font-size: 1.3rem;
    letter-spacing: 0.22em;
    color: var(--heading);
    margin-bottom: 0.5rem;
  }

  .steps p {
    color: var(--bone-dim);
    font-size: 0.9rem;
    line-height: 2;
    max-width: 32em;
  }

  .reg-side {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .reg-qr {
    text-align: center;
  }

  .qr-frame {
    display: inline-block;
    border: 1px solid var(--ink-line);
    border-radius: 3px;
    padding: 1rem;
    background: var(--panel-strong);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
  }

  /* contain + 白底：方框内仍是完整白卡观感，且两图比例不同时不会被
     cover 裁掉顶部昵称 / 底部提示字 */
  .qr-frame img {
    width: 180px;
    height: 180px;
    object-fit: contain;
    background: #fff;
  }

  .reg-qr p {
    margin-top: 1rem;
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    color: var(--bone-faint);
  }

  .reg-disclaim {
    border: 1px dashed rgba(178, 58, 44, 0.35);
    border-radius: 3px;
    padding: 1.4rem 1.5rem;
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    background: var(--panel-soft);
  }

  .reg-disclaim-mark {
    font-size: 1.8rem;
    color: var(--cinnabar-ink);
    line-height: 1.4;
  }

  .reg-disclaim p {
    color: var(--bone-faint);
    font-size: 0.84rem;
    line-height: 2.1;
  }

  .reg-rules {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--ink-line);
    padding-top: 2rem;
  }

  .reg-rules-title {
    font-size: 1.3rem;
    letter-spacing: 0.3em;
    color: var(--bronze-bright);
    margin-bottom: 1.4rem;
  }

  .reg-rules ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem 2.5rem;
  }

  .reg-rules li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .rule-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cinnabar);
    margin-top: 0.75em;
  }

  .reg-rules p {
    color: var(--bone-dim);
    font-size: 0.9rem;
    line-height: 1.95;
  }

  @media (max-width: 900px) {
    .reg-grid { grid-template-columns: 1fr; }
    .reg-rules ul { grid-template-columns: 1fr; }
  }

  /* 文本框居中：报名页：题头、步骤、二维码、报名要求同为一列 48em；列内文字仍左对齐 */
  .reg .wrap > * {
    max-width: 48em;
    margin-inline: auto;
  }
</style>
