---
/**
 * 访客星图：世界地图按来客所在逐地亮起，「亮起程度 = 来客多寡」；
 * 中国与美国细化到省州：省州界线常显，来客城市所在的省州点亮（取代整国涂色），
 * 再叠加城市光点（MapMyVisitors 城市级数据）。
 * 构建时静态生成，数据来自 src/data/visits.json、cities.json 与 admin1-cn-us.json ——
 * 前两者由 .github/workflows/visits.yml 每日从 GoatCounter / MapMyVisitors 快照；
 * admin1-cn-us.json 为固定底数据（中国 DataV GeoAtlas 省级 + 美国 us-atlas 州界，
 * 绕向归一、分档简化后合成），如无特需不必更新。
 * 数据未接入时只画一层暗金底图并给出提示，页面照常可用。
 */
import visits from '../data/visits.json';
import cityData from '../data/cities.json';
import admin1Data from '../data/admin1-cn-us.json';
import { feature } from 'topojson-client';
import { geoNaturalEarth1, geoPath, geoContains } from 'd3-geo';
import isoCountries from 'i18n-iso-countries';
import zhLocale from 'i18n-iso-countries/langs/zh.json';
import worldData from 'world-atlas/countries-110m.json';

const W = 960;
const H = 500;

type CountryHit = { code: string; visitors: number; views: number };
type RangeStats = { visitors: number; views: number; countries: CountryHit[] };

const all: RangeStats = visits.all ?? { visitors: 0, views: 0, countries: [] };

const hits = new Map<string, CountryHit>();
for (const c of all.countries) hits.set(c.code, c);

const hasData = all.countries.length > 0;
const maxVisitors = Math.max(1, ...all.countries.map((c) => c.visitors));

isoCountries.registerLocale(zhLocale as Parameters<typeof isoCountries.registerLocale>[0]);

const projection = geoNaturalEarth1().fitExtent(
  [
    [8, 8],
    [W - 8, H - 8],
  ],
  { type: 'Sphere' },
);
const pathOf = geoPath(projection);

// 坐标压到一位小数：110m 底图上误差 <1px，HTML 体积约省三成
const shrink = (d: string) => d.replace(/\d+\.\d+/g, (n) => String(Math.round(Number(n) * 10) / 10));

const topo = worldData as unknown as Parameters<typeof feature>[0];
const world = feature(topo, (topo as any).objects.countries) as unknown as {
  features: Array<{ id?: string | number | null; properties?: { name?: string } }>;
};

const shapes = world.features.map((f) => {
  const num = String(f.id ?? '').padStart(3, '0');
  const alpha2 = /^\d{3}$/.test(num) ? isoCountries.numericToAlpha2(num) : undefined;
  const hit = alpha2 ? hits.get(alpha2) ?? null : null;
  const opacity = hit ? 0.1 + 0.82 * (Math.log1p(hit.visitors) / Math.log1p(maxVisitors)) : 0;
  return {
    key: alpha2 ?? `x-${f.id ?? f.properties?.name ?? 'unknown'}`,
    d: shrink(pathOf(f as any) ?? ''),
    name: (alpha2 ? isoCountries.getName(alpha2, 'zh') ?? alpha2 : f.properties?.name) ?? '',
    nameEn: (alpha2 ? isoCountries.getName(alpha2, 'en') ?? alpha2 : f.properties?.name) ?? '',
    hit,
    opacity: Number(opacity.toFixed(2)),
  };
});

// 有来客的地方后画（压在上层），免得国境描边被邻国盖掉
shapes.sort((a, b) => Number(Boolean(a.hit)) - Number(Boolean(b.hit)));

const rank = [...all.countries]
  .sort((a, b) => b.visitors - a.visitors)
  .slice(0, 10)
  .map((c) => ({
    ...c,
    name: isoCountries.getName(c.code, 'zh') ?? c.code,
    nameEn: isoCountries.getName(c.code, 'en') ?? c.code,
  }));
const listMax = Math.max(1, rank[0]?.visitors ?? 1);

const fmt = (n: number) => n.toLocaleString('zh-CN');
const updatedText = visits.updated ? String(visits.updated).slice(0, 10) : '';

/* ---------------- 城市光点（MapMyVisitors 城市级来客） ---------------- */

type CityHit = { name: string; lat: number; lng: number; hits: number };

// 数据侧返回英文城市名，这里做常用城市的中文对照；未收录的保持原文
const zhCityNames: Record<string, string> = {
  Beijing: '北京', Shanghai: '上海', Guangzhou: '广州', Shenzhen: '深圳',
  Hangzhou: '杭州', Nanjing: '南京', Suzhou: '苏州', Chengdu: '成都',
  Chongqing: '重庆', Wuhan: '武汉', "Xi'an": '西安', Xian: '西安',
  Tianjin: '天津', Changsha: '长沙', Zhengzhou: '郑州', Qingdao: '青岛',
  Jinan: '济南', Shenyang: '沈阳', Dalian: '大连', Harbin: '哈尔滨',
  Xiamen: '厦门', Fuzhou: '福州', Kunming: '昆明', Hefei: '合肥',
  Nanchang: '南昌', Guiyang: '贵阳', Nanning: '南宁', Taiyuan: '太原',
  Shijiazhuang: '石家庄', Changchun: '长春', Urumqi: '乌鲁木齐', Lanzhou: '兰州',
  Haikou: '海口', Ningbo: '宁波', Wuxi: '无锡', Foshan: '佛山',
  Dongguan: '东莞', Zhuhai: '珠海', Wenzhou: '温州', Xuzhou: '徐州',
  Changzhou: '常州', Yantai: '烟台', Luoyang: '洛阳',
  'Hong Kong': '香港', Macau: '澳门', Taipei: '台北',
  Singapore: '新加坡', Tokyo: '东京', Osaka: '大阪', Seoul: '首尔',
  'New York': '纽约', 'Los Angeles': '洛杉矶', 'San Francisco': '旧金山',
  'San Jose': '圣何塞', Seattle: '西雅图', Chicago: '芝加哥', Boston: '波士顿',
  Toronto: '多伦多', Vancouver: '温哥华', London: '伦敦', Paris: '巴黎',
  Berlin: '柏林', Amsterdam: '阿姆斯特丹', Sydney: '悉尼', Melbourne: '墨尔本',
  Moscow: '莫斯科', Dubai: '迪拜', Bangkok: '曼谷',
  'Kuala Lumpur': '吉隆坡', 'Ho Chi Minh City': '胡志明市', Hanoi: '河内',
};

const citySrc = (cityData as { cities?: CityHit[]; source?: string }).cities ?? [];
const cityPoints = citySrc
  .map((c) => {
    const p = projection([c.lng, c.lat]);
    if (!p || !Number.isFinite(p[0]) || !Number.isFinite(p[1])) return null;
    return {
      name: zhCityNames[c.name] ?? c.name,
      nameEn: c.name,
      hits: c.hits,
      x: Number(p[0].toFixed(1)),
      y: Number(p[1].toFixed(1)),
    };
  })
  .filter((c): c is { name: string; nameEn: string; hits: number; x: number; y: number } => c !== null);
const cityR = (hits: number) => Math.min(4.6, 1.6 + 1.15 * Math.log1p(hits));

const citySource = (cityData as { source?: string }).source ?? 'https://mapmyvisitors.com';

/* ---------------- 省州层（中国、美国细化到省级/州级） ---------------- */

// 底数据里的省州名已按中文收录（含美国州名的中文译名），英文侧在此反查
const adminEnNames: Record<string, string> = {
  北京: 'Beijing', 天津: 'Tianjin', 河北: 'Hebei', 山西: 'Shanxi', 内蒙古: 'Inner Mongolia',
  辽宁: 'Liaoning', 吉林: 'Jilin', 黑龙江: 'Heilongjiang', 上海: 'Shanghai', 江苏: 'Jiangsu',
  浙江: 'Zhejiang', 安徽: 'Anhui', 福建: 'Fujian', 江西: 'Jiangxi', 山东: 'Shandong',
  河南: 'Henan', 湖北: 'Hubei', 湖南: 'Hunan', 广东: 'Guangdong', 广西: 'Guangxi',
  海南: 'Hainan', 重庆: 'Chongqing', 四川: 'Sichuan', 贵州: 'Guizhou', 云南: 'Yunnan',
  西藏: 'Tibet', 陕西: 'Shaanxi', 甘肃: 'Gansu', 青海: 'Qinghai', 宁夏: 'Ningxia',
  新疆: 'Xinjiang', 台湾: 'Taiwan', 香港: 'Hong Kong', 澳门: 'Macau',
  阿拉巴马州: 'Alabama', 阿拉斯加州: 'Alaska', 亚利桑那州: 'Arizona', 科罗拉多州: 'Colorado',
  佛罗里达州: 'Florida', 佐治亚州: 'Georgia', 印第安纳州: 'Indiana', 堪萨斯州: 'Kansas',
  缅因州: 'Maine', 马萨诸塞州: 'Massachusetts', 明尼苏达州: 'Minnesota', 新泽西州: 'New Jersey',
  北卡罗来纳州: 'North Carolina', 北达科他州: 'North Dakota', 俄克拉何马州: 'Oklahoma',
  宾夕法尼亚州: 'Pennsylvania', 南达科他州: 'South Dakota', 得克萨斯州: 'Texas',
  怀俄明州: 'Wyoming', 康涅狄格州: 'Connecticut', 密苏里州: 'Missouri', 西弗吉尼亚州: 'West Virginia',
  伊利诺伊州: 'Illinois', 新墨西哥州: 'New Mexico', 阿肯色州: 'Arkansas', 加利福尼亚州: 'California',
  特拉华州: 'Delaware', 哥伦比亚特区: 'District of Columbia', 夏威夷州: 'Hawaii', 艾奥瓦州: 'Iowa',
  肯塔基州: 'Kentucky', 马里兰州: 'Maryland', 密歇根州: 'Michigan', 密西西比州: 'Mississippi',
  蒙大拿州: 'Montana', 新罕布什尔州: 'New Hampshire', 纽约州: 'New York', 俄亥俄州: 'Ohio',
  俄勒冈州: 'Oregon', 田纳西州: 'Tennessee', 犹他州: 'Utah', 弗吉尼亚州: 'Virginia',
  华盛顿州: 'Washington', 威斯康星州: 'Wisconsin', 美属萨摩亚: 'American Samoa', 关岛: 'Guam',
  北马里亚纳群岛: 'Northern Mariana Islands', 内布拉斯加州: 'Nebraska', 南卡罗来纳州: 'South Carolina',
  波多黎各: 'Puerto Rico', 美属维尔京群岛: 'U.S. Virgin Islands', 爱达荷州: 'Idaho',
  内华达州: 'Nevada', 佛蒙特州: 'Vermont', 路易斯安那州: 'Louisiana', 罗得岛州: 'Rhode Island',
};

const adminTopo = admin1Data as unknown as Parameters<typeof feature>[0];
const adminFC = feature(adminTopo, (adminTopo as any).objects.admin1) as unknown as {
  features: Array<{ properties: { name: string; country: string }; geometry: any }>;
};

const ringArea = (ring: number[][]) => {
  let a = 0;
  for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
    a += ring[j][0] * ring[i][1] - ring[i][0] * ring[j][1];
  }
  return Math.abs(a / 2);
};
const geomArea = (g: any): number => {
  const polys: number[][][][] = g.type === 'Polygon' ? [g.coordinates] : g.coordinates;
  return polys.reduce((s, p) => s + ringArea(p[0]), 0);
};

const adminAreas = adminFC.features.map((f) => ({
  name: f.properties.name,
  nameEn: adminEnNames[f.properties.name] ?? f.properties.name,
  country: f.properties.country,
  area: geomArea(f.geometry),
  d: shrink(pathOf(f as any) ?? ''),
  f,
}));

// 城市点落进哪个省州：省界简化后相邻区域会轻微重叠，多点命中时取面积最小的
const areaHits = new Map<(typeof adminAreas)[number], number>();
for (const c of citySrc) {
  let best: (typeof adminAreas)[number] | null = null;
  for (const a of adminAreas) {
    if (!geoContains(a.f as any, [c.lng, c.lat])) continue;
    if (!best || a.area < best.area) best = a;
  }
  if (best) areaHits.set(best, (areaHits.get(best) ?? 0) + c.hits);
}

// 该国的省州已亮起时，整国不再涂色（美国领土划归各州同理）
const litCountries = new Set([...areaHits.keys()].map((a) => a.country));
// 是否整国涂色可见：国家有数据且省州层还没接住它（此时省界改画墨线，压在亮金上）
const wholeLit = (code: string) => Boolean(hits.get(code)?.visitors) && !litCountries.has(code);
const maxAdminHits = Math.max(1, ...areaHits.values());
const adminOpacity = (h: number) => 0.1 + 0.82 * (Math.log1p(h) / Math.log1p(maxAdminHits));

// 亮起的省州后画（压在邻省描边之上）
const adminList = [...adminAreas].sort((x, y) => Number(areaHits.has(x)) - Number(areaHits.has(y)));

const ariaSummary = hasData
  ? `访客星图：累计 ${fmt(all.views)} 次到访，来自 ${all.countries.length} 个国家和地区` +
    (areaHits.size ? `，${areaHits.size} 个省州亮起` : '') +
    (cityPoints.length ? `，点亮 ${cityPoints.length} 座城市` : '')
  : '访客星图：访问统计尚未接入';
const ariaSummaryEn = hasData
  ? `Visitor star map: ${fmt(all.views)} visits from ${all.countries.length} countries and regions` +
    (areaHits.size ? `, ${areaHits.size} provinces or states lit` : '') +
    (cityPoints.length ? `, ${cityPoints.length} cities lit` : '')
  : 'Visitor star map: statistics not connected yet';
---

<section class="vp" aria-label="访客星图" data-en-aria="Visitor star map">
  <header class="vp-head">
    <p class="vp-kicker"><span class="zl-zh">古巫祝脉 · 四海来客</span><span class="zl-en">Wu-Zhu Lineage · Guests from the Four Seas</span></p>
    <h2 class="vp-title"><span class="zl-zh">访客星图</span><span class="zl-en">Visitor Star Map</span></h2>
    <p class="vp-sub"><span class="zl-zh">来客所在，省州城池次第亮起；越亮之处，来访越多</span><span class="zl-en">Where guests come from, provinces and cities light one by one — the brighter the place, the more the visits</span></p>
  </header>

  <div class="vp-grid">
    <div class="vp-mapwrap">
      <svg class="vp-map" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={ariaSummary} data-en-aria={ariaSummaryEn}>
        <defs>
          <radialGradient id="vpGlow" cx="50%" cy="46%" r="64%">
            <stop offset="0%" stop-color="#f6d98a" stop-opacity="0.1" />
            <stop offset="60%" stop-color="#f6d98a" stop-opacity="0.032" />
            <stop offset="100%" stop-color="#f6d98a" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="vpCityGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#ffe9ad" stop-opacity="0.9" />
            <stop offset="35%" stop-color="#f6d98a" stop-opacity="0.38" />
            <stop offset="100%" stop-color="#f6d98a" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect x="0" y="0" width={W} height={H} fill="url(#vpGlow)" />
        <g class="vp-countries">
          {
            shapes.map((s) => (
              <path
                d={s.d}
                class:list={['vp-c', { 'vp-on': Boolean(s.hit) && !litCountries.has(s.key) }]}
                data-en-tip={
                  s.hit
                    ? `${s.nameEn} · ${fmt(s.hit.visitors)} visitors / ${fmt(s.hit.views)} views`
                    : s.nameEn
                }
                style={
                  s.hit
                    ? `--o:${s.opacity};--os:${Math.min(1, s.opacity + 0.25).toFixed(2)}`
                    : undefined
                }
              >
                <title>
                  {s.hit
                    ? `${s.name} · ${fmt(s.hit.visitors)} 人／${fmt(s.hit.views)} 次`
                    : s.name}
                </title>
              </path>
            ))
          }
        </g>
        <g class="vp-admin1">
          {
            adminList.map((a) => {
              const h = areaHits.get(a) ?? 0;
              const o = h ? adminOpacity(h) : 0;
              const ink = h === 0 && wholeLit(a.country);
              return (
                <path
                  d={a.d}
                  class:list={['vp-a1', { 'vp-on': h > 0, 'vp-ink': ink }]}
                  data-en-tip={h ? `${a.nameEn} · ${fmt(h)} visits` : a.nameEn}
                  style={h ? `--o:${o.toFixed(2)};--os:${Math.min(1, o + 0.25).toFixed(2)}` : undefined}
                >
                  <title>{h ? `${a.name} · ${fmt(h)} 次到访` : a.name}</title>
                </path>
              );
            })
          }
        </g>
        {
          cityPoints.length > 0 && (
            <g class="vp-cities">
              {cityPoints.map((c, i) => (
                <g class="vp-city" style={`--ph:${(i * 0.83).toFixed(2)}s`} data-en-tip={`${c.nameEn} · ${fmt(c.hits)} visits`}>
                  <circle class="vp-city-glow" cx={c.x} cy={c.y} r={(cityR(c.hits) * 3).toFixed(1)} />
                  <circle class="vp-city-dot" cx={c.x} cy={c.y} r={cityR(c.hits).toFixed(1)} />
                  <title>{`${c.name} · ${fmt(c.hits)} 次到访`}</title>
                </g>
              ))}
            </g>
          )
        }
      </svg>
      {!hasData && (
        <p class="vp-pending"><span class="zl-zh">统计尚在接入 · 来客渐多之后，此处逐地亮起</span><span class="zl-en">Statistics are coming online — as guests arrive, places here will light up one by one</span></p>
      )}
    </div>

    <aside class="vp-side">
      <dl class="vp-stats">
        <div class="vp-stat">
          <dt><span class="zl-zh">累计到访</span><span class="zl-en">Total Visits</span></dt>
          <dd><b>{hasData ? fmt(all.views) : '—'}</b><i><span class="zl-zh">次</span><span class="zl-en">visits</span></i></dd>
        </div>
        <div class="vp-stat">
          <dt><span class="zl-zh">足迹所至</span><span class="zl-en">Places Reached</span></dt>
          <dd><b>{hasData ? fmt(all.countries.length) : '—'}</b><i><span class="zl-zh">地</span><span class="zl-en">places</span></i></dd>
        </div>
      </dl>

      {
        rank.length > 0 && (
          <ol class="vp-rank">
            {rank.map((c, i) => (
              <li>
                <span class="vp-rank-no">{i + 1}</span>
                <span class="vp-rank-name"><span class="zl-zh">{c.name}</span><span class="zl-en">{c.nameEn}</span></span>
                <span class="vp-rank-bar" aria-hidden="true">
                  <i style={`width:${Math.max(4, (c.visitors / listMax) * 100).toFixed(1)}%`} />
                </span>
                <span class="vp-rank-num">{fmt(c.visitors)}</span>
              </li>
            ))}
          </ol>
        )
      }

      <p class="vp-note">
        {hasData ? (<><span class="zl-zh">数据截至 {updatedText} · 每日更新</span><span class="zl-en">Data as of {updatedText} · updated daily</span></>) : (<><span class="zl-zh">数据接入后每日更新</span><span class="zl-en">Updated daily once data is connected</span></>)}
      </p>
      {
        cityPoints.length > 0 && (
          <p class="vp-note vp-note-city">
            <span class="zl-zh">城市微光 · 数据由{' '}<a href={citySource} target="_blank" rel="noopener">MapMyVisitors</a>{' '}提供</span>
            <span class="zl-en">City glimmers · data by{' '}<a href={citySource} target="_blank" rel="noopener">MapMyVisitors</a></span>
          </p>
        )
      }

      <p class="vp-note vp-note-geo"><span class="zl-zh">省州界线 · DataV GeoAtlas / U.S. Census Bureau</span><span class="zl-en">Province & state borders · DataV GeoAtlas / U.S. Census Bureau</span></p>
    </aside>
  </div>
</section>

<style>
  /* 首页底部独用的一块：自成一套暗金配色，不依赖其他页面的主题变量 */
  .vp {
    position: relative;
    z-index: 2;
    width: min(100% - 2rem, 76rem);
    margin: clamp(3rem, 7vw, 5.5rem) auto 0;
    padding: clamp(2.2rem, 5vw, 3.6rem) clamp(0.6rem, 2vw, 1.4rem) 0;
    border-top: 1px solid rgba(240, 213, 159, 0.16);
    color: #e8d8b6;
  }
  /* 顶部金线：中间亮、两端隐，和站内其他分节线同语言 */
  .vp::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    width: min(100%, 44rem);
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, rgba(246, 217, 138, 0.55), transparent);
  }

  .vp-head {
    text-align: center;
    margin-bottom: clamp(1.6rem, 4vw, 2.6rem);
  }
  .vp-kicker {
    margin: 0;
    color: #b08d45;
    font-size: 0.72rem;
    letter-spacing: 0.6em;
    text-indent: 0.6em;
    font-family: 'Kaiti SC', 'STKaiti', 'KaiTi', serif;
  }
  .vp-title {
    margin: 0.7rem 0 0;
    font-family: 'Kaiti SC', 'STKaiti', 'KaiTi', serif;
    font-weight: 500;
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    color: transparent;
    background: linear-gradient(180deg, #fff1a8 0%, #d8b45a 45%, #a67c2f 100%);
    -webkit-background-clip: text;
    background-clip: text;
    text-shadow: 0 0 18px rgba(205, 160, 60, 0.14);
  }
  .vp-sub {
    margin: 0.75rem 0 0;
    color: #a5905f;
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    text-indent: 0.3em;
  }

  .vp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: clamp(1.4rem, 3vw, 2.6rem);
    align-items: start;
