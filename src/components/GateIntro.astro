---
interface Block {
  label: string;
  title?: string;
  paras: string[];
}

interface Props {
  glyph: string;
  name: string;
  subtitle: string;
  /** 门中提要；只登原文、不写提要时可缺省 */
  lead?: string;
  /** 分块提要；只登原文时可缺省 */
  blocks?: Block[];
  note?: string;
}

// 页内不再自设「下一步」动作行：一脉三页的前后跳转统一由 BranchSteps 在页底给两个去处
const {
  glyph,
  name,
  subtitle,
  lead = '',
  blocks = [],
  note,
} = Astro.props;
---

<article class="gate-intro">
  <div class="gi-wrap">
    <header class="gi-hero reveal in">
      <span class="gi-glyph zhuan" aria-hidden="true">{glyph}</span>
      <p class="gi-kicker kai">法门介绍</p>
      <h1 class="kai">{name}</h1>
      <p class="gi-subtitle">{subtitle}</p>
    </header>

    {
      lead && (
        <section class="gi-lead" aria-label="门中提要">
          <p>{lead}</p>
        </section>
      )
    }

    {
      blocks.length > 0 && (
        <div class="gi-blocks">
          {blocks.map((b) => (
            <section class="gi-block">
              <p class="gi-label kai">{b.label}</p>
              {b.title && <h2 class="kai">{b.title}</h2>}
              {b.paras.map((p) => <p>{p}</p>)}
            </section>
          ))}
        </div>
      )
    }

    {
      note && (
        <aside class="gi-note">
          <span class="gi-note-mark" aria-hidden="true"></span>
          <p>{note}</p>
        </aside>
      )
    }

    {/* 门中正文：本门另有源文件全篇时，从各页传入（分页 / 分段由页面决定） */}
    <slot />
  </div>
</article>

<style>
  .gate-intro { position: relative; z-index: 1; padding: clamp(4rem, 9vw, 8rem) 0 clamp(2.6rem, 5vw, 4rem); }
  .gi-wrap { width: min(100% - 3rem, 48rem); margin-inline: auto; }
  .gi-hero { display: grid; grid-template-columns: auto 1fr; column-gap: clamp(1.4rem, 4vw, 3.5rem); align-items: end; padding-bottom: clamp(2.6rem, 5vw, 4.5rem); border-bottom: 1px solid color-mix(in srgb, var(--branch-accent) 35%, transparent); }
  .gi-glyph { grid-row: 1 / span 3; color: transparent; -webkit-text-stroke: 1.9px color-mix(in srgb, var(--branch-accent) 38%, #fff8e6); font-size: clamp(6rem, 15vw, 11rem); line-height: 0.72; text-shadow: 0 0 34px color-mix(in srgb, var(--branch-accent) 22%, transparent); user-select: none; }
  .gi-kicker { color: color-mix(in srgb, var(--branch-accent) 66%, #f4ead4); font-size: 0.78rem; letter-spacing: 0.54em; }
  .gi-hero h1 { margin-top: 0.5rem; color: #f8f3e9; font-size: clamp(2.4rem, 6vw, 4.8rem); line-height: 1.2; letter-spacing: 0.28em; }
  .gi-subtitle { margin-top: 0.9rem; color: #e0d8c8; font-size: 0.9rem; letter-spacing: 0.3em; }
  .gi-lead { width: min(100%, 48rem); margin: clamp(3rem, 6vw, 5.5rem) auto 0; }
  .gi-lead p { color: #f0ebdf; font-size: clamp(1rem, 1.5vw, 1.12rem); line-height: 2.25; }
  .gi-blocks { width: min(100%, 48rem); margin: clamp(2.6rem, 5vw, 4rem) auto 0; display: flex; flex-direction: column; gap: clamp(1.8rem, 3.5vw, 2.6rem); }
  .gi-block { padding-top: 1.4rem; border-top: 1px dashed color-mix(in srgb, var(--branch-accent) 22%, transparent); }
  .gi-label { color: color-mix(in srgb, var(--branch-accent) 66%, #f4ead4); font-size: 0.76rem; letter-spacing: 0.5em; }
  .gi-block h2 { margin-top: 0.7rem; color: #f2ecdd; font-size: clamp(1.15rem, 2vw, 1.45rem); letter-spacing: 0.18em; }
  .gi-block p { margin-top: 0.75rem; color: #e6e0d2; font-size: 0.95rem; line-height: 2.15; text-indent: 2em; }
  .gi-block p:first-of-type { margin-top: 1rem; }
  .gi-note { display: flex; gap: 1rem; width: min(100%, 48rem); margin: clamp(2.4rem, 5vw, 4rem) auto 0; padding-top: 1.2rem; border-top: 1px solid color-mix(in srgb, var(--branch-accent) 25%, transparent); color: #d8cfbe; font-size: 0.88rem; line-height: 2; }
  .gi-note-mark { width: 0.48rem; height: 0.48rem; flex: none; margin-top: 0.65rem; border: 1px solid var(--branch-accent); transform: rotate(45deg); }
  @media (max-width: 640px) { .gi-wrap { width: min(100% - 2.2rem, 48rem); } .gi-hero { column-gap: 1rem; } .gi-glyph { font-size: 5.6rem; } .gi-subtitle { letter-spacing: 0.17em; } }
</style>