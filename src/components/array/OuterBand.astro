---
import { roundSquarePerimeter, bandUses, perimeterPath } from './geometry.js';

// 外阵：窃曲大带（青铜缎带）+ 连珠界栏 + 四方缺口（带身向外延伸出屏）
const H = 720;
const R = 130;
const GAPS = [
  { angle: 0, half: 6 },
  { angle: -90, half: 6 },
  { angle: 90, half: 6 },
  { angle: 180, half: 6 },
];

const n2 = (v) => Math.round(v * 10) / 10;

// 窃曲单元沿外框排布，缺口处留空
const quequ = bandUses('quequ', H, R, 56, { offset: 0.012, gaps: GAPS });

// 连珠界栏（贴近缎带内侧一圈）
const beadRow = bandUses('bead-border', 668, 122, 44, { rotExtra: 90, gaps: GAPS });

// 缎带本体：沿外框的连续波形线（切缺口为 4 段）
function wavySegments() {
  const N = 320;
  let segs = [];
  let seg = [];
  let lastA = null;
  for (let i = 0; i <= N; i++) {
    const p = roundSquarePerimeter(H, R, i / N);
    let a = (Math.atan2(p.y, p.x) * 180) / Math.PI;
    if (lastA !== null) {
      let d = a - lastA;
      if (d > 180) d -= 360;
      if (d < -180) d += 360;
      if (Math.abs(d) > 9) {
        segs.push(seg);
        seg = [];
      }
    }
    seg.push(p);
    lastA = a;
  }
  segs.push(seg);
  return segs
    .filter((s) => s.length > 12)
    .map((s) => {
      const pts = s.map((p, j) => {
        const perpX = -p.ty;
        const perpY = p.tx;
        const off = Math.sin((j / s.length) * Math.PI * 4) * 4.5;
        return `${(p.x + perpX * off).toFixed(1)} ${(p.y + perpY * off).toFixed(1)}`;
      });
      return `M ${pts.join(' L ')}`;
    })
    .join(' ');
}

// 四方缺口：带身穿过缺口向外延伸出屏（每处 4 节 + 连珠桥）
const EXT = [
  { dx: 1, dy: 0, rot: 0 },
  { dx: -1, dy: 0, rot: 180 },
  { dx: 0, dy: -1, rot: -90 },
  { dx: 0, dy: 1, rot: 90 },
];
let ext = '';
EXT.forEach(({ dx, dy, rot }) => {
  for (const d of [748, 798, 848, 898]) {
    ext += `<use href="#quequ" transform="translate(${n2(dx * d)} ${n2(dy * d)}) rotate(${rot})"/>`;
  }
  for (const d of [700, 716, 732]) {
    ext += `<use href="#bead-border" transform="translate(${n2(dx * d)} ${n2(dy * d)}) rotate(${rot})"/>`;
  }
});

// 呼吸高光：沿外带一段缓慢移动的金色高光（缎带还活着）
function sheenPath() {
  const N = 180;
  const pts = [];
  for (let i = 0; i <= N; i++) {
    const p = roundSquarePerimeter(H, R, i / N);
    const deg = (Math.atan2(p.y, p.x) * 180) / Math.PI;
    if (GAPS.some((g) => Math.abs(deg - g.angle) < 10 || Math.abs(Math.abs(deg - g.angle) - 360) < 10)) continue;
    const perpX = -p.ty;
    const perpY = p.tx;
    const off = Math.sin((i / N) * Math.PI * 8) * 5;
    pts.push(`${(p.x + perpX * off).toFixed(1)} ${(p.y + perpY * off).toFixed(1)}`);
  }
  return `M ${pts.join(' L ')}`;
}

const ribbon = `<path class="a-ribbon" d="${wavySegments()}"/>`;
const sheen = `<path class="a-sheen" d="${sheenPath()}"/>`;
const faintRing = `<circle class="a-ring" opacity="0.28" r="906"/>`;
const faintRing2 = `<circle class="a-ring" opacity="0.16" r="940"/>`;
const cornerDots = [45, 135, 225, 315]
  .map((a) => {
    const rad = (a * Math.PI) / 180;
    return `<use href="#cloud-single" transform="translate(${n2(Math.cos(rad) * 660)} ${n2(Math.sin(rad) * 660)}) rotate(${n2(a + 90)})"/>`;
  })
  .join('');
---
<g class="a-dim">
  <g set:html={faintRing + faintRing2} />
  <g set:html={ribbon} />
  <g set:html={quequ} />
  <g set:html={beadRow} />
  <g set:html={ext} />
  <g set:html={cornerDots} />
  <g set:html={sheen} />
</g>