---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const path = [
  { mark: '定', title: '先正其心', reading: '修炼不是一时兴起，也不是追逐奇谈。先把工作、家庭、身体和日常生活安顿好，才有长期修习的根基。', outcome: '知道自己求的是养炼神形、健康长久，而不是一时功感与神通。', href: '/zhoufa/zhishi#boundaries', action: '读清边界' },
  { mark: '源', title: '通晓巫祝', reading: '从巫之由来读起，分清史、祝、卜三职，再认识祝祷、祝由、祭祀与巫医两大体系。', outcome: '能够说明祝为何是巫中的大主祭，以及古巫祝脉在诸脉中的位置。', href: '/zhoufa/mailuo', action: '查看脉络' },
  { mark: '辨', title: '辨清咒法', reading: '继续阅读音诀、咒音、原始咒、战斗咒、通神咒和混合咒，理解声音、气息与精神的关系。', outcome: '不把音诀当作宗教咒语，也不把音乐疗愈与咒音混为一谈。', href: '/zhoufa/zhishi', action: '查看知识点' },
  { mark: '稳', title: '先筑日常', reading: '从广播体操、八段锦、五禽戏与规律作息开始。功法贵在认真和坚持，眼高手低、两天打鱼三天晒网，都不能得其门。', outcome: '能稳定安排每日练习，不追求速效，懂得适度用力、用气。', href: '#checklist', action: '完成自检' },
  { mark: '课', title: '循序入课', reading: '基础课先学开启脉门、脉门升华、经门升华；特殊课再学吐纳六字诀、辟邪护道咒、玄黄贯力咒；高级课不作直接售卖。', outcome: '明白课程有层级、有次序，师父领进门，修行在个人。', href: '/zhoufa/kecheng', action: '课程介绍' },
  { mark: '决', title: '愿者自来', reading: '通读报名须知，加群交流，明白修炼目的与规矩，经过考察与双方认同后，再决定是否报名。', outcome: '确认时间、恒心、规则与承受能力都已准备好，不因好奇仓促决定。', href: '/zhoufa/baoming', action: '报名须知' },
];

const checks = [
  '我已明白修炼贵在长期，不以一时功感论成败。',
  '我能保持正常工作、生活与作息。',
  '我不追求速效、神通，不自行增减或混练法门。',
  '我会在身体不适时停止，并寻求专业意见。',
  '我已读完课程介绍与报名要求。',
];
---

<section class="study-route" aria-labelledby="study-route-title">
  <div class="wrap">
    <header class="study-heading reveal">
      <h2 id="study-route-title" class="section-title">按这个顺序学习</h2>
      <p>修炼有门径，阅读也有次序。先明白自己为何而学，再决定是否入门。</p>
    </header>

    <ol class="route-list">
      {path.map((step) => (
        <li class="reveal">
          <span class="route-mark kai">{step.mark}</span>
          <div class="route-copy">
            <h3>{step.title}</h3>
            <p>{step.reading}</p>
          </div>
          <div class="route-outcome">
            <span>完成标准</span>
            <p>{step.outcome}</p>
          </div>
          <a href={`${base}${step.href}`}>{step.action}<span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="study-check" id="checklist" aria-labelledby="study-check-title">
  <div class="wrap study-check-grid">
    <header class="study-heading reveal">
      <h2 id="study-check-title" class="section-title">学习前自检</h2>
      <p>逐项问自己是否做得到。真正的修习从守住日常、守住规矩开始。</p>
      <p class="check-count" id="checkCount" aria-live="polite">已确认 0 / {checks.length}</p>
      <button class="check-reset" id="checkReset" type="button">清除记录</button>
    </header>

    <fieldset class="check-list reveal" data-d="2">
      <legend class="visually-hidden">学习前自检项目</legend>
      {checks.map((item, index) => (
        <label>
          <input type="checkbox" value={String(index)} />
          <span aria-hidden="true"></span>
          <b>{item}</b>
        </label>
      ))}
    </fieldset>
  </div>
</section>

<script>
  const storageKey = 'zhumen-study-checks';
  const inputs = Array.from(document.querySelectorAll<HTMLInputElement>('.check-list input'));
  const count = document.getElementById('checkCount');
  const reset = document.getElementById('checkReset');

  const renderCount = () => {
    const completed = inputs.filter((input) => input.checked).length;
    if (count) count.textContent = `已确认 ${completed} / ${inputs.length}`;
  };

  try {
    const parsed = JSON.parse(localStorage.getItem(storageKey) || '[]');
    const saved = Array.isArray(parsed) ? parsed : [];
    inputs.forEach((input) => { input.checked = saved.includes(input.value); });
  } catch {}
  renderCount();

  inputs.forEach((input) => input.addEventListener('change', () => {
    const selected = inputs.filter((item) => item.checked).map((item) => item.value);
    try { localStorage.setItem(storageKey, JSON.stringify(selected)); } catch {}
    renderCount();
  }));

  reset?.addEventListener('click', () => {
    inputs.forEach((input) => { input.checked = false; });
    try { localStorage.removeItem(storageKey); } catch {}
    renderCount();
  });
</script>

<style>
  .study-route,
  .study-check { border-top: 1px solid var(--ink-line); }
  .study-heading { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .study-heading > p { margin-top: 1rem; max-width: 40rem; color: var(--bone-dim); line-height: 2; }
  .route-list { list-style: none; border-top: 1px solid var(--ink-line); }
  .route-list li { display: grid; grid-template-columns: 3rem 1.2fr 1fr 8.5rem; gap: clamp(1rem, 3vw, 2rem); align-items: center; padding: 1.5rem 0.5rem; border-bottom: 1px solid var(--ink-line); }
  .route-mark { color: var(--cinnabar-bright); font-size: 1.5rem; }
  .route-copy h3 { color: var(--heading); font-family: var(--font-kai); font-size: 1.2rem; letter-spacing: 0.16em; }
  .route-copy p,
  .route-outcome p { margin-top: 0.4rem; color: var(--bone-dim); font-size: 0.88rem; line-height: 1.85; }
  .route-outcome > span { color: var(--bronze); font-size: 0.72rem; letter-spacing: 0.16em; }
  .route-list a { justify-self: end; display: inline-flex; align-items: center; gap: 0.55rem; color: var(--bronze-bright); font-family: var(--font-kai); letter-spacing: 0.12em; white-space: nowrap; }
  .route-list a span { transition: transform 0.25s var(--ease-soft); }
  .route-list a:hover span { transform: translateX(4px); }

  .study-check { scroll-margin-top: 5rem; }
  .study-check-grid { display: grid; grid-template-columns: 0.75fr 1.25fr; gap: clamp(2rem, 6vw, 5rem); }
  .check-count { color: var(--cinnabar-bright) !important; font-family: var(--font-kai); font-size: 1.05rem; letter-spacing: 0.16em; }
  .check-reset { margin-top: 1rem; padding: 0.6rem 0; border: 0; border-bottom: 1px solid var(--bronze-dim); background: transparent; color: var(--bronze); font-family: var(--font-kai); letter-spacing: 0.14em; cursor: pointer; }
  .check-reset:active { transform: translateY(1px); }
  .check-list { border: 0; border-top: 1px solid var(--ink-line); }
  .check-list label { display: grid; grid-template-columns: 1.4rem 1fr; gap: 1rem; align-items: center; min-height: 4.25rem; padding: 0.8rem 0.25rem; border-bottom: 1px solid var(--ink-line); cursor: pointer; }
  .check-list input { position: absolute; opacity: 0; pointer-events: none; }
  .check-list label > span { display: grid; place-items: center; width: 20px; height: 20px; border: 1px solid var(--bronze-dim); border-radius: 3px; }
  .check-list label > span::after { content: ''; width: 9px; height: 5px; border-left: 2px solid #f2dfc4; border-bottom: 2px solid #f2dfc4; transform: rotate(-45deg) scale(0); transition: transform 0.2s var(--ease-soft); }
  .check-list input:checked + span { background: var(--cinnabar); border-color: var(--cinnabar); }
  .check-list input:checked + span::after { transform: rotate(-45deg) scale(1); }
  .check-list input:focus-visible + span { outline: 2px solid var(--bronze-bright); outline-offset: 3px; }
  .check-list b { color: var(--bone-dim); font-weight: 400; font-size: 0.92rem; line-height: 1.8; }
  .check-list input:checked ~ b { color: var(--heading); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 900px) {
    .route-list li { grid-template-columns: 2.5rem 1fr auto; align-items: start; }
    .route-outcome { grid-column: 2 / -1; }
    .route-list a { grid-column: 2; justify-self: start; }
    .study-check-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .route-list li { grid-template-columns: 2.2rem 1fr; }
    .route-list a { grid-column: 2; }
  }
</style>
