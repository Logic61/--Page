---
import Zl from './Zl.astro';

const notTeach = [
  { zh: '先天、后天大疾病者：心脏病、内脏病、身体某处问题、精神病等。', en: 'Grave congenital or acquired illnesses: heart disease, organ disease, disorders of any part of the body, mental illness, and the like.' },
  { zh: '沉迷幻境，无法自拔，过分追求功感者。', en: 'Those lost in visionary states, unable to pull free, chasing sensations of practice to excess.' },
  { zh: '引经据典、空谈阔论、好高骛远、心性不定，自创自悟、想一步登天者。', en: 'Those who quote classics and spin empty talk, aim too high, waver in temperament, invent their own insights, and wish to ascend in a single step.' },
  { zh: '好奇、新鲜感，无恒心、无毅力者。', en: 'The merely curious, chasing novelty, with neither constancy nor resolve.' },
  { zh: '偏执狂热的宗教分子，有门有派者。', en: 'Obsessive, fanatical religious adherents — those with a sect and a faction.' },
  { zh: '急功近利，追求神通，心术不正者。', en: 'Those hungry for quick gain, chasing supernatural powers, of crooked intent.' },
  { zh: '脑补家、空说家、研究家、科学家、考据家、理论家、小说家、悟道者。', en: 'The fancy-spinners, empty talkers, researchers, scientists, textual critics, theorists, novelists, enlightenment-claimers.' },
];

const mustKnow = [
  { zh: '所授为上古巫祝养生之道：不练金丹，不出阳神，没有男女限制。', en: 'What is taught is the ancient Wu-Zhu way of nourishing life: no golden elixir, no yang-spirit projection, no distinction of men and women.' },
  { zh: '不开神通，不沉迷神通。想追求神通的，还是算了，何必浪费钱财。', en: 'No opening of supernatural powers, no obsession with them. If powers are what you seek, better not — why waste your money?' },
  { zh: '学习前，请通读群内文件。修炼如同逆水行舟，不努力很容易退转。', en: 'Before studying, read the group\'s documents through. Cultivation is like rowing against the current — without effort, one easily slides back.' },
  { zh: '道贵师传，法贵专精。请按操作修炼，不要自我脑补、加或减。', en: 'The Dao is prized as passed from teacher to student; the method is prized for single-minded mastery. Practice as instructed — do not embellish, add, or subtract on your own.' },
  { zh: '一切内容，未经报备、允许，不得外泄。无论现实还是网络，甚至父母亲人也不可。', en: 'Nothing of what is taught may be divulged without first reporting and obtaining permission — not in the physical world, not online, not even to parents or close kin.' },
  { zh: '愿者来，不强迫，不强求。请考虑清楚，再决定是否报名。', en: 'The willing come; none are coerced, none pressed. Think it through, then decide whether to enroll.' },
];
---

<section class="bidu">
  <div class="wrap">
    <header class="s-head reveal">
      <div class="title-row">
        <span class="eyebrow"><Zl zh="报名必读" en="Required Reading Before Enrolling" /></span>
        <h2 class="section-title"><Zl zh="自古多不传，此间亦同" en="Of Old, Much Was Not Transmitted — It Is the Same Here" /></h2>
      </div>
      <div class="rule"></div>
    </header>

    <div class="bidu-grid">
      <article class="bidu-panel bidu--warn reveal">
        <header class="bidu-head">
          <span class="bidu-mark kai">忌</span>
          <h3><Zl zh="不传类" en="Not to Be Transmitted" /></h3>
        </header>
        <ul>
          {
            notTeach.map((n) => (
              <li><span class="bidu-dot"></span><p><Zl zh={n.zh} en={n.en} /></p></li>
            ))
          }
        </ul>
      </article>

      <article class="bidu-panel bidu--know reveal" data-d="2">
        <header class="bidu-head">
          <span class="bidu-mark kai">诫</span>
          <h3><Zl zh="必知类" en="What You Must Know" /></h3>
        </header>
        <ul>
          {
            mustKnow.map((m) => (
              <li><span class="bidu-dot"></span><p><Zl zh={m.zh} en={m.en} /></p></li>
            ))
          }
        </ul>
      </article>
    </div>

    <aside class="bidu-note reveal">
      <p>
        <Zl
          zh="本人不做生意，也不是卖内容。本着花钱求取捷径没有必要。有那些钱，不如自己留着，或者孝顺父母。"
          en="I do not do business, nor do I sell content. Paying money for shortcuts is pointless. That money is better kept for yourself — or spent in honor of your parents."
        />
      </p>
    </aside>
  </div>
</section>

<style>
  .bidu {
    border-top: 1px solid var(--ink-line);
  }

  .bidu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .bidu-panel {
    border: 1px solid var(--ink-line);
    border-radius: 3px;
    padding: clamp(1.8rem, 3vw, 2.6rem);
  }

  .bidu--warn {
    background: linear-gradient(180deg, rgba(178, 58, 44, 0.06), transparent 70%);
  }

  .bidu--know {
    background: linear-gradient(180deg, rgba(184, 154, 94, 0.05), transparent 70%);
  }

  .bidu-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.4rem;
  }

  .bidu-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    font-size: 1.1rem;
    color: #fcf5e6;
    background: radial-gradient(circle at 30% 25%, rgba(150, 45, 32, 0.92), rgba(105, 30, 22, 0.95));
  }

  .bidu--know .bidu-mark {
    background: radial-gradient(circle at 30% 25%, rgba(122, 96, 52, 0.92), rgba(84, 68, 38, 0.95));
  }

  .bidu-head h3 {
    font-family: var(--font-kai);
    font-size: 1.4rem;
    letter-spacing: 0.3em;
    color: var(--heading);
  }

  .bidu-panel ul {
    list-style: none;
  }

  .bidu-panel li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding-block: 0.7rem;
    border-top: 1px solid var(--ink-line);
  }

  .bidu-panel li:first-child { border-top: none; }

  .bidu-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cinnabar);
    margin-top: 0.75em;
  }

  .bidu--know .bidu-dot { background: var(--bronze); }

  .bidu-panel li p {
    color: var(--bone-dim);
    font-size: 0.92rem;
    line-height: 1.95;
  }

  .bidu-note {
    margin-top: 2rem;
    border-left: 2px solid var(--bronze-dim);
    padding: 1rem 1.4rem;
    background: linear-gradient(90deg, rgba(184, 154, 94, 0.05), transparent 80%);
  }

  .bidu-note p {
    color: var(--bronze);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    line-height: 2;
  }

  @media (max-width: 900px) {
    .bidu-grid { grid-template-columns: 1fr; }
  }

  /* 文本框居中：题头同为一列 48em，列内文字仍左对齐；两侧须知面板维持原宽 */
  .bidu .s-head {
    max-width: 48em;
    margin-inline: auto;
  }
</style>
