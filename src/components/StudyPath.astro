---
const steps = [
  { title: '读通基础内容', text: '先读源流、体系、祝法与问答，建立完整认识，不在概念尚未分清时匆忙下结论。' },
  { title: '观察自身条件', text: '衡量时间、经济与日常生活是否稳定。修习贵在长期，不可急功近利，更不应追逐神异体验。' },
  { title: '了解课程边界', text: '课程分层并非一次性内容清单。基础、特殊与进阶内容各有前提，是否适合应在充分了解后判断。' },
  { title: '再决定联系', text: '确认报名要求后，再通过页面所列方式联系。愿者自来，不强迫，也不仓促。' },
];
---

<section class="study-path">
  <div class="wrap">
    <header class="s-head reveal">
      <div class="title-row">
        <span class="eyebrow">修习路径</span>
        <h2 class="section-title">先判断，再前行</h2>
      </div>
      <div class="rule"></div>
      <p class="sub">先把阅读、判断和联系的顺序说清楚。循序而进，才能知晓自己是否适合这条路。</p>
    </header>

    <ol class="study-list">
      {steps.map((step, index) => (
        <li class="reveal" data-d={String((index % 3) + 2)}>
          <span class="study-num kai">0{index + 1}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .study-path { border-top: 1px solid var(--ink-line); }
  .study-list { list-style: none; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--ink-line); }
  .study-list li { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1.2rem; padding: 2rem 1.1rem; border-bottom: 1px solid var(--ink-line); }
  .study-list li:nth-child(odd) { border-right: 1px solid var(--ink-line); }
  .study-num { color: var(--cinnabar); font-size: 1.35rem; letter-spacing: 0.1em; }
  .study-list h3 { font-family: var(--font-kai); font-size: 1.3rem; letter-spacing: 0.18em; color: var(--heading); margin-bottom: 0.6rem; }
  .study-list p { color: var(--bone-dim); font-size: 0.92rem; line-height: 2; max-width: 31em; }
  @media (max-width: 820px) { .study-list { grid-template-columns: 1fr; } .study-list li:nth-child(odd) { border-right: none; } }
</style>
