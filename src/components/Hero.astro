---
// 八卦 (trigrams) radiating outward around the ring.
// patterns: [topBroken, middleBroken, bottomBroken]
const patterns = [
  [0, 0, 0], // 乾
  [1, 0, 0], // 兑
  [0, 1, 0], // 离
  [1, 1, 0], // 震
  [0, 0, 1], // 巽
  [1, 0, 1], // 坎
  [0, 1, 1], // 艮
  [1, 1, 1], // 坤
];

const trigrams = patterns.map((p, i) => {
  const a = (i * 45 * Math.PI) / 180;
  const r = 90;
  const x = (100 + Math.cos(a) * r).toFixed(1);
  const y = (100 + Math.sin(a) * r).toFixed(1);
  const seg = (ly, broken) =>
    broken
      ? `<path d="M -10 ${ly} h 7 M 3 ${ly} h 7" />`
      : `<path d="M -10 ${ly} h 20" />`;
  const body = [seg(-9, p[0]), seg(0, p[1]), seg(9, p[2])].join('');
  return `<g transform="translate(${x} ${y}) rotate(${i * 45})">${body}</g>`;
});
---

<section class="hero">
  <div class="hero-veil" aria-hidden="true"></div>

  <svg class="hero-ring" viewBox="0 0 200 200" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.55">
      <circle cx="100" cy="100" r="96" />
      <circle cx="100" cy="100" r="84" stroke-dasharray="1 3" />
      <circle cx="100" cy="100" r="72" />
    </g>
    <g fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.8" set:html={trigrams.join('')}></g>
  </svg>

  <div class="hero-core">
    <div class="hero-seal">
      <span class="seal" style="font-size:1.6rem;padding:0.5em 0.7em;">巫</span>
    </div>
    <h1 class="hero-title kai">
      上古<span>祝门</span>
    </h1>
    <p class="hero-sub">
      古巫祝脉，隐传至今。<br />
      祝，咒也。以诵咒通窍开脉，锻炼神形，<br class="br-lg" />追求天人合一，万物一咒。
    </p>
    <div class="hero-cta">
      <a class="btn btn--primary" href="/yuanqi">阅览传承</a>
      <a class="btn" href="/baoming">报名须知</a>
    </div>
  </div>

  <p class="hero-side left vtext">巫祝巫祝 · 巫，祝也</p>
  <p class="hero-side right vtext">祝，咒也 · 通窍开脉 · 锻炼神形 · 延年益寿</p>

  <div class="hero-scroll" aria-hidden="true">
    <span>下</span>
    <i></i>
  </div>
</section>

<style>
  .hero {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding-top: 4rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(640px 320px at 50% 62%, rgba(178, 58, 44, 0.07), transparent 70%),
      radial-gradient(900px 500px at 50% 110%, rgba(184, 154, 94, 0.05), transparent 70%);
  }

  .hero-ring {
    position: absolute;
    width: min(88vmin, 640px);
    height: min(88vmin, 640px);
    color: var(--bronze);
    opacity: 0.2;
    animation: spin 120s linear infinite;
    pointer-events: none;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .hero-core {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
    padding-inline: 1.25rem;
  }

  .hero-seal {
    margin-bottom: 0.6rem;
    animation: sealIn 1.4s var(--ease-soft) both;
  }

  .hero-title {
    font-weight: 700;
    font-size: clamp(3.4rem, 11vw, 7.5rem);
    letter-spacing: 0.22em;
    line-height: 1.1;
    color: var(--heading);
    text-shadow: 0 0 60px rgba(212, 184, 119, 0.16), 0 18px 50px rgba(0, 0, 0, 0.5);
    animation: titleIn 1.6s var(--ease-soft) 0.15s both;
  }

  .hero-title span {
    color: var(--bronze-bright);
  }

  html[data-theme='light'] .hero-title {
    text-shadow: 0 0 40px rgba(180, 150, 90, 0.25), 0 12px 30px rgba(90, 74, 45, 0.12);
  }

  .hero-sub {
    color: var(--bone-dim);
    font-size: clamp(0.95rem, 1.6vw, 1.12rem);
    letter-spacing: 0.22em;
    line-height: 2.3;
    animation: titleIn 1.6s var(--ease-soft) 0.35s both;
  }

  .hero-cta {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1.2rem;
    animation: titleIn 1.6s var(--ease-soft) 0.55s both;
  }

  @keyframes titleIn {
    from { opacity: 0; transform: translateY(26px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes sealIn {
    from { opacity: 0; transform: scale(0.6) rotate(-8deg); }
    to { opacity: 1; transform: scale(1) rotate(-2deg); }
  }

  .hero-side {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    font-size: 0.8rem;
    letter-spacing: 0.5em;
    color: var(--bone-faint);
    user-select: none;
  }

  .hero-side.left { left: 3.2vw; }
  .hero-side.right { right: 3.2vw; }

  @media (max-width: 900px) {
    .hero-side { display: none; }
  }

  .hero-scroll {
    position: absolute;
    bottom: 2.4rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    color: var(--bone-faint);
    font-size: 0.7rem;
    letter-spacing: 0.4em;
  }

  .hero-scroll i {
    width: 1px;
    height: 34px;
    background: linear-gradient(180deg, var(--bronze-dim), transparent);
    animation: drop 2.2s var(--ease-soft) infinite;
  }

  @keyframes drop {
    0% { transform: scaleY(0); transform-origin: top; }
    60% { transform: scaleY(1); transform-origin: top; }
    61% { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }
</style>